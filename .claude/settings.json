{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/docs/testing/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/docs/testing/stop-emulator.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/docs/testing/goal.sh check"
          }
        ]
      }
    ]
  }
}
