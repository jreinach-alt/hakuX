+# --- staged for lane.issuesync1012 (2026-10-12): the narrowest write paths issue_mirror.py needs. -------------------
+# Dry run unless --yes, exactly like release/unrelease/renote/pointer above. Every one of these goes through
+# open_window()/close_window() and token() like the existing calls; every outgoing title/body/comment is scanned for
+# secrets before it leaves the process (refuses tokens, private keys, and anything that looks like key.properties).
+# A per-run cap (--max-writes, default MAX_WRITES_RUN_DEFAULT) bounds how many of these one invocation will do;
+# issue_mirror.py is the thing that paces calls across a backfill run, not this file. Separately, MAX_WRITES_DAY
+# (round 4) bounds the persisted per-day `writes` total across every invocation of the day, the way MAX_READS_DAY
+# already bounds reads -- these are two different caps, tracked two different ways (see _write_budget below).
+# NOT WIRED TO LIVE WRITES BY THE LANE: lane.issuesync1012 never passes --yes. lane.local decides when that changes.
+MAX_WRITES_RUN_DEFAULT = 20
+# Round 4, defect 1: sized for one full backfill run (487 writes: 332 creates + 155 follow-up closes) with
+# headroom for the day's other gateway invocations (seed, sync, new, mirror-down, and any retried pending closes).
+MAX_WRITES_DAY = 600
+MIRROR_MARKER = '<!-- hakux-mirror:v1 src=%s#%s -->'   # appended to every mirrored body/comment; sync must skip echoes of its own marker
+
+
+def mirror_marker(side, number):
+    return MIRROR_MARKER % (side, number)
+
+
+KEY_PROPERTIES_RES = [re.compile(rb'storePassword\s*='), re.compile(rb'keyPassword\s*='), re.compile(rb'keyAlias\s*=.*key0', re.I)]
+
+
+def secret_scan_text(*texts):
+    """Refuses tokens, private keys and key.properties contents in any outgoing body. Returns a problem string or None."""
+    blob = ('\n'.join(t for t in texts if t)).encode('utf8', 'replace')
+    for rx in SECRET_RES:
+        if rx.search(blob):
+            return 'outgoing text matches a token/private-key pattern'
+    for rx in KEY_PROPERTIES_RES:
+        if rx.search(blob):
+            return 'outgoing text looks like android/key.properties contents'
+    for f in os.listdir(W + '/forge/tokens'):
+        if f.endswith('.token') or f == 'github-gateway':
+            try:
+                v = open(W + '/forge/tokens/' + f).read().strip()
+                if len(v) >= 20 and v.encode() in blob:
+                    return 'outgoing text contains one of our own tokens (%s)' % f
+            except Exception:
+                pass
+    try:
+        kp = open(os.path.expanduser('~/hakuX/android/key.properties')).read().strip()
+        if kp and kp.encode() in blob:
+            return 'outgoing text contains android/key.properties verbatim'
+    except Exception:
+        pass
+    return None
+
+
+class _WriteCapExceeded(Exception):
+    pass
+
+
+# Round 4, defect 1: this is a MODULE GLOBAL, not a persisted-state field. issue_mirror.py starts one gateway
+# process per write (never passing --max-writes), so each invocation is a fresh `python3 github_gateway.py ...`
+# interpreter start -- this counter is naturally 0 at the top of every one of those, with no reset logic needed.
+# The old code instead kept this same count in the persisted per-day state dict (day_counts(s)['run_writes']),
+# so it never reset between invocations and became a de facto day cap of MAX_WRITES_RUN_DEFAULT (20) across
+# EVERY invocation of the UTC day -- not a per-run cap at all. Write 21 of the day, from any caller, was REFUSED.
+_RUN_WRITES = 0
+
+
+def _write_budget(s, cap):
+    global _RUN_WRITES
+    if _RUN_WRITES >= cap:
+        raise _WriteCapExceeded('%d writes this run exceeds --max-writes %d' % (_RUN_WRITES, cap))
+    c = day_counts(s)
+    c.setdefault('writes', 0)
+    if c['writes'] >= MAX_WRITES_DAY:
+        raise _WriteCapExceeded('%d writes today exceeds the day cap %d' % (c['writes'], MAX_WRITES_DAY))
+    c['writes'] += 1
+    _RUN_WRITES += 1
+    save_state(s)
+
