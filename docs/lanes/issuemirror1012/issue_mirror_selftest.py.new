#!/usr/bin/env python3
"""issue_mirror_selftest.py -- lane.issuesync1012 round 2, gap 8.

Runs the REAL issue_mirror.py code (cmd_backfill, cmd_mirror_down, cmd_new, cmd_sync, cmd_seed, cmd_check,
secret_scan) against in-memory fakes (FakeGH, FakeFG below) that implement the exact same interface as the real
GH/FG clients (all_issues/comments/pull_detail/create/patch/comment). No subprocess, no curl, no network call of
any kind -- the fakes never touch a socket, which is a stronger guarantee than "localhost only".

State/lock/log files issue_mirror.py would otherwise read/write under host-tools/ are redirected to a scratch
temp path for the duration of each test (see `isolated`), so this file never touches real lane state.

Usage: python3 issue_mirror_selftest.py
Exit 0 and a line "issue_mirror_selftest: N/N passed" if every case passed; exit 1 otherwise, with FAIL lines
naming which case(s) broke.
"""
import contextlib
import copy
import io
import os
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import issue_mirror as im


def _now_iso():
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())


# --------------------------------------------------------------------------------------------------------------
# Fakes -- same interface as im.GH / im.FG, backed by plain dicts, no I/O at all.
# --------------------------------------------------------------------------------------------------------------

class FakeGH:
    def __init__(self):
        self.items = {}
        self.comments_store = {}
        self._next_comment_id = 1000
        self._reachable = True
        self.force_wrong_number = None
        self.force_failure_once = False
        self.force_patch_failure_once = False
        self.force_close_failure_once = False   # round 4, defect 2's regression test
        self.create_calls = 0
        self.write_calls = 0            # round 3, gap 3/4: every real create/patch/comment counts here
        self.repo_labels_list = []      # round 3, gap 2: configurable; compute_shared_vocab() reads this
        # Round 4 addendum: defaults to "active, far enough out" so every pre-existing backfill test keeps
        # passing without having to know this check exists. Tests of the check itself set this directly.
        self.interaction_limits_result = ('active', 100, '2099-01-01T00:00:00Z')
        # issuemirror1012 gap 2/3: updated_at tracking for changed_issues(), a read counter so a test can
        # measure "how many GitHub reads did this sync cost", and a settable remaining-budget figure for gap 3's
        # backfill pre-check. mk_pair() below writes gh.items[n] directly (never through create()), so a
        # pre-existing pair's updated_at defaults to "never changed" unless a test calls touch() explicitly.
        self.updated_at = {}
        self.read_calls = 0
        self._budget_remaining = 600

    def reachable(self):
        return self._reachable

    def touch(self, number):
        self.updated_at[number] = _now_iso()

    def all_issues(self, **kw):
        self.read_calls += 1
        return dict(self.items)

    def changed_issues(self, since_iso, **kw):
        self.read_calls += 1
        return {n: dict(it) for n, it in self.items.items() if self.updated_at.get(n, '0000') >= since_iso}

    def get_issue(self, number):
        self.read_calls += 1
        return dict(self.items[number])

    def budget_remaining(self):
        return self._budget_remaining

    def comments(self, number):
        return list(self.comments_store.get(number, []))

    def repo_labels(self):
        self.read_calls += 1
        return list(self.repo_labels_list)

    def interaction_limits(self):
        """Round 4 addendum: mirrors GH.interaction_limits()'s (status, limit, expires_at) contract."""
        return self.interaction_limits_result

    def max_number(self):
        """Round 3, optional race-window shrink: mirrors GH.max_number()'s cheapest-read contract."""
        return max(self.items) if self.items else 0

    def create(self, title, body='', labels=(), state=None):
        """Returns (number, close_err), matching GH.create()'s real round-4 contract (defect 2): a number is
        always spent and returned once this gets as far as assigning `n`; close_err is None unless the caller
        set force_close_failure_once AND asked for a closed-kind create, in which case the number is still
        spent (and returned) but the item is left open, with a close_err string instead of a raise."""
        prob = im.secret_scan(title, body)
        if prob:
            raise im.MirrorStop('REFUSED: %s -- GitHub create blocked' % prob)
        if self.force_failure_once:
            self.force_failure_once = False
            raise RuntimeError('simulated transient GitHub failure (nothing was spent)')
        self.create_calls += 1
        self.write_calls += 1
        if self.force_wrong_number is not None:
            n, self.force_wrong_number = self.force_wrong_number, None
        else:
            n = (max(self.items) + 1) if self.items else 1
        close_err = None
        actual_state = state or 'open'
        if state == 'closed' and self.force_close_failure_once:
            self.force_close_failure_once = False
            actual_state = 'open'
            close_err = 'simulated transient GitHub close failure (the create itself succeeded)'
        self.items[n] = {'number': n, 'title': title, 'body': body, 'state': actual_state,
                          'labels': [{'name': l} for l in labels], 'comments': 0}
        self.touch(n)
        return n, close_err

    def patch(self, number, title=None, body=None, state=None, labels=None):
        prob = im.secret_scan(title or '', body or '')
        if prob:
            raise im.MirrorStop('REFUSED: %s -- GitHub patch #%d blocked' % (prob, number))
        if self.force_patch_failure_once:
            self.force_patch_failure_once = False
            raise RuntimeError('simulated transient GitHub patch failure (nothing was spent)')
        self.write_calls += 1
        it = self.items[number]
        if title is not None:
            it['title'] = title
        if body is not None:
            it['body'] = body
        if state is not None:
            it['state'] = state
        if labels is not None:
            it['labels'] = [{'name': l} for l in labels]
        self.touch(number)
        return True

    def comment(self, number, body):
        prob = im.secret_scan(body)
        if prob:
            raise im.MirrorStop('REFUSED: %s -- GitHub comment on #%d blocked' % (prob, number))
        self.write_calls += 1
        cid = self._next_comment_id
        self._next_comment_id += 1
        self.comments_store.setdefault(number, []).append(
            {'id': cid, 'user': {'login': 'gh-user'}, 'created_at': '2026-10-12T00:00:00Z', 'body': body})
        self.items[number]['comments'] = self.items[number].get('comments', 0) + 1
        self.touch(number)
        return str(cid)


class FakeFG:
    def __init__(self):
        self.items = {}
        self.comments_store = {}
        self.pulls = {}
        self._next_comment_id = 2000
        self.force_wrong_number = None
        self.force_patch_failure_once = False    # round 3, gap 4's retry test
        self.force_set_labels_failure_once = False
        self.create_calls = 0
        self.write_calls = 0                      # round 3, gap 3/4: every real create/patch/comment/set_labels
        self.updated_at = {}    # issuemirror1012 gap 2: same contract as FakeGH.updated_at/touch()
        self.read_calls = 0

    def touch(self, number):
        self.updated_at[number] = _now_iso()

    def all_issues(self, **kw):
        self.read_calls += 1
        return dict(self.items)

    def changed_issues(self, since_iso, **kw):
        self.read_calls += 1
        return {n: dict(it) for n, it in self.items.items() if self.updated_at.get(n, '0000') >= since_iso}

    def get_issue(self, number):
        self.read_calls += 1
        return dict(self.items[number])

    def comments(self, number):
        return list(self.comments_store.get(number, []))

    def pull_detail(self, number):
        return dict(self.pulls.get(number, {}))

    def create(self, payload, is_pr=False):
        prob = im.secret_scan(payload.get('title', ''), payload.get('body', ''))
        if prob:
            raise im.MirrorStop('REFUSED: %s -- forge create blocked' % prob)
        self.create_calls += 1
        self.write_calls += 1
        if self.force_wrong_number is not None:
            n, self.force_wrong_number = self.force_wrong_number, None
        else:
            n = (max(self.items) + 1) if self.items else 1
        labels = [l if isinstance(l, dict) else {'name': l} for l in payload.get('labels', [])]
        item = {'number': n, 'title': payload.get('title', ''), 'body': payload.get('body', ''),
                'state': 'open', 'labels': labels, 'comments': 0}
        if is_pr:
            item['pull_request'] = {'merged': False, 'merged_at': None, 'draft': False, 'html_url': ''}
            self.pulls[n] = {'number': n, 'title': payload.get('title', ''), 'body': payload.get('body', ''),
                              'state': 'open', 'merged': False, 'merge_commit_sha': None,
                              'head': {'ref': payload.get('head', '?')}, 'labels': labels}
        self.items[n] = item
        self.touch(n)
        return n

    def patch(self, number, payload, is_pr=False):
        """Round 3, gap 5: mirrors the real forge's confirmed contract -- EditIssueOption (PATCH's body, per
        /swagger.v1.json) has no 'labels' property; the real API silently drops it. Rather than reproduce that
        silent no-op (which would let a caller's mistake pass the test unnoticed), the fake raises, matching
        issue_mirror.py's own FG.patch, which raises for the same reason. A caller that wants to change labels
        must use set_labels() (PUT /issues/{n}/labels), below."""
        if 'labels' in payload:
            raise RuntimeError("forge patch #%d: 'labels' must go through set_labels(), not patch() -- Forgejo's "
                                "issue PATCH silently ignores a 'labels' key (gap 5)" % number)
        prob = im.secret_scan(payload.get('title', '') or '', payload.get('body', '') if isinstance(payload.get('body'), str) else '')
        if prob:
            raise im.MirrorStop('REFUSED: %s -- forge patch #%d blocked' % (prob, number))
        if self.force_patch_failure_once:
            self.force_patch_failure_once = False
            raise RuntimeError('simulated transient forge patch failure (nothing was spent)')
        self.write_calls += 1
        it = self.items.get(number)
        if it:
            if 'title' in payload:
                it['title'] = payload['title']
            if 'body' in payload:
                it['body'] = payload['body']
            if 'state' in payload:
                it['state'] = payload['state']
        if number in self.pulls:
            pd = self.pulls[number]
            for k in ('title', 'state', 'merged', 'merge_commit_sha'):
                if k in payload:
                    pd[k] = payload[k]
        self.touch(number)
        return True

    def set_labels(self, number, names, is_pr=False):
        """Round 3, gap 5: mirrors FG.set_labels() -- PUT /issues/{n}/labels, a full replace of the label set."""
        if self.force_set_labels_failure_once:
            self.force_set_labels_failure_once = False
            raise RuntimeError('simulated transient forge set_labels failure (nothing was spent)')
        self.write_calls += 1
        labels = [{'name': n2} for n2 in names]
        if number in self.items:
            self.items[number]['labels'] = labels
        if number in self.pulls:
            self.pulls[number]['labels'] = labels
        self.touch(number)
        return True

    def comment(self, number, body):
        prob = im.secret_scan(body)
        if prob:
            raise im.MirrorStop('REFUSED: %s -- forge comment on #%d blocked' % (prob, number))
        self.write_calls += 1
        cid = self._next_comment_id
        self._next_comment_id += 1
        self.comments_store.setdefault(number, []).append(
            {'id': cid, 'user': {'login': 'forge-user'}, 'created_at': '2026-10-12T00:00:00Z', 'body': body})
        self.items[number]['comments'] = self.items[number].get('comments', 0) + 1
        self.touch(number)
        return cid


@contextlib.contextmanager
def isolated():
    """Redirects im.STATE / im.LOCK / im.LOG to scratch temp files for the duration of the block, restoring the
    module globals afterward. Never touches the real host-tools/ state this lane is staged under."""
    tmpdir = tempfile.mkdtemp(prefix='issue-mirror-selftest-')
    old = (im.STATE, im.LOCK, im.LOG)
    im.STATE = os.path.join(tmpdir, 'state.json')
    im.LOCK = os.path.join(tmpdir, 'lock')
    im.LOG = os.path.join(tmpdir, 'log')
    try:
        yield tmpdir
    finally:
        im.STATE, im.LOCK, im.LOG = old


def silent(fn, *a, **kw):
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        rc = fn(*a, **kw)
    return rc, buf.getvalue()


# --------------------------------------------------------------------------------------------------------------
# Test cases
# --------------------------------------------------------------------------------------------------------------

def mk_pair(gh, fg, n, title='item', body='body', state='open', labels=None, kind='issue'):
    labels = labels or []
    item = {'number': n, 'title': title, 'body': body, 'state': state,
            'labels': [{'name': l} for l in labels], 'comments': 0}
    gh.items[n] = dict(item)
    fg.items[n] = dict(item)
    if kind == 'PR':
        gh.items[n]['pull_request'] = {'url': 'x'}   # must be non-empty -- kind_of() treats {} as falsy, same as absent
        fg.items[n]['pull_request'] = {'merged': False, 'merged_at': None}
        fg.pulls[n] = {'number': n, 'title': title, 'body': body, 'state': state, 'merged': False,
                       'merge_commit_sha': None, 'head': {'ref': 'lane/x'}, 'labels': []}


def test_backfill_happy_path():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        mk_pair(gh, fg, 6, kind='never')  # placeholder, overwritten below
        del gh.items[6]
        fg.items[6] = {'number': 6, 'title': 'forge-only issue', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        fg.items[7] = {'number': 7, 'title': 'forge-only pr', 'body': 'desc', 'state': 'open',
                       'labels': [], 'comments': 0, 'pull_request': {'merged': False, 'merged_at': None}}
        fg.pulls[7] = {'number': 7, 'title': 'forge-only pr', 'body': 'desc', 'state': 'open', 'merged': False,
                       'merge_commit_sha': None, 'head': {'ref': 'lane/foo'}, 'labels': []}
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 0, 'rc=%r out=%s' % (rc, out)
        assert 6 in gh.items and gh.items[6]['title'] == 'forge-only issue', gh.items.get(6)
        assert 7 in gh.items and gh.items[7]['title'] == '[PR] forge-only pr', gh.items.get(7)
        assert gh.items[7]['state'] == 'closed'
        return 'backfill happy path: #6 (issue) and #7 (PR, single shape) created on GitHub'


def test_pre_create_mismatch_refusal():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 7):
            mk_pair(gh, fg, n)   # gh max now 6
        fg.items[8] = {'number': 8, 'title': 'skipped ahead', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 3, 'expected REFUSED rc=3, got %r: %s' % (rc, out)
        assert 'REFUSED' in out
        assert gh.create_calls == 0, 'a number was spent despite the mismatch'
        return 'pre-create mismatch refusal: REFUSED, 0 GitHub numbers spent'


def test_post_create_mismatch_stop():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        fg.items[6] = {'number': 6, 'title': 'a', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        fg.items[7] = {'number': 7, 'title': 'c', 'body': 'd', 'state': 'open', 'labels': [], 'comments': 0}
        gh.force_wrong_number = 99   # forge #6's twin comes back as GitHub #99
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 3, out
        assert 'STOP' in out
        assert 7 not in gh.items, 'the second item was created despite the first mismatch'
        st = im.load_state()
        assert st.get('backfill_last_done', 0) == 0, 'resume cursor advanced past a mismatch'
        return 'post-create mismatch stop: STOP on #6->#99, #7 never attempted'


def test_resume_after_stop():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        fg.items[6] = {'number': 6, 'title': 'a', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        fg.items[7] = {'number': 7, 'title': 'c', 'body': 'd', 'state': 'open', 'labels': [], 'comments': 0}
        rc1, out1 = silent(im.cmd_backfill, gh, fg, True, 1, 6000, False)
        assert rc1 == 0 and 6 in gh.items, out1
        gh.force_failure_once = True   # a transient create failure: nothing spent, resume cursor unmoved
        rc2, out2 = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc2 == 2 and 7 not in gh.items, out2
        assert im.load_state().get('backfill_last_done') == 6, 'resume cursor moved despite the failed create'
        rc3, out3 = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc3 == 0, out3
        assert 7 in gh.items and gh.items[7]['title'] == 'c', out3
        return 'resume after stop: #6 done, transient failure on #7 (nothing spent), resume completes #7'


def test_mirror_down_issue_and_pr():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        gh.items[1] = {'number': 1, 'title': 'hello', 'body': 'world', 'state': 'closed', 'labels': [{'name': 'bug'}], 'comments': 0}
        gh.items[2] = {'number': 2, 'title': 'add x', 'body': 'pr body', 'state': 'open', 'labels': [],
                       'comments': 0, 'pull_request': {'url': 'x'}}
        # #3 is deliberately absent on GitHub (a gap) to exercise the "reserved placeholder" path too.
        gh.items[4] = {'number': 4, 'title': 'later issue', 'body': 'z', 'state': 'open', 'labels': [], 'comments': 0}
        rc = im.cmd_mirror_down(gh, fg, True)
        assert rc == 0
        assert fg.items[1]['title'] == 'hello' and fg.items[1]['state'] == 'closed' and 'bug' in [l['name'] for l in fg.items[1]['labels']]
        assert im.has_marker(fg.items[1])
        assert fg.items[2]['title'] == '[GitHub PR] add x'
        assert fg.items[3]['title'].startswith('#3: reserved'), fg.items.get(3)
        assert fg.items[3]['state'] == 'closed'
        assert fg.items[4]['title'] == 'later issue'
        return 'mirror-down: public issue, public PR ([GitHub PR] shape), and a GitHub gap (reserved placeholder)'


def test_new_refuses_when_forge_ahead():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        fg.items[6] = {'number': 6, 'title': 'ahead', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        rc, out = silent(im.cmd_new, gh, fg, 'issue', 'new thing', '', 'jobs', True)
        assert rc == 3 and 'REFUSED' in out, out
        assert gh.create_calls == 0 and fg.create_calls == 0
        return 'new refuses when forge is ahead: REFUSED, nothing spent on either side'


def test_new_pr_close_failure_queues_and_resume_clears_pending():
    """Round 5, item 1: cmd_new loaded its own `st = load_state()` BEFORE calling _new_pr, so when _new_pr's
    close-failure path did its own load_state()/append-to-pending_close/save_state(), cmd_new's later
    save_state(st) -- using the stale `st` it loaded before _new_pr ever ran -- silently clobbered that entry
    right back out of the file. The twin stayed open on GitHub with nothing queued to retry it. Exercises
    `new --kind pr` with a forced close failure, then a sync: requires the close is retried exactly once and
    cleared, and that a following sync makes 0 writes once settled."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        gh.force_close_failure_once = True
        rc, out = silent(im.cmd_new, gh, fg, 'pr', 'new pr title', 'pr body', 'jobs', True, head='lane/x')
        assert rc == 0, 'rc=%r out=%s' % (rc, out)
        assert 6 in gh.items and gh.items[6]['state'] == 'open', gh.items.get(6)
        assert 6 in fg.items, fg.items
        st = im.load_state()
        assert st.get('pending_close') == [6], \
            'pending_close must survive cmd_new\'s own save_state -- got %r (out=%s)' % (st.get('pending_close'), out)
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0, out2
        assert 'pending close(s)' in out2 and 'cleared' in out2, out2
        assert gh.items[6]['state'] == 'closed', gh.items.get(6)
        st2 = im.load_state()
        assert not st2.get('pending_close'), st2.get('pending_close')
        gh.write_calls = 0
        fg.write_calls = 0
        rc3, out3 = silent(im.cmd_sync, gh, fg, True)
        assert rc3 == 0, out3
        assert gh.write_calls == 0 and fg.write_calls == 0, \
            'expected 0 writes once settled: gh=%d fg=%d (out=%s)' % (gh.write_calls, fg.write_calls, out3)
        return ('new --kind pr close failure: pending_close survives cmd_new\'s save, retried exactly once by '
                'sync and cleared, 0 writes on the following sync')


def test_new_issue_truncates_long_body_for_github_only():
    """Round 5, item 2: gap 3 (truncate_for_github) only ever ran on the backfill/sync write paths -- `new`
    passed an arbitrarily long body straight to GitHub, which would refuse any body over 65536 characters
    outright. Exercises `new --kind issue` with a body well over the limit: GitHub's side must be capped (with
    the plain, non-forge-mentioning truncation suffix) while the forge keeps the full, untruncated body; the
    baseline cmd_new records for each side must match what that side actually ended up holding."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        long_body = 'x' * (im.GITHUB_BODY_LIMIT + 5000)
        rc, out = silent(im.cmd_new, gh, fg, 'issue', 'long body issue', long_body, 'jobs', True)
        assert rc == 0, 'rc=%r out=%s' % (rc, out)
        n = 6
        assert n in gh.items and n in fg.items
        assert len(gh.items[n]['body']) == im.GITHUB_BODY_LIMIT, len(gh.items[n]['body'])
        assert gh.items[n]['body'].endswith(im.GITHUB_BODY_TRUNCATE_SUFFIX), gh.items[n]['body'][-40:]
        assert '(truncated)' in gh.items[n]['body'] and 'forge' not in gh.items[n]['body'].lower()
        assert fg.items[n]['body'].startswith(long_body), 'the forge side must keep the full body untruncated'
        assert len(fg.items[n]['body']) > im.GITHUB_BODY_LIMIT
        st = im.load_state()
        entry = st['last_synced'][str(n)]
        assert entry['gh']['body'] == gh.items[n]['body'], \
            'recorded GitHub baseline must equal what GitHub actually ended up holding (the truncated text)'
        assert entry['fg']['body'] == long_body, \
            'recorded forge baseline must equal the full body (marker stripped)'
        return ('new --kind issue: a long body is capped on GitHub only (%d chars, "(truncated)" suffix); the '
                'forge keeps the full %d-char body; both baselines match what each side actually holds' %
                (len(gh.items[n]['body']), len(fg.items[n]['body'])))


def test_new_mirrors_down_first_when_github_ahead():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        gh.items[6] = {'number': 6, 'title': 'ahead on github', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        rc, out = silent(im.cmd_new, gh, fg, 'issue', 'new thing', 'body text', 'jobs', True)
        assert rc == 0, out
        assert 6 in fg.items and fg.items[6]['title'] == 'ahead on github', fg.items.get(6)
        assert 7 in gh.items and 7 in fg.items and gh.items[7]['title'] == 'new thing'
        return 'new mirrors GitHub-ahead #6 down first, then allocates #7 on both sides'


def test_three_way_sync_echo_suppression():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        # #1 only (no gap below it), so sync's preliminary mirror-down step has nothing to do -- this test is
        # about the field-level three-way merge, not mirror-down.
        mk_pair(gh, fg, 1, title='original title', body='original body', state='open', labels=['keep'])
        rc0, out0 = silent(im.cmd_sync, gh, fg, True)
        assert rc0 == 0, out0
        fg.items[1]['title'] = 'retitled on the forge'
        rc1, out1 = silent(im.cmd_sync, gh, fg, True)
        assert rc1 == 0, out1
        assert gh.items[1]['title'] == 'retitled on the forge', out1
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0, out2
        assert '0 field actions' in out2, 'a settled field was re-applied: %s' % out2
        return 'three-way sync: forge title change propagates once, re-run is a no-op (0 field actions)'


def test_pr_twin_status_rewrite_on_fold():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        # #1 only (no gap below it), so sync's preliminary mirror-down step has nothing to do.
        gh.items[1] = {'number': 1, 'title': '[PR] my change', 'body': 'placeholder', 'state': 'closed', 'labels': [], 'comments': 0}
        fg.items[1] = {'number': 1, 'title': 'my change', 'body': 'desc', 'state': 'open', 'labels': [], 'comments': 0,
                       'pull_request': {'merged': False, 'merged_at': None}}
        fg.pulls[1] = {'number': 1, 'title': 'my change', 'body': 'desc', 'state': 'open', 'merged': False,
                       'merge_commit_sha': None, 'head': {'ref': 'lane/change'}, 'labels': []}
        rc0, _ = silent(im.cmd_sync, gh, fg, True)
        assert rc0 == 0
        assert 'open' in gh.items[1]['body'].lower()
        fg.items[1]['labels'] = [{'name': 'folded'}]
        fg.pulls[1]['labels'] = [{'name': 'folded'}]
        rc1, out1 = silent(im.cmd_sync, gh, fg, True)
        assert rc1 == 0, out1
        assert 'folded' in gh.items[1]['body'].lower() and 'not recorded it as merged yet' in gh.items[1]['body'], gh.items[1]['body']
        return 'PR-twin status rewrite: body status line updates open -> folded-unmerged on a label change'


def test_comment_mirroring_both_ways_once_each():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        # #1 only (no gap below it), so sync's preliminary mirror-down step has nothing to do.
        mk_pair(gh, fg, 1, title='t', body='b', state='open', labels=[])
        rc0, _ = silent(im.cmd_sync, gh, fg, True)
        assert rc0 == 0
        gh.comment(1, 'a github comment')
        fg.comment(1, 'a forge comment')
        rc1, out1 = silent(im.cmd_sync, gh, fg, True)
        assert rc1 == 0, out1
        assert len(fg.comments_store[1]) == 2, fg.comments_store[1]   # original forge comment + mirrored github one
        assert len(gh.comments_store[1]) == 2, gh.comments_store[1]
        assert im.COMMENT_MARKER_RE.search(fg.comments_store[1][-1]['body'])
        assert im.COMMENT_MARKER_RE.search(gh.comments_store[1][-1]['body'])
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0, out2
        assert len(fg.comments_store[1]) == 2 and len(gh.comments_store[1]) == 2, 'a mirrored comment echoed back'
        return 'comment mirroring: one each way, marker-tagged, no echo on the next run'


def test_comment_baseline_advances_past_cur_not_prev():
    """Round 3 rehearsal finding: sync_comments() used to advance the baseline to prev_gh/prev_fg + added_gh/
    added_fg instead of cur_gh/cur_fg + added_gh/added_fg. The existing both-ways test above never caught this
    because it adds exactly one comment on EACH side, which makes added_gh/added_fg numerically coincide with
    cur_gh-prev_gh/cur_fg-prev_fg -- the bug is invisible under that symmetry. This test breaks the symmetry: a
    comment appears on only ONE side first, gets mirrored, and a second (then third) sync must never re-mirror
    it -- with the buggy formula, the un-touched side's baseline is advanced but the touched side's baseline is
    not, and the mirrored copy keeps getting re-mirrored forever."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1, title='t', body='b', state='open', labels=[])
        rc0, _ = silent(im.cmd_sync, gh, fg, True)
        assert rc0 == 0
        gh.comment(1, 'only a github comment this time')
        rc1, out1 = silent(im.cmd_sync, gh, fg, True)
        assert rc1 == 0, out1
        assert len(fg.comments_store[1]) == 1, fg.comments_store[1]   # the one mirrored copy
        assert len(gh.comments_store[1]) == 1, gh.comments_store[1]   # the original, never touched
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0, out2
        assert len(fg.comments_store[1]) == 1, 'an asymmetric comment was re-mirrored on the next run: %r' % fg.comments_store[1]
        rc3, out3 = silent(im.cmd_sync, gh, fg, True)
        assert rc3 == 0, out3
        assert len(fg.comments_store[1]) == 1, 'an asymmetric comment was re-mirrored two runs later: %r' % fg.comments_store[1]
        return 'an asymmetric comment mirror settles after one write and never repeats'


def test_seed_then_quiet_sync():
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 2, title='settled', body='settled body', state='open', labels=[])
        gh.items[16] = {'number': 16, 'title': 'needs closing', 'body': 'b', 'state': 'closed', 'labels': [], 'comments': 0}
        fg.items[16] = {'number': 16, 'title': 'needs closing', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        gh.items[1] = {'number': 1, 'title': 'real title', 'body': 'real body', 'state': 'open', 'labels': [], 'comments': 0}
        fg.items[1] = {'number': 1, 'title': '#1: not recovered', 'body': '(lost)', 'state': 'open', 'labels': [], 'comments': 0}
        rc, out = silent(im.cmd_seed, gh, fg, True)
        assert rc == 0, out
        assert fg.items[16]['state'] == 'closed', out
        assert fg.items[1]['title'] == 'real title', out
        rc2, out2 = silent(im.cmd_sync, gh, fg, False)
        assert rc2 == 0, out2
        assert '0 field actions, 0 conflicts' in out2, 'seed did not leave a quiet dry-run sync: %s' % out2
        return 'seed applies the resolutions, then a dry-run sync reports 0 actions and 0 conflicts'


def test_secret_scan_refuses_token_body():
    prob = im.secret_scan(None, 'leaked: ghp_' + 'A' * 36)
    assert prob, 'secret_scan missed a token-shaped string'
    gh = FakeGH()
    try:
        gh.create('title', 'body with ghp_' + 'B' * 36)
        assert False, 'create() did not raise on a token-shaped body'
    except im.MirrorStop as e:
        assert 'REFUSED' in str(e)
    assert gh.create_calls == 0 and not gh.items, 'a number was spent despite the secret scan'
    return 'secret scan: refuses a token-shaped body before GitHub create spends a number'


def test_dry_run_sync_writes_nothing_with_new_comments():
    """Round 3, gap 3: sync_comments() must never write on a dry run. Set up a new, unmirrored comment on each
    side (posted directly on the fakes, bypassing cmd_sync, the way a real new GitHub/forge comment would arrive),
    then run a dry-run sync and assert zero writes on either fake and zero state change anywhere."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1, title='t', body='b', state='open', labels=[])
        rc0, out0 = silent(im.cmd_sync, gh, fg, True)   # establish the baseline (comments=0,0 both sides)
        assert rc0 == 0, out0
        gh.comment(1, 'a new github comment, not yet mirrored')
        fg.comment(1, 'a new forge comment, not yet mirrored')
        gh.write_calls = 0
        fg.write_calls = 0   # only the DRY RUN sync below is under test
        gh_items_before, fg_items_before = copy.deepcopy(gh.items), copy.deepcopy(fg.items)
        gh_comments_before, fg_comments_before = copy.deepcopy(gh.comments_store), copy.deepcopy(fg.comments_store)
        rc1, out1 = silent(im.cmd_sync, gh, fg, False)
        assert rc1 == 0, out1
        assert gh.write_calls == 0 and fg.write_calls == 0, \
            'dry-run sync made a write (gh=%d fg=%d writes): %s' % (gh.write_calls, fg.write_calls, out1)
        assert gh.items == gh_items_before and fg.items == fg_items_before, 'dry-run sync mutated an item'
        assert gh.comments_store == gh_comments_before and fg.comments_store == fg_comments_before, \
            'dry-run sync mutated a comment store'
        assert 'dry run' in out1
        return 'dry-run sync with a new comment on each side: 0 writes, 0 state change either side'


def test_failed_forge_write_then_retry_never_reverses():
    """Round 3, gap 4: a failed forge write must not advance the baseline, or the next run would see the forge as
    unexpectedly "still changed from its old value" and copy that old value right back over the real GitHub edit --
    reverting it. The retry (no forced failure) must apply the SAME pending github->forge write, never reverse."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1, title='original', body='b', state='open', labels=[])
        rc0, out0 = silent(im.cmd_sync, gh, fg, True)
        assert rc0 == 0, out0
        gh.items[1]['title'] = 'new title from github'
        fg.force_patch_failure_once = True
        rc1, out1 = silent(im.cmd_sync, gh, fg, True)
        assert rc1 == 2, out1
        assert fg.items[1]['title'] == 'original', \
            'forge title changed despite the simulated failed write: %s' % out1
        assert gh.items[1]['title'] == 'new title from github', 'the real GitHub edit was reverted after the failure'
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0, out2
        assert fg.items[1]['title'] == 'new title from github', \
            'retry did not apply the pending github->forge title write: %s' % out2
        rc3, out3 = silent(im.cmd_sync, gh, fg, True)
        assert rc3 == 0, out3
        assert '0 field actions' in out3, 'baseline not settled after the retry succeeded: %s' % out3
        return ('failed forge write then retry: sync #1 fails without reverting the GitHub edit, sync #2 retries '
                'the same github->forge direction and applies it, sync #3 settles at 0 actions')


def test_forgejo_label_api_contract_enforced_in_fake():
    """Round 3, gap 5, confirmed live and read-only against this forge (GET /api/v1/version ->
    16.0.5+gitea-1.22.0; /swagger.v1.json): EditIssueOption (PATCH /issues/{n}'s body) has no 'labels' property at
    all, so the real API silently drops a labels key in a PATCH payload -- never an error, never applied. A fake
    that accepted it would let that production bug pass every test silently. This fake instead raises, matching
    FG.patch's own real-code fix; the only path that actually changes labels is set_labels() (PUT
    /issues/{n}/labels), which IssueLabelsOption accepts as a list of names or ids."""
    with isolated():
        fg = FakeFG()
        fg.items[1] = {'number': 1, 'title': 't', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        try:
            fg.patch(1, {'labels': ['bug']})
            assert False, ('the fake silently accepted a labels key in patch() -- the real Forgejo PATCH ignores '
                            'it; a test against this fake would never have caught that production bug')
        except RuntimeError as e:
            assert 'set_labels' in str(e), e
        assert fg.items[1]['labels'] == [], 'patch() must not touch labels even on its raise path'
        ok = fg.set_labels(1, ['bug', 'docs'])
        assert ok and sorted(l['name'] for l in fg.items[1]['labels']) == ['bug', 'docs']
        return ("Forgejo label API contract: patch({'labels': ...}) raises (real PATCH silently ignores labels); "
                "set_labels() (PUT /issues/{n}/labels) is the only path that actually works")


def test_label_sync_keeps_forge_local_only_labels():
    """Round 3, gap 2 + gap 5 together: a shared label GitHub adds must reach the forge (through set_labels, per
    gap 5), while the forge's own local-only/pipeline label (never in GitHub's repo label list, so never in the
    shared vocabulary) must survive that write untouched -- set_labels is a full replace, so apply_sync_actions
    must merge the forge's current local-only labels into the payload itself."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        gh.repo_labels_list = [{'name': 'bug'}, {'name': 'docs'}]
        mk_pair(gh, fg, 1, title='t', body='b', state='open', labels=[])
        fg.items[1]['labels'] = [{'name': 'local-only'}]   # a forge-only pipeline/process label, never shared
        rc0, out0 = silent(im.cmd_sync, gh, fg, True)   # baseline: shared view is [] both sides ('local-only' excluded)
        assert rc0 == 0, out0
        gh.items[1]['labels'] = [{'name': 'bug'}]   # GitHub adds a label that IS in the shared vocabulary
        rc1, out1 = silent(im.cmd_sync, gh, fg, True)
        assert rc1 == 0, out1
        fg_names = sorted(l['name'] for l in fg.items[1]['labels'])
        assert fg_names == ['bug', 'local-only'], \
            'forge lost its local-only label, or never picked up the shared one: %s (%s)' % (fg_names, out1)
        return 'label sync: GitHub-added shared label reaches the forge via set_labels, local-only label preserved'


def test_create_close_failure_then_resume_clears_pending():
    """Round 4, defect 2: a PR-twin create whose follow-up close fails must not lose the spent GitHub number.
    Requires all of: the cursor advanced; no REFUSED; the close retried exactly once and cleared on resume;
    0 writes on the following sync (so nothing re-detects the already-settled pair as drift)."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n)
        fg.items[6] = {'number': 6, 'title': 'pr-twin', 'body': 'desc', 'state': 'open', 'labels': [], 'comments': 0,
                       'pull_request': {'merged': False, 'merged_at': None}}
        fg.pulls[6] = {'number': 6, 'title': 'pr-twin', 'body': 'desc', 'state': 'open', 'merged': False,
                       'merge_commit_sha': None, 'head': {'ref': 'lane/x'}, 'labels': []}
        gh.force_close_failure_once = True
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 0 and 'REFUSED' not in out, out
        assert 6 in gh.items and gh.items[6]['state'] == 'open', \
            'the spent number was lost, or its state was not recorded as GitHub actually left it: %s' % gh.items.get(6)
        st = im.load_state()
        assert st.get('backfill_last_done') == 6, 'cursor did not advance past the close-failed item: %s' % st
        assert st.get('pending_close') == [6], 'pending_close not queued: %s' % st

        # Resume: nothing left to backfill, but the pending close must still be retried up front.
        rc2, out2 = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc2 == 0, out2
        assert out2.count('retried and cleared') == 1, 'close retried more or less than exactly once: %s' % out2
        assert gh.items[6]['state'] == 'closed', gh.items[6]
        st2 = im.load_state()
        assert not st2.get('pending_close'), 'pending_close not cleared after a successful retry: %s' % st2

        writes_before = gh.write_calls
        rc3, out3 = silent(im.cmd_sync, gh, fg, True)
        assert rc3 == 0, out3
        assert gh.write_calls == writes_before, \
            'the following sync wrote to GitHub (%d writes) when the pair was already settled: %s' % \
            (gh.write_calls - writes_before, out3)
        return ('create-close-failure then resume: cursor advanced to #6, no REFUSED, close retried exactly '
                'once and cleared, 0 GitHub writes on the following sync')


def test_truncate_for_github_caps_at_body_limit():
    """Round 4, gap 3: an outgoing GitHub body longer than GITHUB_BODY_LIMIT is cut to the limit and ends with a
    plain '(truncated)' line that never mentions the forge. Also checks the end-to-end backfill path: the
    TRUNCATED text, not the original, must become GitHub's own baseline, or the truncation itself would look
    like drift on the very next sync."""
    with isolated():
        long_body = 'x' * (im.GITHUB_BODY_LIMIT + 5000)
        out = im.truncate_for_github(long_body)
        assert len(out) == im.GITHUB_BODY_LIMIT, 'truncated length=%d, limit=%d' % (len(out), im.GITHUB_BODY_LIMIT)
        assert out.endswith('(truncated)'), out[-40:]
        assert 'forge' not in out.lower(), 'the forge is not public -- it must never be mentioned in a GitHub body'
        short_body = 'short body, well under the limit'
        assert im.truncate_for_github(short_body) == short_body, 'a body under the limit must pass through untouched'

        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1)
        fg.items[2] = {'number': 2, 'title': 'big', 'body': long_body, 'state': 'open', 'labels': [], 'comments': 0}
        rc, out_log = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 0, out_log
        assert len(gh.items[2]['body']) == im.GITHUB_BODY_LIMIT, \
            'backfill sent an over-limit body to GitHub: %d chars' % len(gh.items[2]['body'])
        writes_before = gh.write_calls
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0 and gh.write_calls == writes_before and 'CONFLICT' not in out2, \
            'the truncated body was not recorded as its own baseline -- looked like drift on the next sync: %s' % out2
        return 'truncate_for_github: caps at the limit, ends "(truncated)", no forge mention; truncated text is the baseline'


def test_interaction_limit_active_and_long_enough_allows_backfill():
    """Round 4 addendum, outcome 1 of 3: an active limit whose expires_at is well after the run's estimated end
    lets backfill proceed exactly as if the check did not exist."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1)
        fg.items[2] = {'number': 2, 'title': 'new', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        gh.interaction_limits_result = ('active', 100, '2099-01-01T00:00:00Z')
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 0, out
        assert 2 in gh.items, 'backfill did not create #2 despite a long-enough active limit: %s' % out
        assert 'interaction-limits: active' in out
        return 'interaction-limits active+long-enough: backfill proceeds, #2 created'


def test_interaction_limit_absent_refuses_backfill():
    """Round 4 addendum, outcome 2 of 3: no limit active at all -- refuse, spend nothing, unless overridden."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1)
        fg.items[2] = {'number': 2, 'title': 'new', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        gh.interaction_limits_result = ('absent', None, None)
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 3, out
        assert 'REFUSED' in out and 'no GitHub interaction limit is active' in out, out
        assert gh.create_calls == 0, 'a number was spent despite no active interaction limit'
        rc2, out2 = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False, no_interaction_limit=True)
        assert rc2 == 0 and 2 in gh.items, 'the --no-interaction-limit override did not let backfill proceed: %s' % out2
        return 'interaction-limits absent: REFUSED and 0 spent; --no-interaction-limit overrides and #2 is created'


def test_interaction_limit_forbidden_refuses_backfill():
    """Round 4 addendum, outcome 3 of 3: a 403 (token lacks permission) is treated as unknown, not as "off" --
    refuse, spend nothing, unless overridden."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1)
        fg.items[2] = {'number': 2, 'title': 'new', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        gh.interaction_limits_result = ('forbidden', None, None)
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 3, out
        assert 'REFUSED' in out and '403' in out, out
        assert gh.create_calls == 0, 'a number was spent despite an unreadable (403) interaction limit'
        rc2, out2 = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False, no_interaction_limit=True)
        assert rc2 == 0 and 2 in gh.items, 'the --no-interaction-limit override did not let backfill proceed: %s' % out2
        return 'interaction-limits forbidden (403): REFUSED and 0 spent; --no-interaction-limit overrides and #2 is created'


# --------------------------------------------------------------------------------------------------------------
# issuemirror1012: gap 1 (one shared lock), gap 2 (incremental sync), gap 3 (budget-true pre-check)
# --------------------------------------------------------------------------------------------------------------

def test_lock_refuses_concurrent_sync_during_backfill():
    """issuemirror1012 gap 1, test a: a fake backfill holding .issue-mirror.lock makes a concurrent `sync --yes`
    refuse (exit 75, 'skipped: another run holds the lock'), with nothing written to state."""
    import fcntl
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1)
        rc0, out0 = silent(im.cmd_sync, gh, fg, True)
        assert rc0 == 0, out0
        before = open(im.STATE, 'rb').read()
        fd = os.open(im.LOCK, os.O_CREAT | os.O_RDWR, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            rc, out = silent(im.cmd_sync, gh, fg, True)
            assert rc == 75, out
            assert 'skipped: another run holds the lock' in out, out
            after = open(im.STATE, 'rb').read()
            assert after == before, 'state file was written while a concurrent run held the lock'
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0, 'sync did not recover once the lock was released: %s' % out2
        return 'sync --yes refuses (75, "skipped") while another run holds the lock; recovers once released'


def test_sync_cannot_reverse_backfill_cursor_while_locked():
    """issuemirror1012 gap 1, test b: a sync overlapping a backfill can no longer load a stale copy of the state
    and save backfill_last_done backwards over the backfill's own progress -- the two now share one lock."""
    import fcntl
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1)
        fd = os.open(im.LOCK, os.O_CREAT | os.O_RDWR, 0o644)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        try:
            # The backfill's own in-progress state write, made while it holds the lock.
            st = im.load_state()
            st['backfill_last_done'] = 5
            im.save_state(st)
            rc, out = silent(im.cmd_sync, gh, fg, True)
            assert rc == 75, out
            assert im.load_state().get('backfill_last_done') == 5, \
                'a concurrent sync moved backfill_last_done backwards while the backfill held the lock'
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)
        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
        assert rc2 == 0, out2
        assert im.load_state().get('backfill_last_done') == 5, \
            'backfill_last_done was lost once the real sync ran with the lock free'
        return 'a sync overlapping a backfill cannot move backfill_last_done backwards; preserved once run for real'


def test_incremental_sync_steady_state_reads_at_most_two():
    """issuemirror1012 gap 2: once a full sync has established last_sync_started_utc, an incremental sync with
    nothing changed costs at most 2 GitHub reads (vs. ~10 for a full paginated listing) -- the brief's explicit
    target, measured here against the fakes."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        for n in range(1, 6):
            mk_pair(gh, fg, n, title='item %d' % n)
        rc0, out0 = silent(im.cmd_sync, gh, fg, True, full=True)
        assert rc0 == 0, out0
        gh.read_calls = 0
        rc, out = silent(im.cmd_sync, gh, fg, True, full=False)
        assert rc == 0, out
        assert 'sync (incremental)' in out, out
        assert gh.read_calls <= 2, \
            'steady-state incremental sync cost %d GitHub read(s), want <= 2: %s' % (gh.read_calls, out)
        return 'steady-state incremental sync costs %d GitHub read(s) (target <= 2)' % gh.read_calls


def test_incremental_sync_applies_changed_forge_pair():
    """issuemirror1012 gap 2: a forge-only field change, made after the baseline full sync, is picked up and
    applied to GitHub by the incremental pass -- proving the cheap pass is still correct, not just cheap."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1, title='original')
        rc0, out0 = silent(im.cmd_sync, gh, fg, True, full=True)
        assert rc0 == 0, out0
        fg.items[1]['title'] = 'changed on the forge'
        fg.touch(1)
        rc, out = silent(im.cmd_sync, gh, fg, True, full=False)
        assert rc == 0, out
        assert gh.items[1]['title'] == 'changed on the forge', \
            'incremental sync did not carry the forge-only title change to GitHub: %s' % out
        return 'incremental sync carries a forge-only field change to GitHub'


def test_budget_true_precheck_uses_remaining_not_stale_cap():
    """issuemirror1012 gap 3: the backfill pre-check now compares against what github_gateway.py budget says is
    actually left today, not a stale 300/day constant -- a small remaining budget disables the optional
    per-item race-window re-check even though the old stale default would have allowed it."""
    with isolated():
        gh, fg = FakeGH(), FakeFG()
        mk_pair(gh, fg, 1)
        for n in range(2, 12):
            fg.items[n] = {'number': n, 'title': 'new %d' % n, 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        gh._budget_remaining = 15
        rc, out = silent(im.cmd_backfill, gh, fg, True, 0, 6000, False)
        assert rc == 0, out
        assert 'DISABLED' in out, 'a small remaining budget (15 vs. 10 items) should disable the pre-check: %s' % out
        assert not hasattr(im, 'GITHUB_READ_BUDGET_DAY'), 'the stale GITHUB_READ_BUDGET_DAY default must be removed'

    with isolated():
        gh2, fg2 = FakeGH(), FakeFG()
        mk_pair(gh2, fg2, 1)
        fg2.items[2] = {'number': 2, 'title': 'new', 'body': 'b', 'state': 'open', 'labels': [], 'comments': 0}
        gh2._budget_remaining = 600
        rc2, out2 = silent(im.cmd_backfill, gh2, fg2, True, 0, 6000, False)
        assert rc2 == 0, out2
        assert 'pre-check enabled' in out2, 'a healthy remaining budget (600) should enable the pre-check: %s' % out2
        return ('backfill pre-check reads the gateway\'s remaining budget: DISABLED at 15 remaining for 10 items, '
                'enabled at 600 remaining for 1 item')


TESTS = [
    test_backfill_happy_path,
    test_pre_create_mismatch_refusal,
    test_post_create_mismatch_stop,
    test_resume_after_stop,
    test_mirror_down_issue_and_pr,
    test_new_refuses_when_forge_ahead,
    test_new_mirrors_down_first_when_github_ahead,
    test_three_way_sync_echo_suppression,
    test_pr_twin_status_rewrite_on_fold,
    test_comment_mirroring_both_ways_once_each,
    test_comment_baseline_advances_past_cur_not_prev,
    test_seed_then_quiet_sync,
    test_secret_scan_refuses_token_body,
    test_dry_run_sync_writes_nothing_with_new_comments,
    test_failed_forge_write_then_retry_never_reverses,
    test_forgejo_label_api_contract_enforced_in_fake,
    test_label_sync_keeps_forge_local_only_labels,
    test_create_close_failure_then_resume_clears_pending,
    test_truncate_for_github_caps_at_body_limit,
    test_interaction_limit_active_and_long_enough_allows_backfill,
    test_interaction_limit_absent_refuses_backfill,
    test_interaction_limit_forbidden_refuses_backfill,
    test_new_pr_close_failure_queues_and_resume_clears_pending,
    test_new_issue_truncates_long_body_for_github_only,
    test_lock_refuses_concurrent_sync_during_backfill,
    test_sync_cannot_reverse_backfill_cursor_while_locked,
    test_incremental_sync_steady_state_reads_at_most_two,
    test_incremental_sync_applies_changed_forge_pair,
    test_budget_true_precheck_uses_remaining_not_stale_cap,
]


def main():
    passed, failed = [], []
    for t in TESTS:
        name = t.__name__
        try:
            detail = t()
            print('PASS %s -- %s' % (name, detail))
            passed.append(name)
        except Exception as e:
            print('FAIL %s -- %s: %s' % (name, type(e).__name__, e))
            failed.append(name)
    print('issue_mirror_selftest: %d/%d passed%s' %
          (len(passed), len(TESTS), ('' if not failed else ' -- FAILED: ' + ', '.join(failed))))
    return 0 if not failed else 1


if __name__ == '__main__':
    sys.exit(main())
