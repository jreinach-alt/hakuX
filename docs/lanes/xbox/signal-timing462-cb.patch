+void SignalTimingTests::SetupDraw() {
+  host_.SetBlend(false);
+  for (uint32_t stage = 0; stage < 4; ++stage) {
+    host_.SetTextureStageEnabled(stage, false);
+  }
+  host_.SetShaderStageProgram(TestHost::STAGE_NONE);
+  host_.SetFinalCombiner0Just(TestHost::SRC_DIFFUSE);
+  host_.SetFinalCombiner1Just(TestHost::SRC_DIFFUSE, true);
+}
+
+// count screen-space quads of size x size pixels in a row-major grid from (left, top), one draw call each.
+void SignalTimingTests::Quads(int count, float left, float top, float size, float r, float g, float b) {
+  const int per_row = 16;
+  for (int i = 0; i < count; ++i) {
+    const float x = left + static_cast<float>(i % per_row) * size;
+    const float y = top + static_cast<float>((i / per_row) % 16) * size;
+    host_.Begin(TestHost::PRIMITIVE_QUADS);
+    host_.SetDiffuse(r, g, b, 1.0f);
+    host_.SetVertex(x, y, 1.0f);
+    host_.SetVertex(x + size - 1.0f, y, 1.0f);
+    host_.SetVertex(x + size - 1.0f, y + size - 1.0f, 1.0f);
+    host_.SetVertex(x, y + size - 1.0f, 1.0f);
+    host_.End();
+  }
+}
+
+// As texture_render_target_tests.cpp redirects color output to its target (the sequence proven on the console,
+// including its NO_OPERATION + WAIT_FOR_IDLE after the offset change).
+void SignalTimingTests::ToTarget() {
+  const uint32_t fb_pitch = host_.GetFramebufferWidth() * 4;
+  host_.SetSurfaceFormatImmediate(TestHost::SCF_A8R8G8B8, TestHost::SZF_Z24S8, kTarget, kTarget);
+  Pushbuffer::Begin();
+  Pushbuffer::Push(NV097_SET_SURFACE_PITCH, SET_MASK(NV097_SET_SURFACE_PITCH_COLOR, kTargetPitch) |
+                                                SET_MASK(NV097_SET_SURFACE_PITCH_ZETA, fb_pitch));
+  Pushbuffer::Push(NV097_SET_CONTEXT_DMA_COLOR, target_ctx_.ChannelID);
+  Pushbuffer::Push(NV097_SET_SURFACE_COLOR_OFFSET, 0);
+  Pushbuffer::Push(NV097_NO_OPERATION, 0);
+  Pushbuffer::Push(NV097_WAIT_FOR_IDLE, 0);
+  Pushbuffer::End();
+  TestHost::SetWindowClip(kTarget - 1, kTarget - 1);
+}
+
+// Back to the back buffer: pbkit's color DMA (9) still points at it, since no flip happens inside a test.
+void SignalTimingTests::ToBackBuffer() {
+  const uint32_t fb_pitch = host_.GetFramebufferWidth() * 4;
+  host_.SetSurfaceFormatImmediate(TestHost::SCF_A8R8G8B8, TestHost::SZF_Z24S8, host_.GetFramebufferWidth(),
+                                  host_.GetFramebufferHeight());
+  Pushbuffer::Begin();
+  Pushbuffer::Push(NV097_SET_SURFACE_PITCH, SET_MASK(NV097_SET_SURFACE_PITCH_COLOR, fb_pitch) |
+                                                SET_MASK(NV097_SET_SURFACE_PITCH_ZETA, fb_pitch));
+  Pushbuffer::Push(NV097_SET_CONTEXT_DMA_COLOR, kPbkitColor);
+  Pushbuffer::Push(NV097_SET_SURFACE_COLOR_OFFSET, 0);
+  Pushbuffer::End();
+  TestHost::SetWindowClip(host_.GetFramebufferWidth() - 1, host_.GetFramebufferHeight() - 1);
+}
+
+void SignalTimingTests::Write(const std::string &name, const std::string &summary,
+                              const std::vector<std::string> &columns, const std::vector<std::vector<uint64_t>> &rows) {
+  TestHost::EnsureFolderExists(output_dir_);
+  const std::string path = output_dir_ + "\\" + name + ".txt";
+  FILE *f = fopen(path.c_str(), "w");
+  if (!f) {
+    PrintMsg("Signal timing: cannot write %s\n", path.c_str());
+    return;
+  }
+  fprintf(f, "# hakuX #462 signal timing: %s\n", name.c_str());
+  fprintf(f, "freq_hz %llu\n", static_cast<unsigned long long>(KeQueryPerformanceFrequency()));
+  fputs(summary.c_str(), f);
+  fprintf(f, "# raw, counter ticks unless named\n");
+  for (size_t i = 0; i < columns.size(); ++i) {
+    fprintf(f, "%s%s", i ? "\t" : "", columns[i].c_str());
+  }
+  fputc('\n', f);
+  for (const auto &row : rows) {
+    for (size_t i = 0; i < row.size(); ++i) {
+      fprintf(f, "%s%llu", i ? "\t" : "", static_cast<unsigned long long>(row[i]));
+    }
+    fputc('\n', f);
+  }
+  fclose(f);
+}
+
+void SignalTimingTests::Finish(const std::string &name, const std::string &line) {
+  host_.PrepareDraw(0xFF202020);
+  pb_printat(0, 0, "%s\n%s", name.c_str(), line.c_str());
+  pb_draw_text_screen();
+  FinishDraw(name);
+}
