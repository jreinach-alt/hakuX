+SignalTimingTests::SignalTimingTests(TestHost &host, std::string output_dir, const Config &config)
+    : TestSuite(host, std::move(output_dir), kSuiteName, config) {
+  tests_[kCalibrate] = [this]() { TestCalibrate(kCalibrate); };
+  tests_[kVBlankSpin] = [this]() { TestVBlankSpin(kVBlankSpin); };
+  tests_[kVBlankEvent] = [this]() { TestVBlankEvent(kVBlankEvent); };
+  tests_[kDoneTiny] = [this]() { TestDone(kDoneTiny, 1, false, false); };
+  tests_[kDoneDOA] = [this]() { TestDone(kDoneDOA, kDOAQuads, true, false); };
+  tests_[kDoneDOARead] = [this]() { TestDone(kDoneDOARead, kDOAQuads, true, true); };
+  tests_[kFlip] = [this]() { TestFlip(kFlip); };
+  tests_[kCB1] = [this]() { TestCallback(kCB1, 0, false, 1); };
+  tests_[kCB2] = [this]() { TestCallback(kCB2, kDOAQuads, true, 1); };
+  tests_[kCB3] = [this]() { TestCallback(kCB3, kDOAQuads, true, 15); };
+}
+
+void SignalTimingTests::Initialize() {
+  TestSuite::Initialize();
+
+  // Uncached, as gpu_m2m.cpp's notifier: every CPU poll reads DRAM, never a stale line.
+  semaphore_page_ = static_cast<uint8_t *>(
+      MmAllocateContiguousMemoryEx(4096, 0, MAXRAM, 0, PAGE_READWRITE | PAGE_NOCACHE));
+  notifier_page_ = static_cast<uint8_t *>(
+      MmAllocateContiguousMemoryEx(4096, 0, MAXRAM, 0, PAGE_READWRITE | PAGE_NOCACHE));
+  target_ = static_cast<uint8_t *>(MmAllocateContiguousMemoryEx(kTargetPitch * kTarget, 0, MAXRAM, 0x1000,
+                                                                PAGE_WRITECOMBINE | PAGE_READWRITE));
+  ASSERT(semaphore_page_ && notifier_page_ && target_ && "Failed to allocate signal timing memory");
+  memset(semaphore_page_, 0, 32);
+  memset(notifier_page_, 0xFF, 32);
+
+  auto channel = kNextContextChannel;
+  pb_create_dma_ctx(channel++, DMA_CLASS_3D, reinterpret_cast<DWORD>(semaphore_page_), 0x1F, &semaphore_ctx_);
+  pb_create_dma_ctx(channel++, DMA_CLASS_3D, reinterpret_cast<DWORD>(notifier_page_), 0x1F, &notifier_ctx_);
+  pb_create_dma_ctx(channel++, DMA_CLASS_3D, 0, MAXRAM, &target_ctx_);
+  pb_bind_channel(&semaphore_ctx_);
+  pb_bind_channel(&notifier_ctx_);
+  pb_bind_channel(&target_ctx_);
+  pb_set_dma_address(&target_ctx_, target_, kTargetPitch * kTarget - 1);
+
+  Pushbuffer::Begin();
+  Pushbuffer::Push(NV097_SET_CONTEXT_DMA_SEMAPHORE, semaphore_ctx_.ChannelID);
+  Pushbuffer::Push(NV097_SET_CONTEXT_DMA_NOTIFIES, notifier_ctx_.ChannelID);
+  Pushbuffer::Push(NV097_SET_ALPHA_TEST_ENABLE, false);
+  Pushbuffer::Push(NV097_SET_CULL_FACE_ENABLE, false);
+  Pushbuffer::End();
+
+  auto shader = std::make_shared<PassthroughVertexShader>();
+  host_.SetVertexShaderProgram(shader);
+}
+
+void SignalTimingTests::Deinitialize() {
+  Pushbuffer::Begin();
+  Pushbuffer::Push(NV097_SET_CONTEXT_DMA_SEMAPHORE, kPbkitSemaphore);
+  Pushbuffer::Push(NV097_SET_CONTEXT_DMA_NOTIFIES, kPbkitNotifies);
+  Pushbuffer::Push(NV097_NO_OPERATION, 0);
+  Pushbuffer::Push(NV097_WAIT_FOR_IDLE, 0);
+  Pushbuffer::End();
+  uint64_t when;
+  WaitFor([]() { return !pb_busy(); }, KeQueryPerformanceFrequency(), &when);
+
+  if (semaphore_page_) {
+    MmFreeContiguousMemory(semaphore_page_);
+    semaphore_page_ = nullptr;
+  }
+  if (notifier_page_) {
+    MmFreeContiguousMemory(notifier_page_);
+    notifier_page_ = nullptr;
+  }
+  if (target_) {
+    MmFreeContiguousMemory(target_);
+    target_ = nullptr;
+  }
+  TestSuite::Deinitialize();
+}
