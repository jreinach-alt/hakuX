+#include "shaders/passthrough_vertex_shader.h"
+#include "test_host.h"
+
+#define SET_MASK(mask, val) (((val) << (__builtin_ffs(mask) - 1)) & (mask))
+
+static constexpr char kSuiteName[] = "Signal timing";
+
+static constexpr char kCalibrate[] = "ST_Calibrate";
+static constexpr char kVBlankSpin[] = "ST_VBlank_Spin";
+static constexpr char kVBlankEvent[] = "ST_VBlank_Event";
+static constexpr char kDoneTiny[] = "ST_Done_Tiny";
+static constexpr char kDoneDOA[] = "ST_Done_DOA";
+static constexpr char kDoneDOARead[] = "ST_Done_DOA_Read";
+static constexpr char kFlip[] = "ST_Flip";
+static constexpr char kCB1[] = "ST_CB_1_Empty";
+static constexpr char kCB2[] = "ST_CB_2_DOA";
+static constexpr char kCB3[] = "ST_CB_3_DOA15";
+
+static constexpr int kVBlanks = 301;  // 300 intervals
+static constexpr int kReps = 300;
+static constexpr int kDOAQuads = 500;
+static constexpr uint32_t kTarget = 256;  // the render target, square, A8R8G8B8, linear
+static constexpr uint32_t kTargetPitch = kTarget * 4;
+
+// NV097 method 0x104 (NOTIFY): the notification is written when the next method (NO_OPERATION) completes.
+// Type 0 is WRITE_ONLY: no NOTIFY interrupt is raised.
+static constexpr uint32_t kNV097Notify = 0x00000104;
+static constexpr uint32_t kNotifyWriteOnly = 0;
+static constexpr uint32_t kArmed = 0xFFFFFFFF;
+
+// pbkit's own context DMA handles for the 3D object (pb_init): notifies 2, semaphore 8, color 9.
+static constexpr uint32_t kPbkitNotifies = 2;
+static constexpr uint32_t kPbkitSemaphore = 8;
+static constexpr uint32_t kPbkitColor = 9;
+
+// NV_PCRTC_START, read only: pbkit's vblank ISR writes the next back buffer's address here.
+static volatile uint32_t *const kPCRTCStart = reinterpret_cast<volatile uint32_t *>(0xFD600800);
+
+static volatile uint32_t g_sink;
+
+static inline uint64_t Now() { return KeQueryPerformanceCounter(); }
+
+static inline uint64_t Tsc() {
+  uint32_t lo, hi;
+  __asm__ __volatile__("rdtsc" : "=a"(lo), "=d"(hi));
+  return (static_cast<uint64_t>(hi) << 32) | lo;
+}
+
+//! Spins until done() or timeout_ticks pass. On success, *when is the counter at the first poll that saw done().
+template <typename F>
+static bool WaitFor(F done, uint64_t timeout_ticks, uint64_t *when) {
+  const uint64_t start = Now();
+  for (;;) {
+    if (done()) {
+      *when = Now();
+      return true;
+    }
+    if (Now() - start > timeout_ticks) {
+      return false;
+    }
+  }
+}
+
+static std::string Describe(const char *label, std::vector<double> us) {
+  char buf[256];
+  if (us.empty()) {
+    snprintf(buf, sizeof(buf), "%s n=0\n", label);
+    return buf;
+  }
+  std::sort(us.begin(), us.end());
+  auto at = [&us](double p) { return us[static_cast<size_t>(p * static_cast<double>(us.size() - 1) + 0.5)]; };
+  snprintf(buf, sizeof(buf), "%s n=%u median=%.3f p5=%.3f p95=%.3f min=%.3f max=%.3f us\n", label,
+           static_cast<unsigned>(us.size()), at(0.5), at(0.05), at(0.95), us.front(), us.back());
+  return buf;
+}
+
+static double Us(uint64_t ticks, uint64_t freq) {
+  return static_cast<double>(ticks) * 1e6 / static_cast<double>(freq);
+}
