+#ifndef NXDK_PGRAPH_TESTS_SIGNAL_TIMING_TESTS_H
+#define NXDK_PGRAPH_TESTS_SIGNAL_TIMING_TESTS_H
+
+#include <pbkit/pbkit.h>
+#include <pbkit/pbkit_dma.h>
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "test_suite.h"
+
+class TestHost;
+
+/**
+ * hakuX #462 / #474: how soon the NV2A delivers the end-of-frame signals games wait for, timed from the CPU.
+ *
+ * Every time is KeQueryPerformanceCounter (the kernel's clock; KeQueryPerformanceFrequency gives its rate), and every
+ * wait is bounded. Each test writes <name>.txt beside its capture: a summary, then every raw sample in counter ticks.
+ *
+ *   ST_Calibrate     the counter against the kernel interrupt time, rdtsc and the vblank count, over ~2 s.
+ *   ST_VBlank_Spin   301 vblanks seen by spinning on pb_get_vbl_counter() (incremented in pbkit's vblank DPC).
+ *   ST_VBlank_Event  301 vblanks seen by waking from pb_wait_for_vbl() (the event pbkit pulses in that DPC).
+ *   ST_Done_Tiny     300 x: one quad, then a semaphore release and a NOTIFY (write only, no interrupt); the time from
+ *                    the last kick until each is visible to the CPU.
+ *   ST_Done_DOA      the same after 500 quads with one render-target switch (250 to a 256x256 target, 250 to the
+ *                    back buffer).
+ *   ST_Done_DOA_Read the same, then the CPU reads the whole back buffer.
+ *   ST_Flip          300 x: pb_finished(), then the vblank ISR's write of NV_PCRTC_START (a read-only poll) and the
+ *                    vblank DPC's counter increment.
+ *   ST_CB_1_Empty    300 x: a push-buffer callback (NV097_NO_OPERATION with PB_TIMESTAMP, which raises the PGRAPH
+ *                    ERROR interrupt and stalls the puller until pbkit's handler clears it), then a semaphore release.
+ *                    Needs the private pbkit whose DPC records when it handled the callback (pb_callback_time[]).
+ *   ST_CB_2_DOA      the same after 500 quads with one render-target switch.
+ *   ST_CB_3_DOA15    the 500-quad frame with 15 callbacks interleaved (Blinx takes 14.66 a frame).
+ *
+ * pbkit and pushbuffer methods only. The one MMIO access added is a READ of NV_PCRTC_START. The semaphore and notifier
+ * contexts are pbkit DMA objects over this suite's own uncached pages (as gpu_m2m.cpp does), and pbkit's own bindings
+ * (semaphore 8, notifies 2) are restored in Deinitialize.
+ */
+class SignalTimingTests : public TestSuite {
+ public:
+  SignalTimingTests(TestHost &host, std::string output_dir, const Config &config);
+
+  void Initialize() override;
+  void Deinitialize() override;
+
+ private:
+  void TestCalibrate(const std::string &name);
+  void TestVBlankSpin(const std::string &name);
+  void TestVBlankEvent(const std::string &name);
+  void TestDone(const std::string &name, int quads, bool target_switch, bool readback);
+  void TestFlip(const std::string &name);
+  void TestCallback(const std::string &name, int quads, bool target_switch, int callbacks);
+
+  void SetupDraw();
+  void Quads(int count, float left, float top, float size, float r, float g, float b);
+  void ToTarget();
+  void ToBackBuffer();
+  void Finish(const std::string &name, const std::string &line);
+  void Write(const std::string &name, const std::string &summary, const std::vector<std::string> &columns,
+             const std::vector<std::vector<uint64_t>> &rows);
+
+  struct s_CtxDma semaphore_ctx_ {};
+  struct s_CtxDma notifier_ctx_ {};
+  struct s_CtxDma target_ctx_ {};
+  uint8_t *semaphore_page_{nullptr};
+  uint8_t *notifier_page_{nullptr};
+  uint8_t *target_{nullptr};
+  uint32_t semaphore_value_{0};
+  bool vblank_ok_{false};
+};
+
+#endif  // NXDK_PGRAPH_TESTS_SIGNAL_TIMING_TESTS_H
