+void SignalTimingTests::TestCalibrate(const std::string &name) {
+  const uint64_t f = KeQueryPerformanceFrequency();
+  const DWORD v0 = pb_get_vbl_counter();
+  const uint64_t q0 = Now(), t0 = Tsc(), i0 = KeQueryInterruptTime();
+  while (Now() - q0 < 2 * f) {
+  }
+  const uint64_t q1 = Now(), t1 = Tsc(), i1 = KeQueryInterruptTime();
+  const DWORD v1 = pb_get_vbl_counter();
+
+  const double s_qpc = static_cast<double>(q1 - q0) / static_cast<double>(f);
+  const double s_int = static_cast<double>(i1 - i0) / 1e7;
+  char buf[512];
+  snprintf(buf, sizeof(buf),
+           "counter_s %.6f\ninterrupt_time_s %.6f\ncounter_over_interrupt %.6f\ntsc_mhz %.3f\nvblanks %u\n"
+           "vblank_hz %.4f\n",
+           s_qpc, s_int, s_int > 0 ? s_qpc / s_int : 0.0, static_cast<double>(t1 - t0) / s_qpc / 1e6,
+           static_cast<unsigned>(v1 - v0), static_cast<double>(v1 - v0) / s_qpc);
+  Write(name, buf, {"q0", "q1", "tsc0", "tsc1", "int0_100ns", "int1_100ns", "vbl0", "vbl1"},
+        {{q0, q1, t0, t1, i0, i1, v0, v1}});
+  Finish(name, buf);
+}
+
+void SignalTimingTests::TestVBlankSpin(const std::string &name) {
+  const uint64_t f = KeQueryPerformanceFrequency();
+  const uint64_t timeout = f / 10;  // 100 ms, six vblanks
+  std::vector<std::vector<uint64_t>> rows;
+  std::vector<double> intervals;
+  unsigned timeouts = 0, skipped = 0;
+  uint64_t when, prev_when = 0;
+  DWORD last = pb_get_vbl_counter();
+  if (!WaitFor([&last]() { return pb_get_vbl_counter() != last; }, timeout, &when)) {
+    ++timeouts;
+  }
+  last = pb_get_vbl_counter();
+  DWORD prev_count = 0;
+  while (rows.size() < static_cast<size_t>(kVBlanks) && timeouts < 5) {
+    if (!WaitFor([&last]() { return pb_get_vbl_counter() != last; }, timeout, &when)) {
+      ++timeouts;
+      continue;
+    }
+    const DWORD count = pb_get_vbl_counter();
+    if (!rows.empty()) {
+      if (count - prev_count == 1) {
+        intervals.push_back(Us(when - prev_when, f));
+      } else {
+        ++skipped;  // a vblank was not seen (the thread was preempted); that interval spans more than one
+      }
+    }
+    rows.push_back({when, count});
+    prev_when = when;
+    prev_count = count;
+    last = count;
+  }
+  vblank_ok_ = timeouts == 0 && rows.size() == static_cast<size_t>(kVBlanks);
+
+  char buf[160];
+  snprintf(buf, sizeof(buf), "timeouts %u\nintervals_spanning_a_missed_vblank %u\n", timeouts, skipped);
+  const std::string summary = std::string(buf) + Describe("interval", intervals);
+  Write(name, summary, {"seen", "vbl_count"}, rows);
+  Finish(name, summary);
+}
+
+void SignalTimingTests::TestVBlankEvent(const std::string &name) {
+  const uint64_t f = KeQueryPerformanceFrequency();
+  // pb_wait_for_vbl() has no timeout, so it runs only after three vblanks have been seen to arrive by spinning, each
+  // within 100 ms. The guard is here, not in ST_VBlank_Spin: the suite runs its tests in name order, so this test
+  // runs first.
+  {
+    uint64_t when;
+    DWORD last = pb_get_vbl_counter();
+    for (int i = 0; i < 3; ++i) {
+      if (!WaitFor([&last]() { return pb_get_vbl_counter() != last; }, f / 10, &when)) {
+        const std::string summary = "skipped: a vblank did not arrive within 100 ms in the guard\n";
+        Write(name, summary, {}, {});
+        Finish(name, summary);
+        return;
+      }
+      last = pb_get_vbl_counter();
+    }
+  }
+  std::vector<std::vector<uint64_t>> rows;
+  std::vector<double> intervals;
+  unsigned skipped = 0;
+  pb_wait_for_vbl();
+  for (int i = 0; i < kVBlanks; ++i) {
+    const DWORD count = pb_wait_for_vbl();
+    const uint64_t when = Now();
+    if (!rows.empty()) {
+      if (count - static_cast<DWORD>(rows.back()[1]) == 1) {
+        intervals.push_back(Us(when - rows.back()[0], f));
+      } else {
+        ++skipped;
+      }
+    }
+    rows.push_back({when, count});
+  }
+  char buf[160];
+  snprintf(buf, sizeof(buf), "intervals_spanning_a_missed_vblank %u\n", skipped);
+  const std::string summary = std::string(buf) + Describe("interval", intervals);
+  Write(name, summary, {"woke", "vbl_count"}, rows);
+  Finish(name, summary);
+}
+
+void SignalTimingTests::TestDone(const std::string &name, int quads, bool target_switch, bool readback) {
+  const uint64_t f = KeQueryPerformanceFrequency();
+  const uint64_t timeout = f / 4;  // 250 ms
+  auto sem = reinterpret_cast<volatile uint32_t *>(semaphore_page_);
+  auto ntf = reinterpret_cast<volatile uint32_t *>(notifier_page_);
+
+  SetupDraw();
+  host_.PrepareDraw(0xFF101010);
+
+  std::vector<std::vector<uint64_t>> rows;
+  std::vector<double> kick_to_sem, kick_to_ntf, submit, read;
+  unsigned sem_timeouts = 0, ntf_timeouts = 0, busy_timeouts = 0;
+  for (int rep = 0; rep < kReps; ++rep) {
+    uint64_t when;
+    // Start each repetition from an idle GPU, so the time measured is this repetition's.
+    if (!WaitFor([]() { return !pb_busy(); }, timeout, &when)) {
+      ++busy_timeouts;
+      break;
+    }
+    for (int i = 0; i < 8; ++i) {
+      ntf[i] = kArmed;
+    }
+    const uint32_t value = ++semaphore_value_;
+
+    const uint64_t s0 = Now();
+    if (target_switch) {
+      ToTarget();
+      Quads(quads / 2, 0.f, 0.f, 16.f, 0.2f, 0.4f, 0.8f);
+      ToBackBuffer();
+      Quads(quads - quads / 2, 64.f, 64.f, 16.f, 0.8f, 0.4f, 0.2f);
+    } else {
+      Quads(quads, 64.f, 64.f, 16.f, 0.8f, 0.4f, 0.2f);
+    }
+    Pushbuffer::Begin();
+    Pushbuffer::Push(NV097_SET_SEMAPHORE_OFFSET, 0);
+    Pushbuffer::Push(NV097_BACK_END_WRITE_SEMAPHORE_RELEASE, value);
+    Pushbuffer::Push(kNV097Notify, kNotifyWriteOnly);
+    Pushbuffer::Push(NV097_NO_OPERATION, 0);
+    Pushbuffer::End();  // pb_end kicks the GPU
+    const uint64_t kick = Now();
+
+    uint64_t t_sem = 0, t_ntf = 0;
+    uint32_t slot = 9;
+    while ((!t_sem || !t_ntf) && Now() - kick < timeout) {
+      if (!t_sem && *sem == value) {
+        t_sem = Now();
+      }
+      if (!t_ntf && (ntf[3] != kArmed || ntf[7] != kArmed)) {
+        t_ntf = Now();
+        slot = ntf[3] != kArmed ? 0 : 1;
+      }
+    }
+    uint64_t t_read = 0;
+    if (readback && t_sem) {
+      const auto fb = reinterpret_cast<volatile uint32_t *>(pb_back_buffer());
+      const uint32_t pitch_words = pb_back_buffer_pitch() / 4;
+      const uint32_t w = pb_back_buffer_width(), h = pb_back_buffer_height();
+      const uint64_t r0 = Now();
+      uint32_t sum = 0;
+      for (uint32_t y = 0; y < h; ++y) {
+        for (uint32_t x = 0; x < w; ++x) {
+          sum += fb[y * pitch_words + x];
+        }
+      }
+      g_sink = sum;
+      t_read = Now() - r0;
+      read.push_back(Us(t_read, f));
+    }
+
+    submit.push_back(Us(kick - s0, f));
+    if (t_sem) {
+      kick_to_sem.push_back(Us(t_sem - kick, f));
+    } else {
+      ++sem_timeouts;
+    }
+    if (t_ntf) {
+      kick_to_ntf.push_back(Us(t_ntf - kick, f));
+    } else {
+      ++ntf_timeouts;
+    }
+    rows.push_back({s0, kick, t_sem, t_ntf, slot, ntf[0], ntf[1], ntf[4], ntf[5], t_read});
+    if (sem_timeouts >= 3 && ntf_timeouts >= 3 && !t_sem && !t_ntf) {
+      break;  // neither signal is arriving: stop here rather than spend 300 timeouts
+    }
+  }
+
+  char buf[256];
+  snprintf(buf, sizeof(buf),
+           "quads %d\ntarget_switch %d\nreadback %d\nreps %u\nsemaphore_timeouts %u\nnotify_timeouts %u\n"
+           "busy_timeouts %u\n",
+           quads, target_switch ? 1 : 0, readback ? 1 : 0, static_cast<unsigned>(rows.size()), sem_timeouts,
+           ntf_timeouts, busy_timeouts);
+  std::string summary = buf;
+  summary += Describe("submit(first_draw_to_kick)", submit);
+  summary += Describe("kick_to_semaphore", kick_to_sem);
+  summary += Describe("kick_to_notify", kick_to_ntf);
+  if (readback) {
+    summary += Describe("cpu_read_back_buffer", read);
+  }
+  Write(name, summary,
+        {"start", "kick", "semaphore_seen", "notify_seen", "notify_slot", "ntf0_ts_lo", "ntf0_ts_hi", "ntf1_ts_lo",
+         "ntf1_ts_hi", "read_ticks"},
+        rows);
+  Finish(name, summary);
+}
+
+void SignalTimingTests::TestFlip(const std::string &name) {
+  const uint64_t f = KeQueryPerformanceFrequency();
+  const uint64_t timeout = f / 5;  // 200 ms, twelve vblanks
+  SetupDraw();
+
+  std::vector<std::vector<uint64_t>> rows;
+  std::vector<double> to_start, to_count, isr_to_dpc;
+  unsigned start_timeouts = 0, count_timeouts = 0, queue_timeouts = 0;
+  for (int rep = 0; rep < kReps; ++rep) {
+    uint64_t when;
+    host_.PrepareDraw(rep & 1 ? 0xFF303030 : 0xFF404040);
+    const uint32_t start0 = *kPCRTCStart;
+    if (!WaitFor([]() { return pb_finished() == 0; }, timeout, &when)) {
+      ++queue_timeouts;
+      break;
+    }
+    const uint64_t req = Now();
+    const DWORD count0 = pb_get_vbl_counter();
+
+    uint64_t t_start = 0, t_count = 0;
+    if (WaitFor([start0]() { return *kPCRTCStart != start0; }, timeout, &when)) {
+      t_start = when;
+      to_start.push_back(Us(t_start - req, f));
+      const DWORD count_at_start = pb_get_vbl_counter();
+      if (WaitFor([count_at_start]() { return pb_get_vbl_counter() != count_at_start; }, timeout, &when)) {
+        t_count = when;
+        to_count.push_back(Us(t_count - req, f));
+        isr_to_dpc.push_back(Us(t_count - t_start, f));
+      } else {
+        ++count_timeouts;
+      }
+    } else {
+      ++start_timeouts;
+    }
+    rows.push_back({req, t_start, t_count, count0, pb_get_vbl_counter(), start0, *kPCRTCStart});
+    if (start_timeouts >= 3 && !t_start) {
+      break;
+    }
+  }
+
+  char buf[160];
+  snprintf(buf, sizeof(buf), "reps %u\nstart_timeouts %u\ncount_timeouts %u\nqueue_timeouts %u\n",
+           static_cast<unsigned>(rows.size()), start_timeouts, count_timeouts, queue_timeouts);
+  std::string summary = buf;
+  summary += Describe("request_to_pcrtc_start", to_start);
+  summary += Describe("request_to_vbl_count", to_count);
+  summary += Describe("pcrtc_start_to_vbl_count", isr_to_dpc);
+  Write(name, summary, {"request", "start_seen", "count_seen", "vbl_at_request", "vbl_after", "start_before",
+                        "start_after"},
+        rows);
+  Finish(name, summary);
+}
+
+// A push-buffer callback: NV097_NO_OPERATION with a non-zero parameter raises the PGRAPH ERROR interrupt when the
+// puller reaches it, and the puller stalls until pbkit's handler clears it. PB_TIMESTAMP makes this build's pbkit DPC
+// store when it handled the callback (pb_callback_time[], RAM only). A semaphore release after the last callback shows
+// when the puller resumed. Each kick time is taken just BEFORE the kick, so no callback can precede its own kick.
+void SignalTimingTests::TestCallback(const std::string &name, int quads, bool target_switch, int callbacks) {
+  const uint64_t f = KeQueryPerformanceFrequency();
+  const uint64_t timeout = f / 4;  // 250 ms
+  auto sem = reinterpret_cast<volatile uint32_t *>(semaphore_page_);
+
+  SetupDraw();
+  host_.PrepareDraw(0xFF101010);
+
+  std::vector<std::string> columns = {"start", "final_kick", "semaphore_seen", "callbacks_seen"};
+  for (int c = 0; c < callbacks; ++c) {
+    columns.push_back("kick_" + std::to_string(c));
+    columns.push_back("dpc_" + std::to_string(c));
+  }
+  std::vector<std::vector<uint64_t>> rows;
+  std::vector<double> kick_to_cb, cb_gap, cb_to_sem, kick_to_sem, frame;
+  unsigned timeouts = 0, busy_timeouts = 0, stale = 0;
+  uint64_t last_cb = 0;
+  const int per = callbacks > 0 ? quads / callbacks : quads;
+  for (int rep = 0; rep < kReps; ++rep) {
+    uint64_t when;
+    if (!WaitFor([]() { return !pb_busy(); }, timeout, &when)) {
+      ++busy_timeouts;
+      break;
+    }
+    const DWORD seq0 = pb_callback_seq;
+    const uint32_t value = ++semaphore_value_;
+    std::vector<uint64_t> kicks;
+
+    const uint64_t s0 = Now();
+    int remaining = quads;
+    bool switched = !target_switch;
+    if (target_switch) {
+      ToTarget();
+    }
+    for (int c = 0; c < callbacks; ++c) {
+      int chunk = (c == callbacks - 1) ? remaining : per;
+      while (chunk > 0) {
+        const int done = quads - remaining;
+        int take = chunk;
+        if (!switched && done + take > quads / 2) {
+          take = quads / 2 - done;
+        }
+        if (take > 0) {
+          Quads(take, 0.f, 0.f, 16.f, 0.2f, 0.6f, 0.4f);
+          remaining -= take;
+          chunk -= take;
+        }
+        if (!switched && quads - remaining >= quads / 2) {
+          ToBackBuffer();
+          switched = true;
+        }
+      }
+      Pushbuffer::Begin();
+      Pushbuffer::Push(NV097_NO_OPERATION, PB_TIMESTAMP);
+      kicks.push_back(Now());
+      Pushbuffer::End();
+    }
+    Pushbuffer::Begin();
+    Pushbuffer::Push(NV097_SET_SEMAPHORE_OFFSET, 0);
+    Pushbuffer::Push(NV097_BACK_END_WRITE_SEMAPHORE_RELEASE, value);
+    const uint64_t kick = Now();
+    Pushbuffer::End();
+
+    uint64_t t_sem = 0;
+    while (Now() - kick < timeout) {
+      if (!t_sem && *sem == value) {
+        t_sem = Now();
+      }
+      if (t_sem && pb_callback_seq - seq0 >= static_cast<DWORD>(callbacks)) {
+        break;
+      }
+    }
+    const DWORD got = pb_callback_seq - seq0;
+    std::vector<uint64_t> row = {s0, kick, t_sem, got};
+    if (!t_sem || got < static_cast<DWORD>(callbacks)) {
+      ++timeouts;
+      row.resize(columns.size(), 0);
+      rows.push_back(row);
+      if (timeouts >= 3) {
+        break;  // the callbacks are not coming back: stop rather than spend 300 timeouts
+      }
+      continue;
+    }
+    uint64_t prev = 0;
+    for (int c = 0; c < callbacks; ++c) {
+      const uint64_t t_cb = pb_callback_time[(seq0 + c) & 63];
+      if (t_cb <= last_cb) {
+        ++stale;  // must move: every callback is handled after the one before it
+      }
+      last_cb = t_cb;
+      kick_to_cb.push_back(Us(t_cb - kicks[c], f));
+      if (c > 0) {
+        cb_gap.push_back(Us(t_cb - prev, f));
+      }
+      prev = t_cb;
+      row.push_back(kicks[c]);
+      row.push_back(t_cb);
+    }
+    cb_to_sem.push_back(Us(t_sem - prev, f));
+    kick_to_sem.push_back(Us(t_sem - kick, f));
+    frame.push_back(Us(t_sem - s0, f));
+    rows.push_back(row);
+  }
+
+  char buf[256];
+  snprintf(buf, sizeof(buf),
+           "quads %d\ntarget_switch %d\ncallbacks_per_frame %d\nreps %u\ntimeouts %u\nbusy_timeouts %u\n"
+           "stale_callback_times %u\n",
+           quads, target_switch ? 1 : 0, callbacks, static_cast<unsigned>(rows.size()), timeouts, busy_timeouts,
+           stale);
+  std::string summary = buf;
+  summary += Describe("kick_to_callback_handled", kick_to_cb);
+  if (callbacks > 1) {
+    summary += Describe("callback_to_next_callback", cb_gap);
+  }
+  summary += Describe("last_callback_handled_to_semaphore_seen", cb_to_sem);
+  summary += Describe("final_kick_to_semaphore", kick_to_sem);
+  summary += Describe("frame(first_draw_to_semaphore)", frame);
+  Write(name, summary, columns, rows);
+  Finish(name, summary);
+}
