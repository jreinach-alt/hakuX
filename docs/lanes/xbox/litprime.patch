+#ifndef NXDK_PGRAPH_TESTS_LIGHTING_PRIMING_TESTS_H
+#define NXDK_PGRAPH_TESTS_LIGHTING_PRIMING_TESTS_H
+
+#include <string>
+
+#include "test_suite.h"
+
+class TestHost;
+
+namespace PBKitPlusPlus {}
+using namespace PBKitPlusPlus;
+
+/**
+ * hakuX #53: does a vertex program with LIGHTING_ENABLE read the fixed function lighting results of the
+ * preceding fixed function draw's final vertices, rather than its own?
+ *
+ * A priming test draws two lit fixed function quads whose eight vertices carry eight distinct N.L values.
+ * The test after it draws six lit quads under a vertex program, with a normal no priming vertex carries,
+ * either as six draws or as one.
+ */
+class LightingPrimingTests : public TestSuite {
+ public:
+  LightingPrimingTests(TestHost& host, std::string output_dir, const Config& config);
+
+  void Initialize() override;
+
+ private:
+  void TestPriming(const std::string& name);
+  void TestLitShader(const std::string& name, bool single_draw);
+  void SetupLight();
+};
+
+#endif  // NXDK_PGRAPH_TESTS_LIGHTING_PRIMING_TESTS_H
