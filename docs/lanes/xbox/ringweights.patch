+#ifndef NXDK_PGRAPH_TESTS_RING_WEIGHT_TESTS_H
+#define NXDK_PGRAPH_TESTS_RING_WEIGHT_TESTS_H
+
+#include <string>
+
+#include "test_suite.h"
+
+class TestHost;
+
+namespace PBKitPlusPlus {}
+using namespace PBKitPlusPlus;
+
+/**
+ * hakuX #53 (lane.ring53 NOTES s6): how far does each pushbuffer method advance the six-slot ring a lit vertex
+ * program reads the fixed function lighting results from?
+ *
+ * Every measurement is a priming test (two lit fixed function quads, eight distinct N.L, as the Lighting priming
+ * suite) followed by a lit vertex-program test of six single-quad draws. A draw's four corners name four consecutive
+ * ring entries, so each draw's window start reads directly, and a method's weight is the step between draws minus 4.
+ */
+class RingWeightTests : public TestSuite {
+ public:
+  enum class Extra { kNone, kNop, kIcw, kSpecSame, kSpecToggle, kLightControl, kFill, kXformConst, kBeginEnd, kBackWrites };
+
+  RingWeightTests(TestHost& host, std::string output_dir, const Config& config);
+
+  void Initialize() override;
+
+ private:
+  void TestPriming(const std::string& name, bool label);
+  void TestShader(const std::string& name, Extra extra, int pre_fills, bool back_face, bool back_attrs, bool label);
+  void SetupLight();
+  void ResetFaces();
+  void DoExtra(Extra extra, int k);
+  void Finish(const std::string& name, bool label);
+};
+
+#endif  // NXDK_PGRAPH_TESTS_RING_WEIGHT_TESTS_H
