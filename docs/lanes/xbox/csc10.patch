+#ifndef NXDK_PGRAPH_TESTS_COLOR_SPACE_CONVERSION_TESTS_H
+#define NXDK_PGRAPH_TESTS_COLOR_SPACE_CONVERSION_TESTS_H
+
+#include <string>
+
+#include "test_suite.h"
+
+class TestHost;
+
+/**
+ * hakuX #10: what NV097_SET_CONTROL0's COLOR_SPACE_CONVERT field (CRYCB_TO_RGB) does to texture samples.
+ *
+ * The harness sets the field only when stage 0 holds a YUV texture (NV2AState::SetupControl0), and the Bump map /
+ * Bump env lum goldens show stage 1's A8R8G8B8 texels converted while it is set. Every test here forces the field on
+ * or off explicitly after PrepareDraw, so the same textures are seen both ways:
+ *
+ *   Palette   one stage, 256 designed A8R8G8B8 texels (16 x 16 cells): the converter applied to RGB data.
+ *   Stages    four stages, each a mirrored copy of the palette; the final combiner selects TEX0, TEX1 or TEX3.
+ *   YUY2/UYVY designed raw bytes (32 cells): which byte lands in which channel with the field off.
+ *   BumpS/T   a uniform A8R8G8B8 bump source and a ramp in stage 1, drawn once without and once with BUMPENVMAP
+ *             (one matrix word per axis): the displacement read from the ramp says whether the offsets come from
+ *             raw or converted bytes.
+ *   Lum       BUMPENVMAP_LUMINANCE with a zero matrix over the palette: the luminance source, and the order of the
+ *             luminance multiply against the conversion.
+ *
+ * Blending, culling and the alpha test are off, and every stage samples nearest, so each cell reads back exactly.
+ */
+class ColorSpaceConversionTests : public TestSuite {
+ public:
+  ColorSpaceConversionTests(TestHost &host, std::string output_dir, const Config &config);
+
+  void Initialize() override;
+
+ private:
+  void TestPalette(const std::string &name, bool csc);
+  void TestStages(const std::string &name, int output_stage, bool csc);
+  void TestYUV(const std::string &name, bool uyvy, bool csc);
+  void TestBump(const std::string &name, bool vertical, bool csc);
+  void TestLum(const std::string &name, bool csc);
+
+  void CommonSetup(int enabled_stages);
+  void UploadPalette(int stage, int variant);
+  void UploadUniform(int stage, uint32_t argb);
+  void DrawQuad(float left, float top, float right, float bottom, float s0, float t0, float s1, float t1);
+  void Finish(const std::string &name, bool csc);
+};
+
+#endif  // NXDK_PGRAPH_TESTS_COLOR_SPACE_CONVERSION_TESTS_H
