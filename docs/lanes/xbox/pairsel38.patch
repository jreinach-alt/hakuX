@@ -0,0 +1,33 @@
+#ifndef NXDK_PGRAPH_TESTS_PAIR_SELECTOR_TESTS_H
+#define NXDK_PGRAPH_TESTS_PAIR_SELECTOR_TESTS_H
+
+#include <string>
+
+#include "test_suite.h"
+
+class TestHost;
+
+/**
+ * hakuX #38, mechanism 2: which draws does silicon's even-aligned pixel-pair colour quantisation select?
+ *
+ * The corpus leaves a two-way tie: immediate mode with w = 1, AND EITHER the primitive is >= 512 px wide OR its
+ * vertices arrive by SET_VERTEX4F. Every paired capture on disk is wide and 4F, every unpaired class member narrow
+ * and 3F (docs/investigations/issue38-mech2-blocker-audit.md).
+ *
+ * Every test here is Alpha func's AlphaFuncAlways_Disabled (the paired control on disk), with its three gradient
+ * bands drawn W px wide and centred, their vertices submitted by SET_VERTEX4F (as Alpha func does) or SET_VERTEX3F.
+ * The full-width white rectangle stays as Alpha func draws it. So PairSel_W512_V4F is Alpha func's image.
+ */
+class PairSelectorTests : public TestSuite {
+ public:
+  PairSelectorTests(TestHost &host, std::string output_dir, const Config &config);
+
+  void Initialize() override;
+
+ private:
+  void Test(const std::string &name, float width, bool vertex4f);
+  void Draw(float width, bool vertex4f, float red, float green, float blue, float left_alpha, float right_alpha,
+            float top, float bottom) const;
+};
+
+#endif  // NXDK_PGRAPH_TESTS_PAIR_SELECTOR_TESTS_H
