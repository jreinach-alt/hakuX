+def unproven(v, rdir=""):
+    """Why a PASS does not count toward Playable, or None (#433, lane.failgate,
+    2026-10-03). A pass whose scored window the verdict could not read (no
+    `static_window`, or measured False) is unproven, as is a pass whose result
+    dir holds an IDENTIFIED.json of class pass-unproven. Older verdicts carry
+    no static_window at all, so they read unproven until re-judged."""
+    if not v.get("pass"):
+        return None
+    sw = v.get("static_window")
+    if not isinstance(sw, dict) or not sw.get("measured"):
+        return "window unmeasured"
+    ident = _jload(os.path.join(rdir, "IDENTIFIED.json")) if rdir else None
+    if isinstance(ident, dict) and ident.get("class") == "pass-unproven":
+        return "pass-unproven"
+    return None
+
