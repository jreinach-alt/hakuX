+/*
+ * HAKUX_APU_HRTF_NORM (#938): how a 3D voice's HRIR is scaled (hrtf.h).
+ * Unset or "l1": divided by sum |c| per ear, as upstream and as today.
+ * "cap": divided only where sum |c| > 1. "raw": as the guest uploaded it.
+ * "off": no HRTF filter at all, the voice's mono samples to both ears, as
+ * [audio] hrtf = false gives, so an A/B leg needs no toml edit. Read once
+ * and said once in logcat, so a run shows the switch reached the APU.
+ */
+#define HRTF_NORM_OFF 3
+static int hrtf_norm(void)
+{
+    static int m = -1;
+    if (m < 0) {
+        const char *e = getenv("HAKUX_APU_HRTF_NORM");
+        m = !e || !strcmp(e, "l1") ? HRTF_NORM_L1 :
+            !strcmp(e, "cap")      ? HRTF_NORM_CAP :
+            !strcmp(e, "raw")      ? HRTF_NORM_RAW :
+            !strcmp(e, "off")      ? HRTF_NORM_OFF : HRTF_NORM_L1;
+        static const char *const name[] = { "l1", "cap", "raw", "off" };
+#ifdef __ANDROID__
+        __android_log_print(4, "hakuX-audio", "hrtf_norm: %s%s", name[m],
+                            e ? "" : " (default)");
+#else
+        fprintf(stderr, "hrtf_norm: %s%s\n", name[m], e ? "" : " (default)");
+#endif
+    }
+    return m;
+}
