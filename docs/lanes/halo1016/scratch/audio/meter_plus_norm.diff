-                              float itd)
+                              float itd, int norm)
 {
     f->itd_tar =
         fmaxf(-HRTF_MAX_DELAY_SAMPLES, fminf(itd, HRTF_MAX_DELAY_SAMPLES));
@@ -75,6 +85,9 @@
