+/*
+ * HAKUX_APU_METER=1 (#938; off by default): what each voice put into the
+ * MON_VP mix, and the raw scale of the HRIRs the guest binds to 3D voices.
+ *
+ * Every 7500 APU frames (5 s), one line under logcat tag hakuX-audio:
+ *
+ *   apumeter w=<window> 3d=<dBFS> 2d=<dBFS> top=<v>:<dBFS>,... pause=<v>:<n>,...
+ *
+ * 3d and 2d are the summed energy of voices 0-63 and 64-255 over the window
+ * as an RMS level (both channels, after gain, envelope and HRTF; voices are
+ * summed by energy, so two voices playing the same buffer count 3 dB, not
+ * 6). top is the eight voices with the most energy; pause the voices the
+ * guest sent a VOICE_PAUSE (pause, not resume) in the window, with counts.
+ * A voice's first SET_VOICE_TAR_HRTF in each window, and every 50th overall,
+ * also prints the HRIR it binds, before the normalisation in hrtf.h,
+ * coefficients as int8/128:
+ *
+ *   apuhrtf v=<voice> h=<entry> l1=<L>/<R> l2=<L>/<R> dc=<L>/<R> itd=<samples>
+ *
+ * l1 = sum |c| (what hrtf.h divides by), l2 = sqrt(sum c^2) (broadband
+ * gain for white input), dc = sum c (gain at low frequencies). With l1
+ * normalisation an ear's broadband gain is l2/l1 and its LF gain dc/l1.
+ */
+#ifdef __ANDROID__
+extern int __android_log_print(int prio, const char *tag, const char *fmt, ...);
+#define METER_PRINT(fmt, ...) \
+    __android_log_print(4, "hakuX-audio", fmt, ##__VA_ARGS__)
+#else
+#define METER_PRINT(fmt, ...) fprintf(stderr, fmt "\n", ##__VA_ARGS__)
+#endif
+#define METER_WINDOW_FRAMES 7500
+static int meter_on = -1;
+static double meter_e[MCPX_HW_MAX_VOICES];       /* worker-owned per voice */
+static uint32_t meter_pause[MCPX_HW_MAX_VOICES]; /* FE thread */
+static uint32_t meter_frames, meter_window, meter_hrtf_n;
+static bool meter_hrtf_seen[MCPX_HW_MAX_3D_VOICES]; /* FE thread */
+
+static bool meter_enabled(void)
+{
+    if (meter_on < 0) {
+        const char *e = getenv("HAKUX_APU_METER");
+        meter_on = e && e[0] == '1' && e[1] == '\0';
+        METER_PRINT("apu_meter: %s", meter_on ? "on" : "off");
+    }
+    return meter_on;
+}
+
+static double meter_db(double e)
+{
+    return e > 0.0 ? 10.0 * log10(e) : -200.0;
+}
+
+static void meter_hrtf_print(int v, int h, float hrir[2][HRTF_NUM_TAPS],
+                             float itd)
+{
+    float l1[2] = { 0 }, l2[2] = { 0 }, dc[2] = { 0 };
+    for (int ch = 0; ch < 2; ch++) {
+        for (int k = 0; k < HRTF_NUM_TAPS; k++) {
+            l1[ch] += fabsf(hrir[ch][k]);
+            l2[ch] += hrir[ch][k] * hrir[ch][k];
+            dc[ch] += hrir[ch][k];
+        }
+        l2[ch] = sqrtf(l2[ch]);
+    }
+    METER_PRINT("apuhrtf v=%d h=%d l1=%.3f/%.3f l2=%.3f/%.3f dc=%.3f/%.3f "
+                "itd=%.2f", v, h, l1[0], l1[1], l2[0], l2[1], dc[0], dc[1],
+                itd);
+}
+
+/* APU thread, after voice_work_dispatch: the workers are done with meter_e. */
+static void meter_frame(void)
+{
+    if (++meter_frames < METER_WINDOW_FRAMES) {
+        return;
+    }
+    const double n = (double)METER_WINDOW_FRAMES * NUM_SAMPLES_PER_FRAME * 2;
+    double e3 = 0.0, e2 = 0.0;
+    int top[8] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+    for (int v = 0; v < MCPX_HW_MAX_VOICES; v++) {
+        if (v < MCPX_HW_MAX_3D_VOICES) {
+            e3 += meter_e[v];
+        } else {
+            e2 += meter_e[v];
+        }
+        if (meter_e[v] <= 0.0) {
+            continue;
+        }
+        for (int i = 0; i < 8; i++) {
+            if (top[i] < 0 || meter_e[v] > meter_e[top[i]]) {
+                for (int j = 7; j > i; j--) {
+                    top[j] = top[j - 1];
+                }
+                top[i] = v;
+                break;
+            }
+        }
+    }
+    char tops[8 * 16], pauses[8 * 12];
+    int tl = 0, pl = 0, np = 0;
+    tops[0] = pauses[0] = '\0';
+    for (int i = 0; i < 8 && top[i] >= 0; i++) {
+        tl += snprintf(tops + tl, sizeof(tops) - tl, "%s%d:%.1f", i ? "," : "",
+                       top[i], meter_db(meter_e[top[i]] / n));
+    }
+    for (int v = 0; v < MCPX_HW_MAX_VOICES && np < 8; v++) {
+        if (meter_pause[v]) {
+            pl += snprintf(pauses + pl, sizeof(pauses) - pl, "%s%d:%u",
+                           np++ ? "," : "", v, meter_pause[v]);
+        }
+    }
+    METER_PRINT("apumeter w=%u 3d=%.1f 2d=%.1f top=%s pause=%s", meter_window,
+                meter_db(e3 / n), meter_db(e2 / n), tops, np ? pauses : "-");
+    memset(meter_e, 0, sizeof(meter_e));
+    memset(meter_pause, 0, sizeof(meter_pause));
+    memset(meter_hrtf_seen, 0, sizeof(meter_hrtf_seen));
+    meter_frames = 0;
+    meter_window++;
+}
