    axis LY min
    wait 2
    press A
    axis LX max
    wait 1
    press X
    axis LX mid
    axis LY max
    wait 2
    press A
    axis LX min
    wait 1
    press X
    axis LX mid
    axis LY mid
    wait 0.5
}
shot play2
repeat forever {
    axis LY min
    wait 2
    press A
    axis LX max
    wait 1
    press X
    axis LX mid
    axis LY max
    wait 2
    press A
    axis LX min
    wait 1
