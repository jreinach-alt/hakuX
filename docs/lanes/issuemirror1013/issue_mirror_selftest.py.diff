+def test_gateway_retry_recovers_from_two_busy_responses():
+    """issuemirror1013 point 1: exit 75 ('another gateway run is in progress') means the gateway command never
+    ran at all -- github_gateway.py's main() takes its flock immediately after checking the subcommand name, and
+    returns 75 before doing anything else -- so it is the one rc safe to retry unconditionally, a write included.
+    A fake gateway that is busy for exactly the first two calls and free on the third must make both a read
+    (GH.budget_remaining, which parses stdout directly -- no --out file for a fake to fail to create) and a
+    write (GH.comment) succeed, with the write actually sent exactly 3 times total (2 busy + 1 that lands),
+    never more."""
+    old_run, old_backoffs = im.subprocess.run, im.GATEWAY_RETRY_BACKOFFS_S
+    im.GATEWAY_RETRY_BACKOFFS_S = (0, 0, 0, 0, 0)   # the retry COUNT is under test, not real wall-clock backoff
+    try:
+        calls = {'n': 0}
+
+        def fake_run(args, capture_output=True, text=True):
+            calls['n'] += 1
+            if calls['n'] <= 2:
+                return _FakeCompletedProcess(stdout='', stderr='another gateway run is in progress\n', returncode=75)
+            if 'budget' in args:
+                return _FakeCompletedProcess(stdout='reads=1/1200 writes=0/96 pushes=0/96\n'
+                                                     'reads_remaining=1199\nwrites_remaining=96\npushes_remaining=96\n',
+                                              returncode=0)
+            return _FakeCompletedProcess(stdout='COMMENTED #1 comment 42\n', returncode=0)
+
+        im.subprocess.run = fake_run
+        gh = im.GH(gateway='/dev/null')
+
+        calls['n'] = 0
+        remaining = gh.budget_remaining()
+        assert remaining == 1199, remaining
+        assert calls['n'] == 3, 'expected 2 busy + 1 success for the read: got %d calls' % calls['n']
+
+        calls['n'] = 0
+        cid = gh.comment(1, 'hello')
+        assert cid == '42', cid
+        assert calls['n'] == 3, 'expected 2 busy + 1 success for the write: got %d calls' % calls['n']
+    finally:
+        im.subprocess.run = old_run
+        im.GATEWAY_RETRY_BACKOFFS_S = old_backoffs
+    return 'gateway busy for 2 calls then free: budget_remaining() and comment() both succeed, each sent 3 times total'
+
+
+def test_gateway_retry_exhausts_bound_and_skips():
+    """issuemirror1013 point 1: once the bound runs out, the WHOLE command gives up with exit 75 and the tick
+    script's existing skip line ('skipped: gateway busy'), the same code hourly_report.sh already excludes from
+    its ALARM (grep for 'want 0 or 75') -- rather than a half-finished sync. The state file must be untouched:
+    cmd_sync's full pass only calls save_state() once, at the very end, so a GatewayBusy raised while just
+    listing issues (the very first gateway call) means that save_state() is never reached at all."""
+    old_run, old_backoffs = im.subprocess.run, im.GATEWAY_RETRY_BACKOFFS_S
+    im.GATEWAY_RETRY_BACKOFFS_S = (0, 0, 0)   # shrink the bound so the test doesn't wait the real ~135s
+    try:
+        with isolated():
+            if os.path.exists(im.STATE):
+                os.unlink(im.STATE)
+            gh, fg = im.GH(gateway='/dev/null'), FakeFG()
+
+            def always_busy(args, capture_output=True, text=True):
+                return _FakeCompletedProcess(stdout='', stderr='another gateway run is in progress\n', returncode=75)
+
+            im.subprocess.run = always_busy
+            rc, out = silent(im.cmd_sync, gh, fg, True)
+            assert rc == 75, (rc, out)
+            assert 'gateway busy' in out, out
+            assert not os.path.exists(im.STATE), 'save_state() must never run when the first gateway call never answers'
+    finally:
+        im.subprocess.run = old_run
+        im.GATEWAY_RETRY_BACKOFFS_S = old_backoffs
+    return 'sync --yes against a gateway that never frees the lock: exits 75 ("skipped: gateway busy"), no state file written'
+
