+def test_gateway_read_cap_refusal_is_distinct_and_not_retried():
+    """issuemirror1013 point 2: the gateway's day-cap refusal ('REFUSED: N GitHub reads today (cap M)') is a
+    real outcome, not a lock collision -- it must end the command with its own exit code (76, never 0/1/75) and
+    a status line naming the cap, and must never be retried (a retry cannot make today's cap bigger). The fake
+    always returns the cap-refusal text, so if this were retried even once, the call count would show it."""
+    old_run = im.subprocess.run
+    try:
+        calls = {'n': 0}
+
+        def fake_cap_refusal(args, capture_output=True, text=True):
+            calls['n'] += 1
+            return _FakeCompletedProcess(stdout='', stderr='REFUSED: 1200 GitHub reads today (cap 1200)\n', returncode=1)
+
+        im.subprocess.run = fake_cap_refusal
+        gh = im.GH(gateway='/dev/null')
+        try:
+            gh.budget_remaining()
+            assert False, 'expected GatewayCapRefused, got no exception'
+        except im.GatewayCapRefused as e:
+            assert e.cap == 'reads', e.cap
+        assert calls['n'] == 1, 'a cap refusal must never be retried: got %d calls' % calls['n']
+
+        with isolated():
+            if os.path.exists(im.STATE):
+                os.unlink(im.STATE)
+            calls['n'] = 0
+            fg = FakeFG()
+            rc, out = silent(im.cmd_sync, gh, fg, True)
+            assert rc == 76, (rc, out)
+            assert 'reads' in out and '00:00 UTC' in out, out
+            assert calls['n'] == 1, 'cmd_sync must not retry a cap refusal either: got %d calls' % calls['n']
+    finally:
+        im.subprocess.run = old_run
+    return 'a read-cap refusal raises GatewayCapRefused once (no retry) and cmd_sync exits 76 naming the cap and reset time'
+
