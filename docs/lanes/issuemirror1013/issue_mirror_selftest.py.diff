+def test_lock_refuses_concurrent_sync_during_backfill():
+    """issuemirror1012 gap 1, test a: a fake backfill holding .issue-mirror.lock makes a concurrent `sync --yes`
+    refuse (exit 75, 'skipped: another run holds the lock'), with nothing written to state."""
+    import fcntl
+    with isolated():
+        gh, fg = FakeGH(), FakeFG()
+        mk_pair(gh, fg, 1)
+        rc0, out0 = silent(im.cmd_sync, gh, fg, True)
+        assert rc0 == 0, out0
+        before = open(im.STATE, 'rb').read()
+        fd = os.open(im.LOCK, os.O_CREAT | os.O_RDWR, 0o644)
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            rc, out = silent(im.cmd_sync, gh, fg, True)
+            assert rc == 75, out
+            assert 'skipped: another run holds the lock' in out, out
+            after = open(im.STATE, 'rb').read()
+            assert after == before, 'state file was written while a concurrent run held the lock'
+        finally:
+            fcntl.flock(fd, fcntl.LOCK_UN)
+            os.close(fd)
+        rc2, out2 = silent(im.cmd_sync, gh, fg, True)
+        assert rc2 == 0, 'sync did not recover once the lock was released: %s' % out2
+        return 'sync --yes refuses (75, "skipped") while another run holds the lock; recovers once released'
+
