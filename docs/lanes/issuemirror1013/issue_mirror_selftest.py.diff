+class _FakeCompletedProcess:
+    """Same shape as subprocess.CompletedProcess, same as github_gateway_selftest.py's helper of the same name --
+    only stdout/stderr/returncode, since that's all _run_gateway and GH's parsers ever look at."""
+    def __init__(self, stdout='', stderr='', returncode=0):
+        self.stdout = stdout
+        self.stderr = stderr
+        self.returncode = returncode
