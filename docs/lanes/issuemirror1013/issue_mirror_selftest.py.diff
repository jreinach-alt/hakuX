+def test_budget_answered_while_gateway_lock_held():
+    """issuemirror1013 point 3: `budget` reads .gateway-state.json directly and never takes the gateway's own
+    flock (github_gateway.py main(), moved ahead of the lock in the staged copy) -- so issue_mirror.py's
+    pre-check can never collide with the push timer or another gateway run holding that lock for seconds to
+    minutes. Loads the STAGED github_gateway.py.new (this round's fix, not the live file) and points its
+    lock/state/window/log paths at a scratch temp dir -- the live .gateway.lock and .gateway-state.json are
+    never opened."""
+    gw_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'github_gateway.py.new')
+    # spec_from_file_location infers the loader from the file extension, which here is '.new', not '.py' --
+    # pass a SourceFileLoader explicitly so it is loaded as Python source anyway.
+    loader = importlib.machinery.SourceFileLoader('staged_github_gateway_1013', gw_path)
+    spec = importlib.util.spec_from_file_location('staged_github_gateway_1013', gw_path, loader=loader)
+    gw = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(gw)
+    tmpdir = tempfile.mkdtemp(prefix='gateway-budget-selftest-')
+    gw.H = tmpdir
+    gw.STATE = os.path.join(tmpdir, 'gateway-state.json')
+    gw.WINDOW = os.path.join(tmpdir, 'gateway-window')
+    gw.LOG = os.path.join(tmpdir, 'gateway.log')
+    lock_path = os.path.join(tmpdir, '.gateway.lock')
+    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o644)
+    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)   # held by THIS process for the whole test -- simulates another run
+    try:
+        old_argv = sys.argv
+        sys.argv = ['github_gateway.py', 'budget']
+        try:
+            rc, out = silent(gw.main)
+        finally:
+            sys.argv = old_argv
+        assert rc == 0, 'budget must succeed even while another run holds the gateway lock: rc=%r out=%s' % (rc, out)
+        assert 'reads_remaining=' in out, out
+    finally:
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        os.close(fd)
+    return 'staged github_gateway.py.new: `budget` answers (rc=0, reads_remaining= present) while .gateway.lock is held'
+
