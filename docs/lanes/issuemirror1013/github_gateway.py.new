#!/usr/bin/env python3
"""github_gateway.py: the one sanctioned path from the local stand-in repo to GitHub (owner 2026-10-05).

  check              read-only: does the token reach jreinach-alt/hakuX, and with what permissions
  plan               read-only: compare every local head with GitHub's, classify, run the safety checks; writes nothing
  push [--yes]       plan, then ONE atomic fast-forward-only push of every pushable head. Without --yes it stops at the plan.
  release [--yes] [tag...]  create the 'ready' nightly-* prereleases and vX.Y.Z releases from pm/github-release-sync.tsv
                            (create-only; dry run without --yes; a vX.Y.Z release is GitHub's latest, lane.local 2026-10-12)
  unrelease [--yes] tag...  delete nightly-* releases whose sync row is marked 'withdrawn' (owner 2026-10-09)
  renote [--yes] tag...     replace a published nightly-*'s notes with nightly/<date>.notes.corrected.md (owner 2026-10-09)
  prheads            read-only: the head branch of every open PR on GitHub, one per line; any failure exits 1 with nothing on stdout
  get PATH [--out FILE]  read-only, GET_OK paths only. Without --out, prints the body (truncated at 600000 chars --
                     a real limitation for a large listing, kept for existing callers). With --out, writes the
                     complete token-redacted body to FILE and prints one confirmation line. STAGED round 2
                     (lane.issuesync1012, 2026-10-12): issue_mirror.py always uses --out now.
  status             today's counters and the last result
  issue-create --title T [--body B] [--label L ...] [--state closed] [--yes] [--max-writes N]
                     POST /issues (then PATCH to close, if --state closed). Dry run without --yes. STAGED for
                     lane.issuesync1012 (2026-10-12): issue_mirror.py's backfill/new use this; nothing else calls it yet.
  issue-patch N [--title T] [--body B] [--state open|closed] [--label L ...] [--yes] [--max-writes N]
                     PATCH /issues/N, only the fields given. STAGED for lane.issuesync1012.
  issue-comment N --body B [--yes] [--max-writes N]
                     POST /issues/N/comments. STAGED for lane.issuesync1012.
  pr-patch N --state closed [--title T] [--body B] [--yes] [--max-writes N]
                     PATCH /pulls/N; state is only ever 'closed' (never reopen, never merge). STAGED for lane.issuesync1012.

Rules it enforces (it cannot be talked out of them): fast-forward only, never --force, never a delete, heads only (no tags);
a head that diverged from GitHub's, or whose GitHub tip is unknown locally, is skipped and reported; a head that touches
.github/workflows is skipped (a fine-grained token without the Workflows permission would make GitHub refuse the whole atomic
push); a push is refused if its new objects hold a blob over 50 MB, a token or private-key pattern, or one of our own
tokens; per-day caps on reads and pushes and a minimum gap between pushes. The token is read from
forge/tokens/github-gateway by git's askpass (gateway_askpass.sh) and by this process; it is never in a command line, a log
or this script's output.
ghwatch is told about the contact through host-tools/.gateway-window (an end epoch) and by the unit name hakux-github-gateway*.
"""
import urllib.parse, fnmatch, json, os, re, subprocess, sys, time, urllib.request, urllib.error, fcntl, threading

W = '/home/justin/hakux-work'
H = W + '/host-tools'
G = W + '/offline-git/hakuX.git'
TOKEN = W + '/forge/tokens/github-gateway'
ASKPASS = H + '/gateway_askpass.sh'
OWNER_REPO = 'jreinach-alt/hakuX'
URL = 'https://github.com/%s.git' % OWNER_REPO
STATE = H + '/.gateway-state.json'
WINDOW = H + '/.gateway-window'
LOG = W + '/logs/github_gateway.log'
PMLOG = W + '/pm/lanelocal-log.md'
EXCLUDE = H + '/gateway-exclude.txt'        # optional: one fnmatch pattern per line, matched against the branch name
SECRET_ALLOW = H + '/gateway-secret-allow.txt'   # optional: blob shas reviewed and allowed
MAX_PUSHES_DAY, MAX_READS_DAY, MIN_GAP_S = 96, 1200, 120
# MAX_READS_DAY 300 -> 600 (lane.local 2026-10-12): the push timer alone spends ~96 a day and the issue mirror ~8 a
# listing (lane.issuesync1012); 300 left no room for both. GitHub's own limit is 5000 an hour; this only bounds a loop.
# 600 -> 1200 (lane.local 2026-10-13): the one-time issue backfill (334 items, one race-window read each, plus
# ~10-page listings per run and per new number) spent the day's 600 by 00:15 PDT and refused every push until
# the next UTC day (day_counts), 17:00 PDT.
LOW_REFS = ('refs/heads/status', 'refs/heads/gh-pages')
LOW_MIN_GAP_S = 1800   # status and the dashboard change every few minutes; alone they are pushed at most every 30 min
MAX_BLOB = 50 * 1024 * 1024
MAX_NEW_REFS_DEFAULT, MAX_COMMITS_DEFAULT = 25, 5000
SECRET_RES = [re.compile(rb'gh[pousr]_[A-Za-z0-9]{36,}'), re.compile(rb'github_pat_[A-Za-z0-9_]{50,}'),
              re.compile(rb'-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY')]


def now():
    return time.time()

def stamp():
    return subprocess.run(['date', '+%F %H:%M %Z'], capture_output=True, text=True,
                          env=dict(os.environ, TZ='America/Los_Angeles')).stdout.strip()

def log(m):
    with open(LOG, 'a') as f:
        f.write('%s %s\n' % (stamp(), m))

def token():
    return open(TOKEN).read().strip()

def git(*a, env=None, check=True, inp=None):
    return subprocess.run(['git', '-C', G, *a], capture_output=True, text=True, errors='replace', env=env, check=check, input=inp)

def gh_env():
    e = dict(os.environ, GIT_ASKPASS=ASKPASS, GIT_TERMINAL_PROMPT='0', GIT_CONFIG_NOSYSTEM='1')
    e['PATH'] = '/usr/bin:/bin'
    return e

GH_ARGS = ['-c', 'credential.helper=', '-c', 'core.askPass=' + ASKPASS]

def load_state():
    try:
        return json.load(open(STATE))
    except Exception:
        return {}

def save_state(s):
    t = json.dumps(s)
    json.loads(t)
    open(STATE + '.tmp', 'w').write(t)
    os.replace(STATE + '.tmp', STATE)

def day_counts(s):
    d = time.strftime('%Y-%m-%d', time.gmtime())
    c = s.setdefault('days', {}).setdefault(d, {'reads': 0, 'pushes': 0})
    return c

def open_window(sec=600):
    open(WINDOW, 'w').write(str(int(now() + sec)))

def close_window():
    try:
        open(WINDOW, 'w').write(str(int(now() + 20)))   # leave a short tail: sockets linger in TIME_WAIT
    except Exception:
        pass

def read_budget(s):
    c = day_counts(s)
    if c['reads'] >= MAX_READS_DAY:
        sys.exit('REFUSED: %d GitHub reads today (cap %d)' % (c['reads'], MAX_READS_DAY))
    c['reads'] += 1
    save_state(s)


def cmd_check():
    s = load_state(); read_budget(s)
    tok = token()
    kind = 'fine-grained' if tok.startswith('github_pat_') else ('classic' if tok.startswith('ghp_') else 'other')
    req = urllib.request.Request('https://api.github.com/repos/' + OWNER_REPO,
                                 headers={'Authorization': 'Bearer ' + tok, 'User-Agent': 'hakux-gateway', 'Accept': 'application/vnd.github+json'})
    open_window()
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            d = json.load(r)
        print('token kind: %s' % kind)
        print('repo: %s  default_branch: %s  pushed_at: %s' % (d.get('full_name'), d.get('default_branch'), d.get('pushed_at')))
        print('permissions:', json.dumps(d.get('permissions')))
        print('private: %s' % d.get('private'))
    except urllib.error.HTTPError as e:
        print('HTTP %d from api.github.com (token kind %s)' % (e.code, kind)); sys.exit(2)
    finally:
        close_window()


def cmd_pages():
    s = load_state(); read_budget(s)
    tok = token()
    open_window()
    try:
        if '--build' in sys.argv:
            req = urllib.request.Request('https://api.github.com/repos/' + OWNER_REPO + '/pages/builds', method='POST', data=b'',
                                         headers={'Authorization': 'Bearer ' + tok, 'User-Agent': 'hakux-gateway', 'Accept': 'application/vnd.github+json'})
            try:
                with urllib.request.urlopen(req, timeout=30) as r:
                    print('POST /pages/builds', r.status, r.read()[:300].decode('utf8', 'replace'))
            except urllib.error.HTTPError as e:
                print('POST /pages/builds HTTP %d %s' % (e.code, e.read()[:300].decode('utf8', 'replace').replace(tok, '<token>')))
        for path in ('/pages', '/pages/builds/latest'):
            req = urllib.request.Request('https://api.github.com/repos/' + OWNER_REPO + path,
                                         headers={'Authorization': 'Bearer ' + tok, 'User-Agent': 'hakux-gateway', 'Accept': 'application/vnd.github+json'})
            try:
                with urllib.request.urlopen(req, timeout=30) as r:
                    d = json.load(r)
                print(path, json.dumps({k: d.get(k) for k in ('html_url', 'status', 'source', 'build_type', 'https_enforced', 'public', 'url', 'error', 'commit', 'created_at', 'updated_at', 'pusher') if k in d}, indent=1)[:1500])
            except urllib.error.HTTPError as e:
                print(path, 'HTTP %d %s' % (e.code, e.read()[:300].decode('utf8', 'replace').replace(tok, '<token>')))
    finally:
        close_window()


GET_OK = ('/actions/permissions', '/actions/runs', '/pages', '/branches/gh-pages', '/deployments', '/actions/workflows', '/releases', '/branches/status', '/contents/STATUS.md', '/issues', '/pulls', '/contents/LICENSE', '/community/profile', '/labels', '/interaction-limits')   # /issues, /pulls: read-only listings for the 0.5 issue-log audit (lane.local 10-12); /labels: round 3's shared label vocabulary (lane.issuesync1012 round 3) -- one cached read of the repo's own label list, read-only; /interaction-limits: round 4 addendum -- backfill's pre-flight check, read-only, repo-scoped (lapses in 24h-6mo, so it is read fresh every run, never trusted from memory)


def cmd_get(path, out=None):
    """STAGED (lane.issuesync1012 round 2, 2026-10-12): `--out FILE` writes the complete, token-redacted response
    body to FILE and prints only a one-line confirmation, instead of the old `print(...[:600000])`, which silently
    truncated (and so corrupted the JSON of) any listing page whose body ran past 600000 characters. Without
    --out the old truncated-print behavior is unchanged, for any existing caller that relies on it."""
    if not any(path == g or path.startswith(g + '?') or path.startswith(g + '/') for g in GET_OK):
        print('REFUSED: read-only paths only: ' + ' '.join(GET_OK)); return 3
    s = load_state(); read_budget(s)
    tok = token()
    req = urllib.request.Request('https://api.github.com/repos/' + OWNER_REPO + path,
                                 headers={'Authorization': 'Bearer ' + tok, 'User-Agent': 'hakux-gateway', 'Accept': 'application/vnd.github+json'})
    open_window()
    try:
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                body = r.read().decode('utf8', 'replace').replace(tok, '<token>')
                if out:
                    tmp = out + '.tmp'
                    with open(tmp, 'w') as f:
                        f.write(body)
                    os.replace(tmp, out)
                    print('wrote %d bytes to %s' % (len(body), out))
                else:
                    print(body[:600000])
        except urllib.error.HTTPError as e:
            # Round 4 addendum: a caller (GH.interaction_limits()) needs to tell "403, no permission" apart from
            # "200, parsed fine" to decide whether the limit is active -- falling through to `return 0` here (the
            # old behavior) let a failed read look identical to a successful empty one. No --out file is written
            # on this path; the caller must not assume one exists when the exit code is non-zero.
            #
            # Round 5, item 3: `sys.exit(main())` truncates to the low 8 bits of the process exit status, so
            # returning the raw HTTP status here was silently wrong for any code >= 256 and ambiguous even below
            # that (403 & 0xFF == 147, 404 & 0xFF == 148 -- neither is the real HTTP code once observed from the
            # shell). Documented, small exit codes instead, chosen to match this file's own REFUSED convention:
            # 3 for 403 (refused -- a token that can't read this), 1 for every other HTTP error. A caller that
            # needs the actual numeric status must read it out of the printed "HTTP %d ..." line, not the exit
            # code.
            print('HTTP %d %s' % (e.code, e.read()[:400].decode('utf8', 'replace').replace(tok, '<token>')))
            return 3 if e.code == 403 else 1
    finally:
        close_window()
    return 0


# --- staged for lane.issuesync1012 (2026-10-12): the narrowest write paths issue_mirror.py needs. -------------------
# Dry run unless --yes, exactly like release/unrelease/renote/pointer above. Every one of these goes through
# open_window()/close_window() and token() like the existing calls; every outgoing title/body/comment is scanned for
# secrets before it leaves the process (refuses tokens, private keys, and anything that looks like key.properties).
# A per-run cap (--max-writes, default MAX_WRITES_RUN_DEFAULT) bounds how many of these one invocation will do;
# issue_mirror.py is the thing that paces calls across a backfill run, not this file. Separately, MAX_WRITES_DAY
# (round 4) bounds the persisted per-day `writes` total across every invocation of the day, the way MAX_READS_DAY
# already bounds reads -- these are two different caps, tracked two different ways (see _write_budget below).
# NOT WIRED TO LIVE WRITES BY THE LANE: lane.issuesync1012 never passes --yes. lane.local decides when that changes.
MAX_WRITES_RUN_DEFAULT = 20
# Round 4, defect 1: sized for one full backfill run (487 writes: 332 creates + 155 follow-up closes) with
# headroom for the day's other gateway invocations (seed, sync, new, mirror-down, and any retried pending closes).
MAX_WRITES_DAY = 600
MIRROR_MARKER = '<!-- hakux-mirror:v1 src=%s#%s -->'   # appended to every mirrored body/comment; sync must skip echoes of its own marker


def mirror_marker(side, number):
    return MIRROR_MARKER % (side, number)


KEY_PROPERTIES_RES = [re.compile(rb'storePassword\s*='), re.compile(rb'keyPassword\s*='), re.compile(rb'keyAlias\s*=.*key0', re.I)]


def secret_scan_text(*texts):
    """Refuses tokens, private keys and key.properties contents in any outgoing body. Returns a problem string or None."""
    blob = ('\n'.join(t for t in texts if t)).encode('utf8', 'replace')
    for rx in SECRET_RES:
        if rx.search(blob):
            return 'outgoing text matches a token/private-key pattern'
    for rx in KEY_PROPERTIES_RES:
        if rx.search(blob):
            return 'outgoing text looks like android/key.properties contents'
    for f in os.listdir(W + '/forge/tokens'):
        if f.endswith('.token') or f == 'github-gateway':
            try:
                v = open(W + '/forge/tokens/' + f).read().strip()
                if len(v) >= 20 and v.encode() in blob:
                    return 'outgoing text contains one of our own tokens (%s)' % f
            except Exception:
                pass
    try:
        kp = open(os.path.expanduser('~/hakuX/android/key.properties')).read().strip()
        if kp and kp.encode() in blob:
            return 'outgoing text contains android/key.properties verbatim'
    except Exception:
        pass
    return None


class _WriteCapExceeded(Exception):
    pass


# Round 4, defect 1: this is a MODULE GLOBAL, not a persisted-state field. issue_mirror.py starts one gateway
# process per write (never passing --max-writes), so each invocation is a fresh `python3 github_gateway.py ...`
# interpreter start -- this counter is naturally 0 at the top of every one of those, with no reset logic needed.
# The old code instead kept this same count in the persisted per-day state dict (day_counts(s)['run_writes']),
# so it never reset between invocations and became a de facto day cap of MAX_WRITES_RUN_DEFAULT (20) across
# EVERY invocation of the UTC day -- not a per-run cap at all. Write 21 of the day, from any caller, was REFUSED.
_RUN_WRITES = 0


def _write_budget(s, cap):
    global _RUN_WRITES
    if _RUN_WRITES >= cap:
        raise _WriteCapExceeded('%d writes this run exceeds --max-writes %d' % (_RUN_WRITES, cap))
    c = day_counts(s)
    c.setdefault('writes', 0)
    if c['writes'] >= MAX_WRITES_DAY:
        raise _WriteCapExceeded('%d writes today exceeds the day cap %d' % (c['writes'], MAX_WRITES_DAY))
    c['writes'] += 1
    _RUN_WRITES += 1
    save_state(s)


def cmd_issue_create(title, body, labels=(), state=None, yes=False, max_writes=MAX_WRITES_RUN_DEFAULT):
    """POST /issues. GitHub's create API has no state field; a caller wanting it closed must follow with issue-patch."""
    prob = secret_scan_text(title, body)
    if prob:
        print('REFUSED: %s' % prob); return 3
    if not yes:
        print('WOULD POST /issues title=%r labels=%s (%d body chars)' % (title, list(labels), len(body or ''))); return 0
    s = load_state()
    try:
        _write_budget(s, max_writes)
    except _WriteCapExceeded as e:
        print('REFUSED: %s' % e); return 3
    tok = token()
    base = 'https://api.github.com/repos/' + OWNER_REPO
    payload = {'title': title, 'body': body or ''}
    if labels:
        payload['labels'] = list(labels)
    open_window()
    try:
        code, d = _api('POST', base + '/issues', tok, json.dumps(payload).encode())
    finally:
        close_window()
    if code != 201:
        print('STOP: create HTTP', code, d); return 2
    print('CREATED #%d %s' % (d['number'], d.get('html_url')))
    log('issue-create #%d (%d body chars, labels %s)' % (d['number'], len(body or ''), ','.join(labels)))
    if state == 'closed':
        return cmd_issue_patch(d['number'], state='closed', yes=True, max_writes=max_writes)
    return 0


def cmd_issue_patch(number, title=None, body=None, state=None, labels=None, yes=False, max_writes=MAX_WRITES_RUN_DEFAULT):
    """PATCH /issues/N. Only the fields passed are changed; works for issues and for the issue side of a PR."""
    prob = secret_scan_text(title, body)
    if prob:
        print('REFUSED: %s' % prob); return 3
    fields = {k: v for k, v in (('title', title), ('body', body), ('state', state)) if v is not None}
    if labels is not None:
        fields['labels'] = list(labels)
    if not fields:
        print('nothing to patch'); return 0
    if not yes:
        print('WOULD PATCH /issues/%d %s' % (number, sorted(fields))); return 0
    s = load_state()
    try:
        _write_budget(s, max_writes)
    except _WriteCapExceeded as e:
        print('REFUSED: %s' % e); return 3
    tok = token()
    base = 'https://api.github.com/repos/' + OWNER_REPO
    open_window()
    try:
        code, d = _api('PATCH', base + '/issues/%d' % number, tok, json.dumps(fields).encode())
    finally:
        close_window()
    if code != 200:
        print('STOP: patch HTTP', code, d); return 2
    print('PATCHED #%d %s' % (number, sorted(fields)))
    log('issue-patch #%d %s' % (number, sorted(fields)))
    return 0


def cmd_issue_comment(number, body, yes=False, max_writes=MAX_WRITES_RUN_DEFAULT):
    """POST /issues/N/comments."""
    prob = secret_scan_text(body)
    if prob:
        print('REFUSED: %s' % prob); return 3
    if not yes:
        print('WOULD POST /issues/%d/comments (%d body chars)' % (number, len(body or ''))); return 0
    s = load_state()
    try:
        _write_budget(s, max_writes)
    except _WriteCapExceeded as e:
        print('REFUSED: %s' % e); return 3
    tok = token()
    base = 'https://api.github.com/repos/' + OWNER_REPO
    open_window()
    try:
        code, d = _api('POST', base + '/issues/%d/comments' % number, tok, json.dumps({'body': body}).encode())
    finally:
        close_window()
    if code != 201:
        print('STOP: comment HTTP', code, d); return 2
    print('COMMENTED #%d comment %d' % (number, d.get('id', 0)))
    log('issue-comment #%d comment %s (%d chars)' % (number, d.get('id'), len(body or '')))
    return 0


def cmd_pr_patch(number, state=None, title=None, body=None, yes=False, max_writes=MAX_WRITES_RUN_DEFAULT):
    """PATCH /pulls/N. Used by close-pr; state='closed' is the only state transition the mirror ever asks for (never
    reopen, never merge: this gateway pushes heads, it does not decide what is mergeable)."""
    if state not in (None, 'closed'):
        print('REFUSED: pr-patch only ever sets state=closed'); return 3
    prob = secret_scan_text(title, body)
    if prob:
        print('REFUSED: %s' % prob); return 3
    fields = {k: v for k, v in (('title', title), ('body', body), ('state', state)) if v is not None}
    if not fields:
        print('nothing to patch'); return 0
    if not yes:
        print('WOULD PATCH /pulls/%d %s' % (number, sorted(fields))); return 0
    s = load_state()
    try:
        _write_budget(s, max_writes)
    except _WriteCapExceeded as e:
        print('REFUSED: %s' % e); return 3
    tok = token()
    base = 'https://api.github.com/repos/' + OWNER_REPO
    open_window()
    try:
        code, d = _api('PATCH', base + '/pulls/%d' % number, tok, json.dumps(fields).encode())
    finally:
        close_window()
    if code != 200:
        print('STOP: pr-patch HTTP', code, d); return 2
    print('PR-PATCHED #%d %s' % (number, sorted(fields)))
    log('pr-patch #%d %s' % (number, sorted(fields)))
    return 0
# --- end lane.issuesync1012 staged additions --------------------------------------------------------------------


def cmd_prheads():
    """read-only: the head branch of every open PR on GitHub, one per line (prune_worktrees.sh, owner 2026-10-09).
    Parsed here, not through `get`, whose output is cut at 600 kB. Any failure prints nothing on stdout and exits 1,
    so a caller can never mistake a partial list for the whole one."""
    s = load_state(); tok = token(); heads = []
    open_window()
    try:
        for page in range(1, 21):
            read_budget(s)
            req = urllib.request.Request('https://api.github.com/repos/%s/pulls?state=open&per_page=100&page=%d' % (OWNER_REPO, page),
                                         headers={'Authorization': 'Bearer ' + tok, 'User-Agent': 'hakux-gateway', 'Accept': 'application/vnd.github+json'})
            try:
                with urllib.request.urlopen(req, timeout=30) as r:
                    d = json.load(r)
            except Exception as e:
                print('prheads: page %d: %s' % (page, str(e).replace(tok, '<token>')), file=sys.stderr); return 1
            if not isinstance(d, list):
                print('prheads: page %d is not a list' % page, file=sys.stderr); return 1
            heads += [p['head']['ref'] for p in d]
            if len(d) < 100:
                break
        else:
            print('prheads: more than 20 pages of open PRs', file=sys.stderr); return 1
    finally:
        close_window()
    if heads:
        print('\n'.join(heads))
    return 0


def remote_heads():
    open_window()
    try:
        r = git(*GH_ARGS, 'ls-remote', '--heads', URL, env=gh_env(), check=False)
    finally:
        close_window()
    if r.returncode != 0:
        sys.exit('ls-remote failed (rc %d): %s' % (r.returncode, r.stderr.strip()[:300].replace(token(), '<token>')))
    out = {}
    for l in r.stdout.splitlines():
        sha, ref = l.split('\t')
        out[ref] = sha
    return out

def local_heads():
    out = {}
    for l in git('for-each-ref', '--format=%(objectname) %(refname)', 'refs/heads').stdout.splitlines():
        sha, ref = l.split(' ', 1)
        out[ref] = sha
    return out

def have(sha):
    return git('cat-file', '-e', sha + '^{commit}', check=False).returncode == 0

def is_anc(a, b):
    return git('merge-base', '--is-ancestor', a, b, check=False).returncode == 0

def excluded(ref):
    try:
        pats = [l.strip() for l in open(EXCLUDE) if l.strip() and not l.startswith('#')]
    except Exception:
        return False
    name = ref[len('refs/heads/'):]
    return any(fnmatch.fnmatch(name, p) for p in pats)


def build_plan():
    loc, rem = local_heads(), remote_heads()
    plan = {'new': [], 'ff': [], 'equal': [], 'skip': []}
    for ref, sha in sorted(loc.items()):
        if excluded(ref):
            plan['skip'].append((ref, 'excluded by gateway-exclude.txt')); continue
        r = rem.get(ref)
        if r is None:
            plan['new'].append((ref, sha))
        elif r == sha:
            plan['equal'].append(ref)
        elif not have(r):
            plan['skip'].append((ref, 'GitHub tip %s is not in the local repo (someone pushed there): reconcile by hand' % r[:10]))
        elif is_anc(r, sha):
            plan['ff'].append((ref, sha))
        elif is_anc(sha, r):
            plan['skip'].append((ref, 'GitHub is ahead of local by fast-forward (local %s behind %s)' % (sha[:10], r[:10])))
        else:
            plan['skip'].append((ref, 'DIVERGED from GitHub (local %s, GitHub %s): never forced' % (sha[:10], r[:10])))
    plan['remote_only'] = sorted(set(rem) - set(loc))
    known_remote = [v for v in rem.values() if have(v)]
    # workflows: a token without the Workflows permission makes GitHub refuse the whole atomic push
    keep = {'new': [], 'ff': []}
    for kind in ('new', 'ff'):
        for ref, sha in plan[kind]:
            args = ['log', '--format=%h', '-1', sha] + (['--not'] + known_remote if known_remote else []) + ['--', '.github/workflows']
            if git(*args).stdout.strip():
                plan['skip'].append((ref, 'changes .github/workflows (needs the token\'s Workflows permission)'))
            else:
                keep[kind].append((ref, sha))
    plan['new'], plan['ff'] = keep['new'], keep['ff']
    plan['known_remote'] = known_remote
    return plan


def scan_new_objects(tips, known_remote):
    """returns (problems, ncommits). Problems: oversized blobs, secret patterns, our own token values."""
    allow = set()
    try:
        allow = {l.split()[0] for l in open(SECRET_ALLOW) if l.strip() and not l.startswith('#')}
    except Exception:
        pass
    ours = []
    for f in os.listdir(W + '/forge/tokens'):
        if f.endswith('.token') or f == 'github-gateway':
            try:
                v = open(W + '/forge/tokens/' + f).read().strip()
                if len(v) >= 20:
                    ours.append((f, v.encode()))
            except Exception:
                pass
    rev = ['rev-list', '--objects'] + tips + (['--not'] + known_remote if known_remote else [])
    objs = git(*rev).stdout.splitlines()
    ncommits = int(git('rev-list', '--count', *(tips + (['--not'] + known_remote if known_remote else []))).stdout.strip() or 0)
    names = {}
    for l in objs:
        p = l.split(' ', 1)
        names[p[0]] = p[1] if len(p) > 1 else ''
    probs = []
    if not names:
        return probs, ncommits
    meta = subprocess.run(['git', '-C', G, 'cat-file', '--batch-check=%(objecttype) %(objectname) %(objectsize)'], input='\n'.join(names) + '\n',
                          capture_output=True, text=True).stdout.splitlines()
    blobs = []
    for l in meta:
        t, sha, size = l.split()
        if t != 'blob':
            continue
        size = int(size)
        if size > MAX_BLOB:
            probs.append('blob %s %s is %d MB' % (sha[:10], names.get(sha, ''), size >> 20))
        elif size <= 2 * 1024 * 1024 and sha not in allow:
            blobs.append(sha)
    p = subprocess.Popen(['git', '-C', G, 'cat-file', '--batch'], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    # Feed the names from a thread. Writing them all before reading deadlocked once the
    # output passed the pipe buffer (10-06 11:24 to 10-09: every run hung to its 600 s kill).
    def feed():
        p.stdin.write(('\n'.join(blobs) + '\n').encode()); p.stdin.close()
    threading.Thread(target=feed, daemon=True).start()
    out = p.stdout
    for sha in blobs:
        hdr = out.readline().split()
        n = int(hdr[2]); data = out.read(n); out.read(1)
        for rx in SECRET_RES:
            if rx.search(data):
                probs.append('secret pattern in blob %s %s' % (sha[:10], names.get(sha, ''))); break
        else:
            for nm, v in ours:
                if v in data:
                    probs.append('OUR TOKEN %s present in blob %s %s' % (nm, sha[:10], names.get(sha, ''))); break
    p.wait()
    return probs, ncommits


def cmd_plan(push=False, yes=False, max_new=MAX_NEW_REFS_DEFAULT, max_commits=MAX_COMMITS_DEFAULT):
    try:
        subprocess.run([sys.executable, H + '/status_page.py'], capture_output=True, text=True, timeout=120)   # refresh the `status` branch
    except Exception:
        pass
    s = load_state(); read_budget(s)
    plan = build_plan()
    todo = plan['new'] + plan['ff']
    status_only = bool(todo) and all(r in LOW_REFS for r, _ in todo)
    if status_only and now() - s.get('last_status_push', 0) < LOW_MIN_GAP_S:
        todo = []
    print('local heads vs GitHub: %d new, %d fast-forward, %d equal, %d skipped, %d on GitHub only (never deleted)' %
          (len(plan['new']), len(plan['ff']), len(plan['equal']), len(plan['skip']), len(plan['remote_only'])))
    for ref, why in plan['skip']:
        print('  SKIP %s: %s' % (ref, why))
    for ref, sha in plan['ff']:
        print('  FF   %s -> %s' % (ref, sha[:10]))
    for ref, sha in plan['new']:
        print('  NEW  %s %s' % (ref, sha[:10]))
    if plan['remote_only']:
        print('  GitHub-only heads: %s' % ', '.join(r[len('refs/heads/'):] for r in plan['remote_only'][:20]))
    if not todo:
        print('nothing to push'); log('plan: nothing to push (equal %d, skipped %d)' % (len(plan['equal']), len(plan['skip']))); return 0
    probs, ncommits = scan_new_objects([sha for _, sha in todo], plan['known_remote'])
    print('new commits: %d; safety scan: %s' % (ncommits, 'CLEAN' if not probs else '%d PROBLEM(S)' % len(probs)))
    for x in probs[:20]:
        print('  PROBLEM %s' % x)
    refuse = []
    if probs:
        refuse.append('safety scan found problems')
    if len(plan['new']) > max_new:
        refuse.append('%d new branches exceeds --max-new %d' % (len(plan['new']), max_new))
    if ncommits > max_commits:
        refuse.append('%d new commits exceeds --max-commits %d' % (ncommits, max_commits))
    if not push:
        return 1 if refuse else 0
    if refuse:
        print('REFUSED: ' + '; '.join(refuse)); log('REFUSED: ' + '; '.join(refuse)); return 3
    if not yes:
        print('dry run: add --yes to push'); return 0
    c = day_counts(s)
    if c['pushes'] >= MAX_PUSHES_DAY:
        print('REFUSED: %d pushes today (cap %d)' % (c['pushes'], MAX_PUSHES_DAY)); return 3
    if now() - s.get('last_push', 0) < MIN_GAP_S:
        print('REFUSED: last push %d s ago (minimum gap %d s)' % (now() - s['last_push'], MIN_GAP_S)); return 0
    specs = ['%s:%s' % (ref, ref) for ref, _ in todo]
    open_window(900)
    try:
        r = git(*GH_ARGS, 'push', '--atomic', URL, *specs, env=gh_env(), check=False)
    finally:
        close_window()
    tail = (r.stderr + r.stdout).replace(token(), '<token>')
    print(tail[-1500:])
    c['pushes'] += 1; s['last_push'] = now()
    if any(r in LOW_REFS for r, _ in todo):
        s['last_status_push'] = now()
    save_state(s)
    if r.returncode != 0:
        log('PUSH FAILED rc=%d: %s' % (r.returncode, tail[-300:].replace('\n', ' | '))); return r.returncode
    after = remote_heads()
    bad = [ref for ref, sha in todo if after.get(ref) != sha]
    msg = 'pushed %d heads (%d new, %d ff), %d commits; verified on GitHub: %s' % (len(todo), len(plan['new']), len(plan['ff']), ncommits, 'all tips match' if not bad else 'MISMATCH ' + ','.join(bad))
    print(msg); log(msg)
    if not status_only:
        with open(PMLOG, 'a') as f:
            f.write('\n## %s [github_gateway] %s\n' % (stamp(), msg))
    return 4 if bad else 0


RELEASE_TSV = W + '/pm/github-release-sync.tsv'
TAG_RE = re.compile(r'^nightly-\d{4}-\d{2}-\d{2}$')
VERSION_TAG_RE = re.compile(r'^v\d+\.\d+\.\d+$')   # a versioned release (docs/testing/release_build.sh's tag), #433


def release_tag(t):
    return bool(TAG_RE.match(t) or VERSION_TAG_RE.match(t))


def _api(method, url, tok, data=None, ctype='application/json', timeout=60):
    req = urllib.request.Request(url, method=method, data=data,
                                 headers={'Authorization': 'Bearer ' + tok, 'User-Agent': 'hakux-gateway',
                                          'Accept': 'application/vnd.github+json', 'Content-Type': ctype})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read() or b'null')
    except urllib.error.HTTPError as e:
        return e.code, e.read()[:400].decode('utf8', 'replace').replace(tok, '<token>')


def cmd_release(yes=False, only=None):
    """Publish nightly-* prereleases and vX.Y.Z releases listed in pm/github-release-sync.tsv with status 'ready'. Create
    only: a tag that already has a release is skipped, nothing is edited, replaced or deleted. No Actions are involved
    (owner 2026-10-05). GitHub creates the tag at target_sha with the release, so the gateway never pushes a tag."""
    import csv, hashlib
    s = load_state(); read_budget(s)
    tok = token()
    rows = [r for r in csv.DictReader(open(RELEASE_TSV), delimiter='\t') if release_tag(r['tag'])]
    rows = [r for r in rows if r['status'] == 'ready' and (not only or r['tag'] in only)]
    rows.sort(key=lambda r: r['tag'])
    base = 'https://api.github.com/repos/' + OWNER_REPO
    open_window()
    try:
        for r in rows:
            tag, sha, apk, name = r['tag'], r['target_sha'], r['apk_path'], r['publish_name']
            if not release_tag(tag) or not re.match(r'^[0-9a-f]{40}$', sha):
                print(tag, 'REFUSED: not a nightly or version tag / full sha'); continue
            versioned = bool(VERSION_TAG_RE.match(tag))
            if not os.path.isfile(apk):
                print(tag, 'SKIP: apk missing', apk); continue
            h = hashlib.sha256(open(apk, 'rb').read()).hexdigest()
            if h != r['apk_sha256'] or os.path.getsize(apk) != int(r['size']):
                print(tag, 'REFUSED: apk differs from the sync row (sha256/size)'); continue
            code, d = _api('GET', base + '/releases/tags/' + tag, tok)
            if code == 200:
                print(tag, 'SKIP: release already exists', d.get('html_url')); continue
            if code != 404:
                print(tag, 'STOP: release lookup HTTP', code, d); return 2
            code, d = _api('GET', base + '/commits/' + sha, tok)
            if code != 200:
                print(tag, 'SKIP: target sha %s is not on GitHub (HTTP %s)' % (sha[:10], code)); continue
            if versioned:
                title = 'hakuX %s' % tag[1:]
            else:
                title = 'hakuX nightly %s (%s)' % (tag[len('nightly-'):], sha[:10])
            body = open(r['notes_path']).read()
            kind = 'release (latest)' if versioned else 'prerelease'
            if not yes:
                print(tag, 'WOULD create %s "%s" at %s with asset %s (%d bytes)' % (kind, title, sha[:10], name, int(r['size']))); continue
            code, d = _api('POST', base + '/releases', tok, json.dumps({'tag_name': tag, 'target_commitish': sha, 'name': title,
                           'body': body, 'prerelease': not versioned, 'draft': False,
                           'make_latest': 'true' if versioned else 'false'}).encode())
            if code != 201:
                print(tag, 'STOP: create HTTP', code, d); return 2
            up = d['upload_url'].split('{')[0] + '?name=' + urllib.parse.quote(name)
            code, a = _api('POST', up, tok, open(apk, 'rb').read(), ctype='application/vnd.android.package-archive', timeout=600)
            if code != 201:
                print(tag, 'created, but asset upload HTTP', code, a, d.get('html_url')); return 2
            log('release %s created at %s asset %s' % (tag, sha[:10], name))
            print(tag, 'CREATED', d.get('html_url'), 'asset', a.get('name'), a.get('size'))
    finally:
        close_window()
    return 0


def cmd_unrelease(tags, yes=False):
    """Take down nightly-* releases the owner asked to withdraw (2026-10-09: "if any of them have no changes, take down
    the nightly"). Only a tag whose row in pm/github-release-sync.tsv has a status starting 'withdrawn' is touched; its
    release and its tag ref are deleted. Branches, other tags and other releases are never touched."""
    import csv
    rows = {r['tag']: r for r in csv.DictReader((l for l in open(RELEASE_TSV) if not l.startswith('#')), delimiter='\t')}
    for t in tags:
        if not TAG_RE.match(t) or not rows.get(t, {}).get('status', '').startswith('withdrawn'):
            print(t, 'REFUSED: not a nightly tag marked withdrawn in the sync table'); return 3
    s = load_state(); read_budget(s)
    tok = token()
    base = 'https://api.github.com/repos/' + OWNER_REPO
    open_window()
    try:
        for t in tags:
            code, d = _api('GET', base + '/releases/tags/' + t, tok)
            if code not in (200, 404):
                print(t, 'STOP: release lookup HTTP', code, d); return 2
            if not yes:
                print(t, 'WOULD delete', 'release %s and' % d.get('html_url') if code == 200 else '(no release)', 'tag ref'); continue
            if code == 200:
                c, e = _api('DELETE', base + '/releases/%d' % d['id'], tok)
                if c != 204:
                    print(t, 'STOP: release delete HTTP', c, e); return 2
            c, e = _api('DELETE', base + '/git/refs/tags/' + t, tok)
            if c not in (204, 404, 422):
                print(t, 'STOP: tag delete HTTP', c, e); return 2
            msg = 'release %s withdrawn (%s; tag ref HTTP %d)' % (t, rows[t]['status'], c)
            log(msg); print(t, 'WITHDRAWN', 'release deleted' if code == 200 else 'no release', 'tag HTTP', c)
    finally:
        close_window()
    return 0


def cmd_renote(tags, yes=False):
    """Replace the notes of published nightly-* releases (owner 2026-10-09, "close the loop": the 10-01..10-07 notes all
    listed the 09-29 window). The new body is nightly/<date>.notes.corrected.md, next to the original; only the release
    body is changed (not its name, tag, target or asset), and only for a row whose status starts 'published'."""
    import csv
    rows = {r['tag']: r for r in csv.DictReader((l for l in open(RELEASE_TSV) if not l.startswith('#')), delimiter='\t')}
    new = {}
    for t in tags:
        f = W + '/nightly/%s.notes.corrected.md' % t[len('nightly-'):]
        if not TAG_RE.match(t) or not rows.get(t, {}).get('status', '').startswith('published') or not os.path.isfile(f):
            print(t, 'REFUSED: not a published nightly tag with', f); return 3
        new[t] = open(f).read()
        if not new[t].strip() or len(new[t]) > 100000:
            print(t, 'REFUSED: corrected notes empty or too long'); return 3
    s = load_state(); read_budget(s)
    tok = token()
    base = 'https://api.github.com/repos/' + OWNER_REPO
    open_window()
    try:
        for t in tags:
            code, d = _api('GET', base + '/releases/tags/' + t, tok)
            if code != 200:
                print(t, 'STOP: release lookup HTTP', code, d); return 2
            if (d.get('body') or '').strip() == new[t].strip():
                print(t, 'SKIP: notes already match'); continue
            if not yes:
                print(t, 'WOULD replace the notes of %s (%d -> %d chars)' % (d.get('html_url'), len(d.get('body') or ''), len(new[t]))); continue
            c, e = _api('PATCH', base + '/releases/%d' % d['id'], tok, json.dumps({'body': new[t]}).encode())
            if c != 200:
                print(t, 'STOP: release edit HTTP', c, e); return 2
            log('release %s notes replaced (%d chars, from %s.notes.corrected.md)' % (t, len(new[t]), t[len('nightly-'):]))
            print(t, 'RENOTED', d.get('html_url'))
    finally:
        close_window()
    return 0


STATUS_URL ='https://github.com/%s/blob/status/STATUS.md' % OWNER_REPO
STATUS_ISSUE, STATUS_COMMENT = 107, 5840054853


def cmd_pointer(yes=False):
    """Rewrite the pinned status issue (#107) and its one comment to point at STATUS.md on the status branch (Pages is not used:
    Actions stays off, owner 2026-10-05; edit approved by the owner 2026-10-05). Touches only that issue's title/body and that comment."""
    s = load_state(); read_budget(s)
    tok = token()
    title = 'harness: live status -- STATUS.md on the status branch'
    body = ('## hakuX status\n\n### **' + STATUS_URL + '**\n\n'
            'The page lists the lanes running now and the model each one uses, the handhelds, the device queue, the Playable '
            'titles, and what has landed on master. It is rebuilt on the host every 15 minutes and pushed here at most every 30; '
            'the time it was built is at the bottom.\n\nThis issue stays pinned so the issue list still leads there.')
    cbody = 'The status page is **' + STATUS_URL + '**. This comment is no longer updated.'
    if not yes:
        print('WOULD set #%d title "%s" and body (%d chars), and comment %d' % (STATUS_ISSUE, title, len(body), STATUS_COMMENT)); return 0
    base = 'https://api.github.com/repos/' + OWNER_REPO
    open_window()
    try:
        c1, d1 = _api('PATCH', base + '/issues/%d' % STATUS_ISSUE, tok, json.dumps({'title': title, 'body': body}).encode())
        c2, d2 = _api('PATCH', base + '/issues/comments/%d' % STATUS_COMMENT, tok, json.dumps({'body': cbody}).encode())
        print('issue', c1, 'comment', c2)
        if c1 != 200 or c2 != 200:
            print(d1 if c1 != 200 else '', d2 if c2 != 200 else ''); return 2
        log('status pointer #%d updated to %s' % (STATUS_ISSUE, STATUS_URL))
    finally:
        close_window()
    return 0


def cmd_status():
    s = load_state()
    print(json.dumps({'days': s.get('days', {}), 'last_push_epoch': s.get('last_push')}, indent=1))
    os.system('tail -5 %s 2>/dev/null' % LOG)


def cmd_budget():
    """issuemirror1012 gap 3 (issuemirror1013: moved ahead of the flock in main() -- see there): today's UTC
    reads/writes/pushes against their caps, read from .gateway-state.json with no network call of any kind --
    read_budget()/_write_budget() are never called here, so running this never spends a read itself. A caller
    that needs "how many reads are left today" (cmd_backfill's per-item pre-check) parses the
    reads_remaining= line rather than re-deriving it, so there is exactly one place that does the subtraction."""
    s = load_state()
    c = day_counts(s)
    reads, writes, pushes = c.get('reads', 0), c.get('writes', 0), c.get('pushes', 0)
    print('reads=%d/%d writes=%d/%d pushes=%d/%d' %
          (reads, MAX_READS_DAY, writes, MAX_WRITES_DAY, pushes, MAX_PUSHES_DAY))
    print('reads_remaining=%d' % max(0, MAX_READS_DAY - reads))
    print('writes_remaining=%d' % max(0, MAX_WRITES_DAY - writes))
    print('pushes_remaining=%d' % max(0, MAX_PUSHES_DAY - pushes))
    return 0


def _strs(a, name):
    return [a[i + 1] for i in range(len(a)) if a[i] == name]


def _str_opt(a, name, d=None):
    return a[a.index(name) + 1] if name in a else d


def main():
    a = sys.argv[1:]
    if not a or a[0] not in ('check', 'plan', 'push', 'status', 'budget', 'pages', 'get', 'prheads', 'release', 'unrelease', 'renote', 'pointer',
                              'issue-create', 'issue-patch', 'issue-comment', 'pr-patch'):
        print(__doc__); return 64
    # issuemirror1013: `budget` only reads .gateway-state.json -- every writer replaces that file atomically
    # with os.replace(), so a reader never needs the flock below to see a consistent file. Answering it before
    # the lock means issue_mirror.py's per-item pre-check (gh_client.budget_remaining(), several times a
    # backfill run) can never collide with the push timer or another gateway run, which otherwise hold that
    # lock for seconds to minutes at a time. `status` reads the same state file the same way and could
    # arguably move here too; left after the lock for this round since nothing depends on it being lock-free.
    if a[0] == 'budget':
        return cmd_budget()
    lk = open(H + '/.gateway.lock', 'w')
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print('another gateway run is in progress'); return 75
    def opt(name, d):
        return int(a[a.index(name) + 1]) if name in a else d
    if a[0] == 'check':
        cmd_check(); return 0
    if a[0] == 'status':
        cmd_status(); return 0
    if a[0] == 'pages':
        cmd_pages(); return 0
    if a[0] == 'get':
        return cmd_get(a[1], out=_str_opt(a, '--out'))
    if a[0] == 'prheads':
        return cmd_prheads()
    if a[0] == 'pointer':
        return cmd_pointer(yes='--yes' in a)
    if a[0] == 'issue-create':
        return cmd_issue_create(_str_opt(a, '--title', ''), _str_opt(a, '--body', ''), labels=_strs(a, '--label'),
                                 state=_str_opt(a, '--state'), yes='--yes' in a, max_writes=opt('--max-writes', MAX_WRITES_RUN_DEFAULT))
    if a[0] == 'issue-patch':
        return cmd_issue_patch(int(a[1]), title=_str_opt(a, '--title'), body=_str_opt(a, '--body'), state=_str_opt(a, '--state'),
                                labels=_strs(a, '--label') or None, yes='--yes' in a, max_writes=opt('--max-writes', MAX_WRITES_RUN_DEFAULT))
    if a[0] == 'issue-comment':
        return cmd_issue_comment(int(a[1]), _str_opt(a, '--body', ''), yes='--yes' in a, max_writes=opt('--max-writes', MAX_WRITES_RUN_DEFAULT))
    if a[0] == 'pr-patch':
        return cmd_pr_patch(int(a[1]), state=_str_opt(a, '--state'), title=_str_opt(a, '--title'), body=_str_opt(a, '--body'),
                             yes='--yes' in a, max_writes=opt('--max-writes', MAX_WRITES_RUN_DEFAULT))
    if a[0] == 'release':
        return cmd_release(yes='--yes' in a, only=[x for x in a[1:] if release_tag(x)] or None)
    if a[0] == 'unrelease':
        return cmd_unrelease([x for x in a[1:] if x.startswith('nightly-')], yes='--yes' in a)
    if a[0] == 'renote':
        return cmd_renote([x for x in a[1:] if x.startswith('nightly-')], yes='--yes' in a)
    return cmd_plan(push=(a[0] == 'push'), yes='--yes' in a, max_new=opt('--max-new', MAX_NEW_REFS_DEFAULT), max_commits=opt('--max-commits', MAX_COMMITS_DEFAULT))

if __name__ == '__main__':
    # Round 4: guarded so github_gateway_selftest.py can import this module and call its real functions
    # directly (per the brief: "test against the real gateway functions, not the fake"). No behavior change for
    # the only real caller -- `python3 github_gateway.py ...` always runs with __name__ == '__main__'.
    sys.exit(main())
