# state: any   (classifier-path benchmark opening; #433 step 6c)
# NBA Live 07 (454100A1), classifier-path benchmark (#433): drive generic
# replaces the blind opening and marks gameplay itself once play is
# confirmed. Basketball: move the ball-handler, turn, shoot/pass -- never
# START.
drive generic 300 mark
repeat forever {
    axis LY min
    wait 1.5
    axis LX max
    wait 0.8
    axis LX min
    wait 0.8
    axis LX mid
    axis LY mid
    press A 300
    wait 1.2
}
