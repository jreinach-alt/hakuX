# The route for a title that has none of its own.
#
# It cannot know when gameplay starts, so it never writes `mark gameplay`.
# It writes `mark play` where its play pattern begins; title_verdict.py
# scores from there provisionally and records reached_gameplay as UNCONFIRMED
# until a reviewer has looked at the contact sheet (gameplay_by: review).
#
# Boot, then alternate START and A through the attract screen and menus.
# The pauses are long on purpose: an FMV that ignores input until it ends
# must be allowed to end, and a skippable intro is skipped by either press.
wait 60
mark booted
repeat 14 {
    press START
    wait 5
    press A
    wait 5
}
mark play
# Then play: left stick forward, A every few seconds, a camera nudge, and a
# frame every few cycles for the contact sheet.
repeat forever {
    repeat 4 {
        axis LY min
        press A
        wait 3
        press A
        wait 3
        press A
        wait 3
        axis RX max
        wait 0.5
        axis RX mid
        axis LY mid
        wait 1
    }
    shot play
}
