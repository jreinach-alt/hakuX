#
# Player control: in the rally Kasumi (P1, black) ran toward the ball with LX
# held. The match cuts to a reaction scene of a few seconds after every
# point; the play pattern keeps pressing A/B through them.
drive generic 300 mark
repeat forever {
    axis LX max
    press A
    wait 0.6
    axis LX mid
    press B
    wait 0.6
    axis LX min
    press A
    wait 0.6
    axis LX mid
    press B
    wait 0.6
}
