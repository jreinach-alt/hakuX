press A
wait 5.1
shot skip
wait 60
shot cut2
wait 90
mark gameplay
repeat forever {
    axis LY min
    wait 2
    press A
    axis LX max
    wait 1
    press A
    axis LX mid
    axis LY max
    wait 2
    press A
    axis LX min
    wait 1
