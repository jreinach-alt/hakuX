        axis LY min
        wait 1.0
        axis LY mid
        wait 0.25
        press X 120
        wait 0.6
        press A 120
        wait 0.6
        axis RX max
        wait 0.5
        axis RX mid
        wait 0.25
        axis LY max
        wait 1.0
        axis LY mid
        wait 0.25
        press B 120
        wait 0.6
        axis RX min
        wait 0.5
        axis RX mid
        wait 0.25
        press X 120
        wait 0.6
    }
}
