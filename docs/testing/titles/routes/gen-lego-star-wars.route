# state: any   (classifier-path benchmark opening; #433 step 6c)
# LEGO Star Wars: The Video Game (4553001D), classifier-path benchmark
# (#433): drive generic replaces the blind opening and marks gameplay
# itself once play is confirmed. Action-platformer: run forward, turn,
# attack/jump -- never START.
drive generic 300 mark
repeat forever {
    axis LY min
    wait 2.0
    axis LX max
    wait 1.0
    axis LX mid
    wait 1.0
    axis LX min
    wait 1.0
    axis LX mid
    mash A 2 0.3
    wait 1.5
}
