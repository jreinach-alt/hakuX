[Unit]
Description=hakuX status roll-up -- rewrite the live status comment
Documentation=file:///home/justin/hakuX/docs/testing/jobs/status.sh

[Service]
Type=oneshot
# run-trunk.sh keeps a private worktree of origin/master and runs the job
# from it, so a stale owner checkout cannot run a stale job.
ExecStart=/usr/bin/env bash /home/justin/hakuX/docs/testing/jobs/run-trunk.sh status
SuccessExitStatus=75
TimeoutStartSec=1800
StandardOutput=append:/home/justin/hakux-work/logs/status/systemd.log
StandardError=append:/home/justin/hakux-work/logs/status/systemd.log
