[Unit]
Description=hakuX nightly build and publish
Documentation=file:///home/justin/hakuX/docs/testing/nightly_build.sh
# A build needs no device, so this never contends with the dispatcher's queue.
# Deliberately NOT ordered against anything: if the dispatcher is mid-sweep at
# 00:30 that is fine and intended.

[Service]
Type=oneshot
# No WorkingDirectory. It used to name /home/justin/hakuX and that WAS the
# defect: the nightly built whatever branch the owner had last checked out
# there, and on 2026-09-20 and -21 published a 09-19 sha twice under a current
# date. run-nightly.sh chooses the tree now -- its own worktree of
# origin/master, fetched at 00:30 -- and nightly_build.sh refuses to publish
# anything that is not that tip.
#
# NOT run-trunk.sh: that launcher shares one worktree across the script jobs
# and holds .jobs-wt.lock for the whole run, and an Android build would park
# fold, arms, status and both sweeps behind it. run-nightly.sh's header has
# the long version.
#
# The script sets JAVA_HOME and the cmake PATH itself; HOME is what gh and git
# need to find credentials, and a user unit already has it.
ExecStart=/usr/bin/env bash /home/justin/hakuX/docs/testing/jobs/run-nightly.sh
# 75: another nightly still held the lock, so this tick skipped. Not a failure.
SuccessExitStatus=75
# Its own log file as well as the journal. A nightly that failed silently is
# worse than no nightly, because a missing release looks like a day with no
# work -- so make the failure readable two ways.
StandardOutput=append:/home/justin/hakux-work/nightly/systemd.log
StandardError=append:/home/justin/hakux-work/nightly/systemd.log
# A build can be slow on a loaded box; do not let systemd kill it mid-link.
TimeoutStartSec=3600
