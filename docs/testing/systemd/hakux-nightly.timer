[Unit]
Description=hakuX nightly at 00:30 America/Los_Angeles

[Timer]
OnCalendar=*-*-* 00:30:00
# THE REASON THIS IS A TIMER AND NOT A CRON LINE. This host is WSL2, which is
# shut down whenever the user closes it -- so a cron entry at 00:30 silently
# misses every night the box was not running, and a missing nightly is
# indistinguishable from a day with no work. Persistent=true records the last
# run and fires once on the next boot if 00:30 was missed.
Persistent=true
# systemd fuzzes timers by up to a minute by default; 00:30 is a reference
# point the owner reads against the commit log, so keep it tight.
AccuracySec=30s
Unit=hakux-nightly.service

[Install]
WantedBy=timers.target
