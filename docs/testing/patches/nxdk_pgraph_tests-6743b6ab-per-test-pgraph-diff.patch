     0xFD4017EC, 0xFD4017F0, 0xFD4017F4, 0xFD4017F8, 0xFD4017FC,
 };
 
+// ---------------------------------------------------------------------------
+// PMC watch. READ ONLY -- nothing here writes MMIO.
+//
+// This exists to settle one question a register diff cannot: whether NV2A's
+// NV_PMC_ENABLE uses the generic NVIDIA bit positions. nv2a_regs.h declares
+// PFIFO at bit 8 and PGRAPH at bit 12, but a probe read taken at the
+// dashboard returned 0x01110000 -- bits 16, 20 and 24, with 8 and 12 clear.
+// Either the engines really were idle at the dashboard, or the layout is not
+// the generic one. Reading the same register from inside a test, with PGRAPH
+// and PFIFO demonstrably running, separates the two.
+//
+// NV_PMC_BOOT_0 is read alongside as a canary. It is a fixed chip ID, so a
+// value other than 0x02A000A3 means the read path is not trustworthy -- a
+// byte-swapped MMIO window has produced confident nonsense here before -- and
+// the whole row must be discarded rather than interpreted.
+static constexpr uint32_t kPMCBase = 0xFD000000;
+struct PMCWatch {
+  uint32_t offset;
+  const char *name;
+};
+static constexpr PMCWatch kPMCWatch[] = {
+    {0x000000, "BOOT_0(canary)"},
+    {0x000100, "INTR_0"},
+    {0x000140, "INTR_EN_0"},
+    {0x000200, "ENABLE"},
+};
+
+static std::string read_pmc_watch() {
+  std::string out;
+  char line[96];
+  for (const auto &w : kPMCWatch) {
+    // Identity-mapped MMIO; volatile so the reads are not folded or reordered.
+    auto v = *reinterpret_cast<volatile const uint32_t *>(kPMCBase + w.offset);
+    snprintf(line, sizeof(line), "PMC %s 0x%08X = 0x%08X\n", w.name,
+             kPMCBase + w.offset, v);
+    out += line;
+  }
+  return out;
+}
