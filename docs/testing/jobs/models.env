# Which model each role runs on. Sourced by run-claude-job.sh and lane.sh;
# $WORK/limits.env (uncommitted, on the host) overrides any line here.
#
# The policy, set by the owner 2026-09-19: coding lanes run on Opus because
# this software needs the reasoning; a lane that cannot clear its issue after
# three attempts is bumped to Fable for the fourth; bookkeeping (the board
# tick, triage) runs on Sonnet. Identifiers are the current generation's, no
# date suffixes. Append "[1m]" to a lane model to ask Claude Code for the
# 1M-token context variant if a lane keeps compacting.
MODEL_BOOKKEEPING=claude-sonnet-5
MODEL_LANE=claude-opus-5
MODEL_LANE_ESCALATED=claude-fable-5-1
MODEL_AUDIT=claude-opus-5
LANE_ESCALATE_AFTER=3      # attempts on MODEL_LANE before the next start uses MODEL_LANE_ESCALATED
LANE_MAX_ATTEMPTS=4        # after this many starts, lane.sh refuses and the board opens a decision-needed issue
