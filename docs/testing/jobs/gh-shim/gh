def cmd_auth(argv):
    if not argv or argv[0] != "status":
        raise NotImpl()
    a = Args(argv[1:], {"--hostname": (("-h",), "val"), "--show-token": (("-t",), "bool"),
                        "--active": ((), "bool")})
    if a.get("--show-token"):
        raise NotImpl()
    fg = Forge(os.environ.get("GH_REPO") or DEFAULT_REPO, "auth status")
    u = fg.get("/user")
    print(f"{FORGE_URL.split('://')[-1]}\n  ✓ Logged in to the local forge as {u.get('login')} (gh-shim; token "
          f"{actor()}.token)", file=sys.stderr)
    return 0


LOGGED = {"notes": []}


def log_note(msg):
    LOGGED["notes"].append(msg)
    print("gh-shim: warning: " + msg, file=sys.stderr)


def caller_unit():
    """The systemd unit this call runs in (hakux-status.service, hakux-lane-x.service, ...)."""
    try:
        with open("/proc/self/cgroup") as f:
            path = f.read().strip().split(":")[-1]
        units = [p for p in path.split("/") if p.endswith((".service", ".scope"))]
        return units[-1] if units else ""
    except OSError:
        return ""


def log_call(argv, rc, t0, err=""):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        rec = dict(ts=datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), rc=rc,
                   ms=int((time.time() - t0) * 1000), user=actor(), unit=caller_unit(), ppid=os.getppid(),
                   cwd=os.getcwd(), argv=[x if len(x) <= 300 else x[:300] + "...[%d]" % len(x) for x in argv])
        if err:
            rec["err"] = err[:400]
        if LOGGED["notes"]:
            rec["notes"] = LOGGED["notes"]
        with open(LOG, "a") as f:
            f.write(json.dumps(rec) + "\n")
    except OSError:
        pass


def main(argv):
    if not argv or argv[0] in ("help", "--help", "-h"):
        raise NotImpl()
    if argv[0] in ("--version", "version"):
        print(VERSION)
        return 0
    cmd = argv[0]
    table = dict(pr=cmd_pr, issue=cmd_issue, label=cmd_label, release=cmd_release, run=cmd_run, api=cmd_api,
                 auth=cmd_auth)
    if cmd not in table:
        raise NotImpl()
    if any(x in ("--help", "-h") for x in argv[1:]) and cmd != "api":
        raise NotImpl()
    return table[cmd](argv[1:]) or 0


if __name__ == "__main__":
    argv = sys.argv[1:]
    t0 = time.time()
    try:
        rc = main(argv)
        log_call(argv, rc, t0)
        sys.exit(rc)
    except NotImpl:
        msg = "gh-shim: not implemented: " + " ".join(argv)
        print(msg, file=sys.stderr)
        log_call(argv, 64, t0, msg)
        sys.exit(64)
    except Fail as e:
        msg = "gh-shim: " + e.msg.replace("\n", " | ")
        print(msg, file=sys.stderr)
        log_call(argv, e.rc, t0, msg)
        sys.exit(e.rc)
    except BrokenPipeError:
        log_call(argv, 0, t0, "broken pipe")
        sys.exit(0)
    except Exception as e:  # a shim bug must not look like success either
        msg = f"gh-shim: internal error in `{' '.join(argv[:3])}`: {type(e).__name__}: {e}"
        print(msg, file=sys.stderr)
        log_call(argv, 1, t0, msg)
        sys.exit(1)
