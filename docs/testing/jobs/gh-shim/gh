HOME = os.path.expanduser("~")
TOKENS = os.environ.get("FORGE_TOKENS", HOME + "/hakux-work/forge/tokens")
LOG = os.environ.get("GH_SHIM_LOG", HOME + "/hakux-work/logs/forge/shim.log")
GIT_DIR = os.environ.get("FORGE_GIT_DIR", "")  # merge-tree source; default: the forge's own repo dir
REPOS_ROOT = os.environ.get("FORGE_REPOS_ROOT", HOME + "/hakux-work/forge/data/repos")
CACHE = os.environ.get("FORGE_SHIM_CACHE", HOME + "/hakux-work/forge/cache")
SYNC = os.environ.get("FORGE_SYNC", HOME + "/hakux-work/forge/bin/forge-sync.sh")
JQ = os.environ.get("GH_SHIM_JQ", "jq")
