REL_FIELDS = {"tagName", "name", "isPrerelease", "isDraft", "createdAt", "publishedAt", "url", "body",
              "isLatest", "assets"}


def rel_obj(r, fields):
    m = dict(tagName=r.get("tag_name"), name=r.get("name"), isPrerelease=bool(r.get("prerelease")),
             isDraft=bool(r.get("draft")), createdAt=r.get("created_at"), publishedAt=r.get("published_at"),
             url=r.get("html_url"), body=r.get("body") or "", isLatest=False,
             assets=[dict(name=x.get("name"), size=x.get("size"), url=x.get("browser_download_url"))
                     for x in r.get("assets") or []])
    return {k: m[k] for k in fields}


def upload_assets(fg, rel, files, clobber, op):
    have = {x["name"]: x for x in rel.get("assets") or []}
    for f in files:
        path, _, label = f.partition("#")
        name = os.path.basename(path)
        if name in have:
            if not clobber:
                raise Fail(1, f"{op}: asset {name} already exists (use --clobber)")
            fg.request("DELETE", fg.r(f"/releases/{rel['id']}/assets/{have[name]['id']}"))
        try:
            with open(path, "rb") as fh:
                data = fh.read()
        except OSError as e:
            raise Fail(1, f"{op}: cannot read {path}: {e.strerror}") from None
        boundary = "gh-shim-" + os.urandom(8).hex()
        body = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"attachment\"; filename=\"{name}\"\r\n"
                f"Content-Type: application/octet-stream\r\n\r\n").encode() + data + f"\r\n--{boundary}--\r\n".encode()
        fg.request("POST", fg.r(f"/releases/{rel['id']}/assets"), query=dict(name=name), raw=body,
                   ctype=f"multipart/form-data; boundary={boundary}")


def cmd_release(argv):
    if not argv:
        raise NotImpl()
    sub, rest = argv[0], argv[1:]
    op = "release " + sub
    if sub == "list":
        a = Args(rest, spec(JSONFLAGS, **{"--limit": (("-L",), "val"), "--exclude-drafts": ((), "bool"),
                                          "--exclude-pre-releases": ((), "bool")}))
        fg = Forge(repo_of(a), op)
        fields = fields_of(a, REL_FIELDS, op)
        rows = fg.all(fg.r("/releases"), cap=int(a.get("--limit") or 30))[: int(a.get("--limit") or 30)]
        if a.get("--exclude-drafts"):
            rows = [r for r in rows if not r.get("draft")]
        if a.get("--exclude-pre-releases"):
            rows = [r for r in rows if not r.get("prerelease")]
        if fields:
            return output(a, [rel_obj(r, fields) for r in rows], op)
        for r in rows:
            emit(f"{r.get('name')}\t{'Pre-release' if r.get('prerelease') else ''}\t{r.get('tag_name')}\t{r.get('published_at')}")
        return 0
    if sub == "view":
        a = Args(rest, spec(JSONFLAGS))
        fg = Forge(repo_of(a), op)
        if not a.pos:
            raise NotImpl()
        r = fg.get(fg.r("/releases/tags/" + urllib.parse.quote(a.pos[0], safe="")), ok404=True)
        if r is None:
            raise Fail(1, f"{op}: release not found: {a.pos[0]}")
        fields = fields_of(a, REL_FIELDS, op)
        if fields:
            return output(a, rel_obj(r, fields), op)
        emit(f"{r.get('name')}\n{r.get('tag_name')}\n{r.get('body') or ''}")
        return 0
    if sub == "create":
        a = Args(rest, spec(**{"--title": (("-t",), "val"), "--notes": (("-n",), "val"),
                               "--notes-file": (("-F",), "val"), "--prerelease": (("-p",), "bool"),
                               "--draft": (("-d",), "bool"), "--target": ((), "val")}))
        fg = Forge(repo_of(a), op)
        if not a.pos:
            raise Fail(2, f"{op}: tag required")
        tag, files = a.pos[0], a.pos[1:]
        notes = read_body_file(a.get("--notes-file")) if a.get("--notes-file") else (a.get("--notes") or "")
        body = dict(tag_name=tag, name=a.get("--title") or tag, body=notes,
                    prerelease=bool(a.get("--prerelease")), draft=bool(a.get("--draft")))
        if a.get("--target"):
            body["target_commitish"] = a.get("--target")
        rel = fg.json("POST", fg.r("/releases"), body=body)
        upload_assets(fg, rel, files, False, op)
        emit(rel.get("html_url"))
        return 0
    if sub == "upload":
        a = Args(rest, spec(**{"--clobber": ((), "bool")}))
        fg = Forge(repo_of(a), op)
        if len(a.pos) < 2:
            raise Fail(2, f"{op}: tag and files required")
        rel = fg.get(fg.r("/releases/tags/" + urllib.parse.quote(a.pos[0], safe="")), ok404=True)
        if rel is None:
            raise Fail(1, f"{op}: release not found: {a.pos[0]}")
        upload_assets(fg, rel, a.pos[1:], bool(a.get("--clobber")), op)
        return 0
    raise NotImpl()


