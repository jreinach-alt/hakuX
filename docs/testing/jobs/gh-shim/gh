def cmd_issue(argv):
    if not argv:
        raise NotImpl()
    sub, rest = argv[0], argv[1:]
    op = "issue " + sub
    if sub == "list":
        a = Args(rest, spec(JSONFLAGS, **{"--state": (("-s",), "val"), "--limit": (("-L",), "val"),
                                          "--label": (("-l",), "multi"), "--author": (("-A",), "val")}))
        fg = Forge(repo_of(a), op)
        fields = fields_of(a, ISSUE_FIELDS, op)
        state = (a.get("--state") or "open").lower()
        if state not in ("open", "closed", "all"):
            raise Fail(2, f"{op}: invalid --state {state}")
        q = dict(state=state, type="issues")
        want = a.get("--label") or []
        if want:
            known = Labels(fg).all()
            missing = [w for w in want if w not in known]
            for w in missing:
                log_note(f"{op}: label '{w}' does not exist in {fg.repo}; result is empty for it")
            if missing:
                rows = []
            else:
                q["labels"] = ",".join(want)
                rows = fg.all(fg.r("/issues"), q)
        else:
            rows = fg.all(fg.r("/issues"), q)
        # Exact AND on label names, whatever the server's filter did.
        rows = [i for i in rows if not i.get("pull_request") and set(want) <= {l["name"] for l in i.get("labels") or []}]
        if a.get("--author"):
            rows = [i for i in rows if (i.get("user") or {}).get("login") == a.get("--author")]
        rows.sort(key=lambda i: -i["number"])
        rows = rows[: int(a.get("--limit") or 30)]
        if fields:
            return output(a, [issue_obj(fg, i, fields) for i in rows], op)
        for i in rows:
            emit(f"{i['number']}\t{'OPEN' if i.get('state') == 'open' else 'CLOSED'}\t{i.get('title')}\t"
                 f"{', '.join(l['name'] for l in i.get('labels') or [])}\t{i.get('updated_at')}")
        return 0
    if sub == "view":
        a = Args(rest, spec(JSONFLAGS, **{"--comments": (("-c",), "bool"), "--web": (("-w",), "bool")}))
        if a.get("--web") or not a.pos:
            raise NotImpl()
        fg = Forge(repo_of(a), op)
        n = issue_number(a.pos[0], op)
        it = fg.get(fg.r(f"/issues/{n}"), ok404=True)
        if it is None:
            raise Fail(1, f"{op}: no issue #{n} in {fg.repo}")
        fields = fields_of(a, ISSUE_FIELDS, op)
        if fields:
            return output(a, issue_obj(fg, it, fields), op)
        o = issue_obj(fg, it, ["number", "title", "state", "author", "labels", "url", "body"])
        emit(f"title:\t{o['title']}\nstate:\t{o['state']}\nauthor:\t{o['author']['login']}\n"
             f"labels:\t{', '.join(l['name'] for l in o['labels'])}\nnumber:\t{o['number']}\nurl:\t{o['url']}\n--\n{o['body']}")
        if a.get("--comments"):
            for c in comments_of(fg, n):
                emit(f"--\nauthor:\t{c['author']['login']}\ncreated:\t{c['createdAt']}\n--\n{c['body']}")
        return 0
    if sub == "create":
        a = Args(rest, spec(**{"--title": (("-t",), "val"), "--body": (("-b",), "val"),
                               "--body-file": (("-F",), "val"), "--label": (("-l",), "multi")}))
        fg = Forge(repo_of(a), op)
        if not a.get("--title"):
            raise Fail(2, f"{op}: --title required (the shim does not prompt)")
        body = read_body_file(a.get("--body-file")) if a.get("--body-file") else (a.get("--body") or "")
        lab = Labels(fg).ids(a.get("--label") or []) if a.get("--label") else []
        it = fg.json("POST", fg.r("/issues"), body=dict(title=a.get("--title"), body=body, labels=lab))
        emit(it.get("html_url"))
        return 0
    if sub == "comment":
        a = Args(rest, spec(**{"--body": (("-b",), "val"), "--body-file": (("-F",), "val")}))
        fg = Forge(repo_of(a), op)
        if not a.pos:
            raise Fail(2, f"{op}: issue number required")
        return post_comment(fg, issue_number(a.pos[0], op), a, op)
    if sub == "edit":
        a = Args(rest, spec(**{"--title": (("-t",), "val"), "--body": (("-b",), "val"),
                               "--body-file": (("-F",), "val"), "--add-label": ((), "multi"),
                               "--remove-label": ((), "multi")}))
        fg = Forge(repo_of(a), op)
        if not a.pos:
            raise Fail(2, f"{op}: issue number required")
        return edit_issue(fg, issue_number(a.pos[0], op), a, op)
    if sub in ("close", "reopen"):
        a = Args(rest, spec(**{"--comment": (("-c",), "val"), "--reason": (("-r",), "val")}))
        fg = Forge(repo_of(a), op)
        if not a.pos:
            raise Fail(2, f"{op}: issue number required")
        n = issue_number(a.pos[0], op)
        if a.get("--comment"):
            fg.json("POST", fg.r(f"/issues/{n}/comments"), body=dict(body=a.get("--comment")))
        fg.json("PATCH", fg.r(f"/issues/{n}"), body=dict(state="closed" if sub == "close" else "open"))
        return 0
    if sub in ("pin", "unpin"):
        a = Args(rest, spec())
        fg = Forge(repo_of(a), op)
        if not a.pos:
            raise Fail(2, f"{op}: issue number required")
        fg.request("POST" if sub == "pin" else "DELETE", fg.r(f"/issues/{issue_number(a.pos[0], op)}/pin"))
        return 0
    raise NotImpl()


def issue_number(ref, op):
    m = re.search(r"(\d+)$", str(ref))
    if not m:
        raise Fail(2, f"{op}: not an issue number: {ref}")
    return int(m.group(1))


