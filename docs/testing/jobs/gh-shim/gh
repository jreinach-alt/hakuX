def parse_fields(pairs, typed):
    """gh's -f/-F: key=value, key[]=v (array), key[sub]=v (nested), -F @file / typed literals."""
    out = {}
    for kind, kv in pairs:
        if "=" not in kv:
            raise Fail(2, f"api: field '{kv}' is not key=value")
        k, v = kv.split("=", 1)
        if kind == "F":
            if v.startswith("@"):
                v = read_body_file(v[1:])
            elif v in ("true", "false"):
                v = v == "true"
            elif v == "null":
                v = None
            elif re.fullmatch(r"-?\d+", v):
                v = int(v)
        m = re.fullmatch(r"([^\[\]]+)((?:\[[^\[\]]*\])*)", k)
        if not m:
            raise Fail(2, f"api: bad field key '{k}'")
        keys = [m.group(1)] + re.findall(r"\[([^\[\]]*)\]", m.group(2))
        cur = out
        for i, kk in enumerate(keys):
            last = i == len(keys) - 1
            nxt_arr = (not last) and keys[i + 1] == ""
            if kk == "":
                if last:
                    cur.append(v)
                else:
                    raise NotImpl()
                continue
            if last:
                cur[kk] = v
            else:
                cur = cur.setdefault(kk, [] if nxt_arr else {})
    return out


def api_path(raw, repo):
    p = re.sub(r"^https?://api\.github\.com/", "", raw).lstrip("/")
    o, n = repo.split("/")
    p = p.replace("{owner}", o).replace("{repo}", n).replace(":owner", o).replace(":repo", n)
    path, _, qs = p.partition("?")
    q = urllib.parse.parse_qsl(qs, keep_blank_values=True)
    return path, q


def gh_query(q):
    """GitHub query parameters -> Forgejo's (per_page -> limit)."""
    out = []
    for k, v in q:
        if k == "per_page":
            out.append(("limit", str(min(int(v or 30), 100))))
        else:
            out.append((k, v))
    return out


def api_special(fg, method, path, q):
    """GitHub endpoints whose Forgejo equivalent differs. Returns a (pages-list) or None."""
    R = fg.repo
    m = re.fullmatch(rf"repos/{re.escape(R)}/commits/([^/]+)/check-runs", path, re.I)
    if m and method == "GET":
        return [check_runs(fg, resolve_sha(fg, m.group(1)))]
    m = re.fullmatch(rf"repos/{re.escape(R)}/commits/([^/]+)/status", path, re.I)
    if m and method == "GET":
        sts = statuses(fg, resolve_sha(fg, m.group(1)))
        for s in sts:
            s.setdefault("state", s.get("status"))
        order = ["failure", "error", "pending", "success"]
        worst = min((s["state"] for s in sts), key=lambda x: order.index(x) if x in order else 3, default="pending")
        return [dict(state=worst if sts else "pending", statuses=sts, total_count=len(sts), sha=m.group(1))]
    m = re.fullmatch(rf"repos/{re.escape(R)}/commits/([^/]+)", path, re.I)
    if m and method == "GET":
        rows = fg.get(fg.r("/commits"), dict(sha=m.group(1), limit=1, stat="false", files="false", verification="false"))
        if not rows:
            raise Fail(1, f"api GET {path}: no commit for {m.group(1)}")
        return [rows[0]]
    m = re.fullmatch(rf"repos/{re.escape(R)}/issues/(\d+)/events", path, re.I)
    if m and method == "GET":
        return [issue_events(fg, int(m.group(1)))]
    m = re.fullmatch(rf"repos/{re.escape(R)}/issues/comments", path, re.I)
    if m and method == "GET":
        qd = dict(q)
        fq = {k: v for k, v in qd.items() if k in ("since", "before")}
        rows = fg.all(fg.r("/issues/comments"), fq)
        rows.sort(key=lambda c: (c.get("created_at") or "", c.get("id") or 0),
                  reverse=qd.get("direction") == "desc")
        rows = [fix_comment(fg, c) for c in rows]
        per = int(qd.get("per_page") or 30)
        page = int(qd.get("page") or 1)
        return ("PAGED", rows, per, page)
    m = re.fullmatch(rf"repos/{re.escape(R)}/issues/(\d+)/comments", path, re.I)
    if m and method == "GET":
        rows = [fix_comment(fg, c) for c in fg.all(fg.r(f"/issues/{m.group(1)}/comments"),
                                                   {k: v for k, v in q if k in ("since", "before")})]
        qd = dict(q)
        return ("PAGED", rows, int(qd.get("per_page") or 30), int(qd.get("page") or 1))
    m = re.fullmatch(rf"repos/{re.escape(R)}/issues/comments/(\d+)", path, re.I)
    if m and method in ("GET", "PATCH"):
        return None  # plain pass-through, html_url fixed below
    m = re.fullmatch(rf"repos/{re.escape(R)}/issues/(\d+)/labels/(.+)", path, re.I)
    if m and method == "DELETE":
        name = urllib.parse.unquote(m.group(2))
        L = Labels(fg).all()
        lab = L.get(name)
        if lab is None and name.isdigit():
            lab = next((l for l in L.values() if str(l["id"]) == name), None)
        if lab is None:
            raise Fail(1, f"api DELETE {path}: label '{name}' does not exist in {R}")
        on = {l["name"] for l in fg.get(fg.r(f"/issues/{m.group(1)}/labels")) or []}
        if name not in on and lab["name"] not in on:
            raise Fail(1, f"api DELETE {path}: HTTP 404: Label does not exist on #{m.group(1)}")
        fg.request("DELETE", fg.r(f"/issues/{m.group(1)}/labels/{lab['id']}"))
        return [fg.get(fg.r(f"/issues/{m.group(1)}/labels"))]
    return None


def resolve_sha(fg, ref):
    if re.fullmatch(r"[0-9a-f]{40}", ref):
        return ref
    rows = fg.get(fg.r("/commits"), dict(sha=ref, limit=1, stat="false", files="false", verification="false"))
    if not rows:
        raise Fail(1, f"api: cannot resolve ref {ref}")
    return rows[0]["sha"]


def fix_comment(fg, c):
    c = dict(c)
    url = c.get("html_url") or ""
    m = re.search(r"/(?:issues|pulls)/(\d+)", url) or re.search(r"/(\d+)$", c.get("issue_url") or c.get("pull_request_url") or "")
    if m:
        n = m.group(1)
        c["issue_url"] = f"{FORGE_URL}/api/v1/repos/{fg.repo}/issues/{n}"
    c["html_url"] = comment_html(c)
    return c


def issue_events(fg, n):
    out = []
    for t in fg.all(fg.r(f"/issues/{n}/timeline")):
        ty = t.get("type")
        ev = None
        if ty == "label" and t.get("label"):
            ev = dict(event="labeled" if (t.get("body") or "") == "1" else "unlabeled",
                      label=dict(name=t["label"].get("name"), color=(t["label"].get("color") or "").lstrip("#")))
        elif ty in ("close", "reopen", "merge_pull", "pull_push", "assignees", "change_title", "pin", "unpin", "lock"):
            ev = dict(event={"close": "closed", "reopen": "reopened", "merge_pull": "merged",
                             "pull_push": "head_ref_force_pushed" if t.get("is_force_push") else "committed",
                             "assignees": "assigned", "change_title": "renamed", "pin": "pinned",
                             "unpin": "unpinned", "lock": "locked"}[ty])
        if ev:
            ev.update(id=t.get("id"), actor=user(t.get("user")), created_at=t.get("created_at"))
            out.append(ev)
    return out


def cmd_api(argv):
    spec_ = dict(COMMON)
    spec_.update({"--method": (("-X",), "val"), "--jq": (("-q",), "val"), "--paginate": ((), "bool"),
                  "--silent": ((), "bool"), "--input": ((), "val"), "--header": (("-H",), "multi"),
                  "--hostname": ((), "val"), "--cache": ((), "val"), "--template": (("-t",), "val"),
                  "--slurp": ((), "bool"), "--verbose": ((), "bool")})
    # -f/-F keep their order and repetition; pull them out first.
    pairs, rest, i = [], [], 0
    while i < len(argv):
        x = argv[i]
        if x in ("-f", "--raw-field", "-F", "--field"):
            if i + 1 >= len(argv):
                raise Fail(2, f"api: {x} needs key=value")
            pairs.append(("f" if x in ("-f", "--raw-field") else "F", argv[i + 1]))
            i += 2
            continue
        m = re.fullmatch(r"(--raw-field|--field)=(.*)", x)
        if m:
            pairs.append(("f" if m.group(1) == "--raw-field" else "F", m.group(2)))
        elif re.fullmatch(r"-[fF].+", x):
            pairs.append((x[1], x[2:]))
        else:
            rest.append(x)
        i += 1
    a = Args(rest, spec_)
    if a.get("--template") or a.get("--verbose"):
        raise NotImpl()
    if not a.pos:
        raise Fail(2, "api: endpoint required")
    if a.pos[0] == "graphql":
        raise NotImpl()
    repo = repo_of(a)
    path, q = api_path(a.pos[0], repo)
    fields = parse_fields(pairs, True)
    method = (a.get("--method") or ("POST" if (pairs or a.get("--input")) else "GET")).upper()
    op = f"api {method} {path}"
    fg = Forge(repo, op)
    body = None
    if a.get("--input"):
        raw = read_body_file(a.get("--input"))
        try:
            body = json.loads(raw) if raw.strip() else None
        except ValueError:
            raise Fail(2, f"{op}: --input is not JSON") from None
    if fields:
        if method == "GET":
            for k, v in fields.items():
                q.append((k, str(v).lower() if isinstance(v, bool) else str(v)))
        else:
            body = dict(body or {}, **fields)
    if method == "POST" and re.fullmatch(rf"repos/{re.escape(repo)}/issues/\d+/labels", path, re.I) and body:
        body = dict(body, labels=Labels(fg).ids([str(x) for x in body.get("labels") or []]))
    pages = api_special(fg, method, path, q)
    if pages is None:
        fq = gh_query(q)
        pages = []
        page = int(dict(fq).get("page") or 1)
        while True:
            qq = [(k, v) for k, v in fq if k != "page"] + ([("page", str(page))] if (a.get("--paginate") or dict(fq).get("page")) else [])
            st, hdr, b = fg.request(method, "/" + path, qq, body=body)
            text = b.decode(errors="replace")
            try:
                j = norm_ts(json.loads(text)) if text.strip() else None
            except ValueError:
                j = text
            if isinstance(j, list) and re.search(r"/issues/comments$|/issues/\d+/comments$", path):
                j = [fix_comment(fg, c) for c in j]
            elif isinstance(j, dict) and re.search(r"/issues/comments/\d+$|/issues/\d+/comments$", path) and method != "DELETE":
                j = fix_comment(fg, j)
            pages.append(j)
            if not a.get("--paginate") or not isinstance(j, list):
                break
            lim = int(dict(fq).get("limit") or 30)
            if len(j) < lim or 'rel="next"' not in (hdr.get("Link") or hdr.get("link") or ""):
                break
            page += 1
            if page > 400:
                raise Fail(1, f"{op}: --paginate did not end after 400 pages")
    elif isinstance(pages, tuple) and pages[0] == "PAGED":
        _t, rows, per, page = pages
        per = min(max(per, 1), 100)
        if a.get("--paginate"):
            pages = [rows[i:i + per] for i in range(0, len(rows), per)] or [[]]
        else:
            pages = [rows[(page - 1) * per: page * per]]
    if a.get("--silent"):
        return 0
    if a.get("--jq"):
        for p in pages:
            emit(run_jq(a.get("--jq"), json.dumps(p), op))
        return 0
    if len(pages) == 1:
        p = pages[0]
        if isinstance(p, str):
            sys.stdout.write(p)
        elif p is not None:
            emit(json.dumps(p))
        return 0
    if all(isinstance(p, list) for p in pages):
        emit(json.dumps([x for p in pages for x in p]))
    else:
        for p in pages:
            emit(json.dumps(p))
    return 0


