RUN_FIELDS = {"workflowName", "status", "conclusion", "headSha", "createdAt", "updatedAt", "databaseId",
              "displayTitle", "event", "headBranch", "name", "url", "number", "startedAt", "workflowDatabaseId"}
RUN_STATUS = {"success": ("completed", "success"), "failure": ("completed", "failure"),
              "cancelled": ("completed", "cancelled"), "skipped": ("completed", "skipped"),
              "running": ("in_progress", ""), "waiting": ("queued", ""), "blocked": ("waiting", ""),
              "unknown": ("queued", "")}


def run_obj(fg, r, fields):
    st, concl = RUN_STATUS.get((r.get("status") or "unknown").lower(), ("completed", (r.get("status") or "").lower()))
    wf = r.get("workflow_id") or ""
    m = dict(workflowName=re.sub(r"\.ya?ml$", "", wf), name=re.sub(r"\.ya?ml$", "", wf), status=st,
             conclusion=concl, headSha=r.get("commit_sha") or r.get("head_sha") or "",
             createdAt=utc(r.get("created") or r.get("created_at")), updatedAt=utc(r.get("updated") or r.get("updated_at")),
             startedAt=utc(r.get("started") or r.get("run_started_at")), databaseId=r.get("id"),
             displayTitle=r.get("title") or r.get("display_title") or "", event=r.get("event") or r.get("trigger_event") or "",
             headBranch=re.sub(r"^refs/heads/", "", r.get("prettyref") or r.get("ref") or r.get("head_branch") or ""),
             url=r.get("html_url") or "", number=r.get("index_in_repo") or r.get("run_number"), workflowDatabaseId=wf)
    return {k: m[k] for k in fields}


def cmd_run(argv):
    if not argv:
        raise NotImpl()
    sub, rest = argv[0], argv[1:]
    op = "run " + sub
    if sub == "list":
        a = Args(rest, spec(JSONFLAGS, **{"--branch": (("-b",), "val"), "--limit": (("-L",), "val"),
                                          "--workflow": (("-w",), "val"), "--status": (("-s",), "val"),
                                          "--commit": (("-c",), "val"), "--event": (("-e",), "val")}))
        fg = Forge(repo_of(a), op)
        fields = fields_of(a, RUN_FIELDS, op)
        lim = int(a.get("--limit") or 20)
        j = fg.get(fg.r("/actions/runs"), dict(limit=PAGE, **({"head_sha": a.get("--commit")} if a.get("--commit") else {})))
        rows = [r for r in (j or {}).get("workflow_runs") or [] if CI_WORKFLOW_RE.search(r.get("workflow_id") or "")]
        objs = [run_obj(fg, r, RUN_FIELDS) for r in rows]
        if a.get("--branch"):
            objs = [o for o in objs if o["headBranch"] == a.get("--branch")]
        if a.get("--workflow"):
            w = re.sub(r"\.ya?ml$", "", a.get("--workflow"))
            objs = [o for o in objs if o["workflowName"] == w]
        if a.get("--event"):
            objs = [o for o in objs if o["event"] == a.get("--event")]
        if a.get("--status"):
            objs = [o for o in objs if a.get("--status") in (o["status"], o["conclusion"])]
        objs.sort(key=lambda o: o["createdAt"] or "", reverse=True)
        objs = objs[:lim]
        if fields:
            return output(a, [{k: o[k] for k in fields} for o in objs], op)
        for o in objs:
            emit(f"{o['status']}\t{o['conclusion']}\t{o['displayTitle']}\t{o['workflowName']}\t{o['headBranch']}\t"
                 f"{o['event']}\t{o['databaseId']}\t{o['createdAt']}")
        return 0
    raise NotImpl()


