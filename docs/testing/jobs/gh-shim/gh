PAGE = 50
WIP_RE = re.compile(r"^\s*(\[WIP\]|WIP:|WIP)\s*", re.I)
CLOSE_RE = re.compile(r"(?i)\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s*:?\s+#(\d+)")


class Fail(Exception):
    def __init__(self, rc, msg):
        super().__init__(msg)
        self.rc, self.msg = rc, msg


class NotImpl(Exception):
    pass


# ---------------------------------------------------------------- utilities

def utc(ts):
    """Forgejo timestamp (any offset) -> GitHub's 2026-10-02T17:00:00Z."""
    if not isinstance(ts, str) or not ts:
        return ts or None
    if ts.startswith("0001-01-01"):  # Go's zero time: "never"
        return None
    try:
        d = datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return ts
    if d.tzinfo is None:
        d = d.replace(tzinfo=timezone.utc)
    return d.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


TS_KEYS = {"created_at", "updated_at", "closed_at", "merged_at", "due_date", "published_at",
           "started", "stopped", "run_started_at", "pushed_at"}


def norm_ts(obj):
    if isinstance(obj, dict):
        return {k: (utc(v) if k in TS_KEYS and isinstance(v, str) else norm_ts(v)) for k, v in obj.items()}
    if isinstance(obj, list):
        return [norm_ts(x) for x in obj]
    return obj


def actor():
    u = os.environ.get("FORGE_USER", "").strip()
    if u:
        return u
    role = os.environ.get("HAKUX_ROLE", "")
    return {"lane": "lanes", "cloud": "lanes", "hostops": "hostops",
            "lane.local": "lane.local", "local": "lane.local", "owner": "owner"}.get(role, "jobs")


def token():
    u = actor()
    p = os.path.join(TOKENS, u + ".token")
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError as e:
        raise Fail(4, f"no forge token for user '{u}' at {p} ({e.strerror})")


class Forge:
    def __init__(self, repo, op):
        self.repo = repo
        self.op = op
        self.tok = token()

    def request(self, method, path, query=None, body=None, raw=None, ctype="application/json",
                accept="application/json", ok404=False):
        """Returns (status, headers, bytes). Raises Fail on transport errors and HTTP >= 400
        (unless ok404 and the status is 404)."""
        if not path.startswith("/"):
            path = "/" + path
        url = FORGE_URL + "/api/v1" + path
        if query:
            q = urllib.parse.urlencode(query, doseq=True)
            url += ("&" if "?" in url else "?") + q
        data = raw if raw is not None else (json.dumps(body).encode() if body is not None else None)
        req = urllib.request.Request(url, method=method, data=data)
        req.add_header("Authorization", "token " + self.tok)
        req.add_header("Accept", accept)
        if data is not None:
            req.add_header("Content-Type", ctype)
        try:
            with urllib.request.urlopen(req, timeout=float(os.environ.get("GH_SHIM_TIMEOUT", "60"))) as r:
                return r.status, dict(r.headers), r.read()
        except urllib.error.HTTPError as e:
            payload = e.read()
            if ok404 and e.code == 404:
                return 404, dict(e.headers), payload
            raise Fail(1, f"{self.op}: HTTP {e.code} from {method} {path}: {errmsg(payload)}") from None
        except (urllib.error.URLError, OSError) as e:
            raise Fail(1, f"{self.op}: forge unreachable at {FORGE_URL} ({getattr(e, 'reason', e)}); "
                          f"is hakux-forge.service running?") from None

    def json(self, method, path, query=None, body=None, ok404=False):
        st, _h, b = self.request(method, path, query, body, ok404=ok404)
        if st == 404 and ok404:
            return None
        if not b.strip():
            return None
        try:
            return norm_ts(json.loads(b))
        except ValueError:
            raise Fail(1, f"{self.op}: non-JSON reply from {method} {path}") from None

    def get(self, path, query=None, ok404=False):
        return self.json("GET", path, query, ok404=ok404)

    def all(self, path, query=None, cap=None):
        """Every page of a list endpoint (Forgejo pages by `limit`, not `per_page`)."""
        out, page = [], 1
        q = dict(query or {})
        while True:
            q.update(page=page, limit=PAGE)
            rows = self.get(path, q)
            if not isinstance(rows, list):
                raise Fail(1, f"{self.op}: expected a list from GET {path}, got {type(rows).__name__}")
            out.extend(rows)
            if len(rows) < PAGE or (cap is not None and len(out) >= cap):
                return out
            page += 1
            if page > 400:
                raise Fail(1, f"{self.op}: GET {path} did not end after 400 pages")

    def r(self, sub=""):
        return f"/repos/{self.repo}{sub}"


def errmsg(payload):
    try:
        j = json.loads(payload)
        if isinstance(j, dict):
            m = j.get("message") or j.get("error") or ""
            errs = j.get("errors")
            if errs:
                m = (m + " " + json.dumps(errs))[:300]
            return m or payload[:200].decode(errors="replace")
    except ValueError:
        pass
    return payload[:200].decode(errors="replace").strip()


def run_jq(expr, data_json, op):
    try:
        p = subprocess.run([JQ, "-r", "-c", expr], input=data_json, capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        raise Fail(1, f"{op}: --jq needs jq on PATH ({JQ} not found)") from None
    if p.returncode:
        raise Fail(p.returncode if p.returncode < 64 else 1,
                   f"{op}: jq failed rc={p.returncode}: {p.stderr.strip()[:200]}")
    return p.stdout


def emit(text):
    if text:
        sys.stdout.write(text if text.endswith("\n") else text + "\n")


def read_body_file(path):
    if path == "-":
        return sys.stdin.read()
    try:
        with open(path) as f:
            return f.read()
    except OSError as e:
        raise Fail(1, f"cannot read body file {path}: {e.strerror}") from None


# ---------------------------------------------------------------- argument parsing

class Args:
    """A strict little gh-style parser: unknown flags raise NotImpl."""

    def __init__(self, argv, spec):
        # spec: canonical -> (aliases tuple, kind) ; kind in {"bool","val","multi"}
        self.vals, self.pos = {}, []
        alias = {}
        for name, (al, kind) in spec.items():
            for a in (name,) + tuple(al):
                alias[a] = (name, kind)
        i = 0
        while i < len(argv):
            a = argv[i]
            if a == "--":
                self.pos.extend(argv[i + 1:])
                break
            if a.startswith("-") and a != "-" and not re.fullmatch(r"-\d+", a):
                key, val = a, None
                if a.startswith("--") and "=" in a:
                    key, val = a.split("=", 1)
                elif not a.startswith("--") and len(a) > 2 and a[:2] in alias:
                    key, val = a[:2], a[2:]
                if key not in alias:
                    raise NotImpl()
                name, kind = alias[key]
                if kind == "bool":
                    self.vals[name] = True if val is None else val not in ("false", "0")
                else:
                    if val is None:
                        i += 1
                        if i >= len(argv):
                            raise Fail(2, f"flag needs an argument: {key}")
                        val = argv[i]
                    if kind == "multi":
                        self.vals.setdefault(name, []).extend(
                            [v for v in val.split(",") if v] if name in ("--label", "--add-label", "--remove-label") else [val])
                    else:
                        self.vals[name] = val
            else:
                self.pos.append(a)
            i += 1

    def get(self, k, d=None):
        return self.vals.get(k, d)


COMMON = {"--repo": (("-R",), "val")}
JSONFLAGS = {"--json": ((), "val"), "--jq": (("-q",), "val"), "--template": (("-t",), "val")}


def spec(*parts, **extra):
    d = dict(COMMON)
    for p in parts:
        d.update(p)
    d.update({k: v for k, v in extra.items()})
    return d


def repo_of(a):
    r = a.get("--repo") or os.environ.get("GH_REPO") or DEFAULT_REPO
    r = re.sub(r"^(https?://)?(github\.com|127\.0\.0\.1:\d+|localhost:\d+)/", "", r).strip("/")
    r = re.sub(r"\.git$", "", r)
    if r.count("/") != 1:
        raise Fail(1, f"invalid repo '{r}': want OWNER/REPO")
    return r


def output(a, objs, op):
    """--json [--jq] output; without --json the caller prints text itself."""
    if a.get("--template"):
        raise NotImpl()
    text = json.dumps(objs, indent=2)
    if a.get("--jq"):
        emit(run_jq(a.get("--jq"), text, op))
    else:
        emit(text)


def fields_of(a, allowed, op):
    f = [x.strip() for x in (a.get("--json") or "").split(",") if x.strip()]
    bad = [x for x in f if x not in allowed]
    if bad:
        raise Fail(1, f"{op}: unknown JSON field(s): {', '.join(bad)} (shim knows: {', '.join(sorted(allowed))})")
    if a.get("--jq") and not f:
        raise Fail(1, f"{op}: cannot use --jq without --json")
    return f


# ---------------------------------------------------------------- labels

class Labels:
    def __init__(self, fg):
        self.fg = fg
        self._all = None

    def all(self):
        if self._all is None:
            self._all = {l["name"]: l for l in self.fg.all(self.fg.r("/labels"))}
        return self._all

    def ids(self, names, create=True):
        out = []
        for n in names:
            l = self.all().get(n)
            if l is None:
                if not create:
                    raise Fail(1, f"{self.fg.op}: label '{n}' does not exist in {self.fg.repo}")
                # GitHub creates an unknown label on first use; so does the shim, and logs it.
                l = self.fg.json("POST", self.fg.r("/labels"), body=dict(name=n, color="#ededed", description=""))
                self._all[n] = l
                log_note(f"created label '{n}' on first use")
            out.append(l["id"])
        return out


def gh_labels(ls):
    return [dict(id=str(l.get("id")), name=l.get("name"), description=l.get("description", ""),
                 color=(l.get("color") or "").lstrip("#")) for l in (ls or [])]


# ---------------------------------------------------------------- statuses / checks

STATE_UP = {"pending": "PENDING", "success": "SUCCESS", "error": "ERROR", "failure": "FAILURE",
            "warning": "NEUTRAL", "skipped": "SKIPPED", "cancelled": "CANCELLED"}


# Only the forge's own workflows (.forgejo/workflows/forge-*.yml, named "forge ...") count
# as CI. Forgejo falls back to .github/workflows on a branch without .forgejo/, and those
# runs ask for runners that do not exist here: they sit PENDING for ever, or FAILURE once
# cancelled, and deleting the run leaves the commit status behind (measured 2026-10-02).
CI_CONTEXT_RE = re.compile(os.environ.get("FORGE_CI_CONTEXT_RE", r"^forge[ -]"))
CI_WORKFLOW_RE = re.compile(os.environ.get("FORGE_CI_WORKFLOW_RE", r"^forge-.*\.ya?ml$"))


def statuses(fg, sha):
    """Latest status per context for a commit (Forgejo's combined status), forge CI only."""
    if not sha:
        return []
    j = fg.get(fg.r(f"/commits/{sha}/status"), ok404=True)
    if not j:
        return []
    return [s for s in j.get("statuses") or [] if CI_CONTEXT_RE.search(s.get("context") or "")]


def rollup(fg, sha):
    return [dict(__typename="StatusContext", context=s.get("context"),
                 state=STATE_UP.get((s.get("status") or s.get("state") or "").lower(), "PENDING"),
                 targetUrl=s.get("target_url"), description=s.get("description"),
                 createdAt=utc(s.get("created_at")), startedAt=utc(s.get("created_at")))
            for s in statuses(fg, sha)]


def check_runs(fg, sha):
    runs = []
    for s in statuses(fg, sha):
        st = (s.get("status") or s.get("state") or "").lower()
        runs.append(dict(id=s.get("id"), name=s.get("context"), head_sha=sha,
                         status="in_progress" if st == "pending" else "completed",
                         conclusion=None if st == "pending" else
                         {"warning": "neutral", "error": "failure"}.get(st, st),
                         started_at=utc(s.get("created_at")), completed_at=utc(s.get("updated_at")),
                         details_url=s.get("target_url"), html_url=s.get("target_url")))
    return dict(total_count=len(runs), check_runs=runs)


# ---------------------------------------------------------------- mergeability

def repo_git_dir(repo):
    if GIT_DIR:
        return GIT_DIR
    o, n = repo.lower().split("/")
    return os.path.join(REPOS_ROOT, o, n + ".git")


def mergeable(repo, base_sha, head_sha):
    """MERGEABLE / CONFLICTING / UNKNOWN by `git merge-tree`. Forgejo's own flag is
    false for every WIP (draft) PR, so it cannot tell a draft that conflicts."""
    if not base_sha or not head_sha:
        return "UNKNOWN"
    key = f"{base_sha}..{head_sha}"
    cfile = os.path.join(CACHE, "mergeable.json")
    try:
        with open(cfile) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    if key in cache:
        return cache[key]
    gd = repo_git_dir(repo)
    # --write-tree writes the merged trees; send them to a scratch object dir so the
    # forge's repo is only read. (git 2.43 has no merge-tree --quiet.)
    scratch = tempfile.mkdtemp(prefix="gh-shim-mt-")
    env = dict(os.environ, GIT_OBJECT_DIRECTORY=scratch,
               GIT_ALTERNATE_OBJECT_DIRECTORIES=os.path.join(gd, "objects"))
    try:
        p = subprocess.run(["git", "--git-dir", gd, "merge-tree", "--write-tree", "--no-messages",
                            base_sha, head_sha], capture_output=True, text=True, timeout=120, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return "UNKNOWN"
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    v = {0: "MERGEABLE", 1: "CONFLICTING"}.get(p.returncode, "UNKNOWN")
    if v != "UNKNOWN":
        cache[key] = v
        if len(cache) > 5000:
            cache = dict(list(cache.items())[-2500:])
        try:
            os.makedirs(CACHE, exist_ok=True)
            tmp = cfile + f".{os.getpid()}"
            with open(tmp, "w") as f:
                json.dump(cache, f)
            os.replace(tmp, cfile)
        except OSError:
            pass
    return v


# ---------------------------------------------------------------- object mapping

def user(u):
    return dict(login=(u or {}).get("login") or (u or {}).get("username") or "ghost",
                id=str((u or {}).get("id", "")), is_bot=False)


def is_draft(pr):
    return bool(pr.get("draft")) or bool(WIP_RE.match(pr.get("title") or ""))


def clean_title(t):
    return WIP_RE.sub("", t or "", count=1)


def pr_state(pr):
    if pr.get("merged") or pr.get("merged_at"):
        return "MERGED"
    return "OPEN" if pr.get("state") == "open" else "CLOSED"


PR_FIELDS = {"number", "title", "body", "state", "isDraft", "headRefName", "headRefOid", "baseRefName",
             "baseRefOid", "mergeable", "labels", "updatedAt", "createdAt", "closedAt", "mergedAt", "url",
             "id", "author", "statusCheckRollup", "comments", "files", "closingIssuesReferences",
             "additions", "deletions", "changedFiles", "closed", "isCrossRepository", "mergeCommit",
             "reviews", "latestReviews", "reviewDecision", "commits", "headRepositoryOwner"}


def comments_of(fg, n):
    return [dict(id=str(c.get("id")), author=user(c.get("user")), body=c.get("body") or "",
                 createdAt=c.get("created_at"), url=comment_html(c, n), authorAssociation="MEMBER")
            for c in fg.all(fg.r(f"/issues/{n}/comments"))]


def comment_html(c, n=None):
    u = c.get("html_url") or ""
    # Forgejo writes PR comment links under /pulls/; GitHub's consumers match /(issues|pull)/.
    return re.sub(r"/pulls/(\d+)#", r"/issues/\1#", u)


def pr_obj(fg, pr, fields):
    o = {}
    n = pr["number"]
    for f in fields:
        if f == "number":
            o[f] = n
        elif f == "title":
            o[f] = clean_title(pr.get("title"))
        elif f == "body":
            o[f] = pr.get("body") or ""
        elif f == "state":
            o[f] = pr_state(pr)
        elif f == "closed":
            o[f] = pr.get("state") != "open"
        elif f == "isDraft":
            o[f] = is_draft(pr)
        elif f == "headRefName":
            o[f] = (pr.get("head") or {}).get("ref")
        elif f == "headRefOid":
            o[f] = (pr.get("head") or {}).get("sha")
        elif f == "baseRefName":
            o[f] = (pr.get("base") or {}).get("ref")
        elif f == "baseRefOid":
            o[f] = (pr.get("base") or {}).get("sha")
        elif f == "isCrossRepository":
            o[f] = False
        elif f == "headRepositoryOwner":
            o[f] = dict(login=fg.repo.split("/")[0])
        elif f == "mergeable":
            if pr.get("state") != "open":
                o[f] = "UNKNOWN"
            else:
                o[f] = mergeable(fg.repo, (pr.get("base") or {}).get("sha"), (pr.get("head") or {}).get("sha"))
        elif f == "labels":
            o[f] = gh_labels(pr.get("labels"))
        elif f in ("updatedAt", "createdAt", "closedAt", "mergedAt"):
            o[f] = pr.get({"updatedAt": "updated_at", "createdAt": "created_at",
                           "closedAt": "closed_at", "mergedAt": "merged_at"}[f])
        elif f == "url":
            o[f] = pr.get("html_url")
        elif f == "id":
            o[f] = str(pr.get("id"))
        elif f == "author":
            o[f] = user(pr.get("user"))
        elif f == "statusCheckRollup":
            o[f] = rollup(fg, (pr.get("head") or {}).get("sha"))
        elif f == "comments":
            o[f] = comments_of(fg, n)
        elif f == "files":
            o[f] = [dict(path=x.get("filename"), additions=x.get("additions", 0), deletions=x.get("deletions", 0))
                    for x in fg.all(fg.r(f"/pulls/{n}/files"))]
        elif f == "closingIssuesReferences":
            o[f] = [dict(number=int(m)) for m in dict.fromkeys(CLOSE_RE.findall(pr.get("body") or ""))]
        elif f in ("additions", "deletions"):
            o[f] = pr.get(f, 0)
        elif f == "changedFiles":
            o[f] = pr.get("changed_files", 0)
        elif f == "mergeCommit":
            o[f] = dict(oid=pr.get("merge_commit_sha")) if pr.get("merge_commit_sha") else None
        elif f in ("reviews", "latestReviews"):
            o[f] = [dict(author=user(r.get("user")), state=(r.get("state") or "").upper(),
                         body=r.get("body") or "", submittedAt=r.get("submitted_at"))
                    for r in norm_ts(fg.all(fg.r(f"/pulls/{n}/reviews")))]
        elif f == "reviewDecision":
            o[f] = ""
        elif f == "commits":
            o[f] = [dict(oid=c.get("sha"), messageHeadline=((c.get("commit") or {}).get("message") or "").split("\n")[0])
                    for c in fg.all(fg.r(f"/pulls/{n}/commits"))]
    return o


ISSUE_FIELDS = {"number", "title", "body", "state", "labels", "updatedAt", "createdAt", "closedAt", "url",
                "id", "author", "comments", "closed", "isPinned", "assignees", "milestone", "stateReason"}


def issue_obj(fg, it, fields):
    o = {}
    for f in fields:
        if f == "number":
            o[f] = it["number"]
        elif f == "title":
            o[f] = it.get("title") or ""
        elif f == "body":
            o[f] = it.get("body") or ""
        elif f == "state":
            o[f] = "OPEN" if it.get("state") == "open" else "CLOSED"
        elif f == "closed":
            o[f] = it.get("state") != "open"
        elif f == "stateReason":
            o[f] = "" if it.get("state") == "open" else "COMPLETED"
        elif f == "labels":
            o[f] = gh_labels(it.get("labels"))
        elif f in ("updatedAt", "createdAt", "closedAt"):
            o[f] = it.get({"updatedAt": "updated_at", "createdAt": "created_at", "closedAt": "closed_at"}[f])
        elif f == "url":
            o[f] = it.get("html_url")
        elif f == "id":
            o[f] = str(it.get("id"))
        elif f == "author":
            o[f] = user(it.get("user"))
        elif f == "comments":
            o[f] = comments_of(fg, it["number"])
        elif f == "isPinned":
            o[f] = bool(it.get("pin_order"))
        elif f == "assignees":
            o[f] = [user(u) for u in (it.get("assignees") or [])]
        elif f == "milestone":
            o[f] = dict(title=it["milestone"]["title"]) if it.get("milestone") else None
    return o


# ---------------------------------------------------------------- pr

def find_pr(fg, ref, op):
    """A PR by number, URL, or head branch name (open first, then any)."""
    if ref is None:
        try:
            ref = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True,
                                 text=True, check=True).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            raise Fail(1, f"{op}: no PR given and not on a git branch") from None
    m = re.search(r"(?:^#?|/(?:pull|pulls|issues)/)(\d+)$", str(ref))
    if m:
        pr = fg.get(fg.r(f"/pulls/{m.group(1)}"), ok404=True)
        if pr is None:
            raise Fail(1, f"{op}: no pull request #{m.group(1)} in {fg.repo}")
        return pr
    prs = [p for p in fg.all(fg.r("/pulls"), dict(state="all", sort="recentupdate"))
           if (p.get("head") or {}).get("ref") == ref]
    prs.sort(key=lambda p: (p.get("state") != "open", -p["number"]))
    if not prs:
        raise Fail(1, f"{op}: no pull requests found for branch \"{ref}\" in {fg.repo}")
    return prs[0]


def list_prs(fg, a, op):
    state = (a.get("--state") or "open").lower()
    if state not in ("open", "closed", "merged", "all"):
        raise Fail(2, f"{op}: invalid --state {state}")
    rows = fg.all(fg.r("/pulls"), dict(state={"merged": "closed"}.get(state, state)))
    if state == "merged":
        rows = [p for p in rows if pr_state(p) == "MERGED"]
    elif state == "closed":
        rows = [p for p in rows if pr_state(p) == "CLOSED"]
    want = a.get("--label") or []
    if want:
        known = {l["name"] for l in fg.all(fg.r("/labels"))}
        for w in want:
            if w not in known:
                log_note(f"{op}: label '{w}' does not exist in {fg.repo}; result is empty for it")
        rows = [p for p in rows if set(want) <= {l["name"] for l in p.get("labels") or []}]
    if a.get("--head"):
        rows = [p for p in rows if (p.get("head") or {}).get("ref") == a.get("--head")]
    if a.get("--base"):
        rows = [p for p in rows if (p.get("base") or {}).get("ref") == a.get("--base")]
    if a.get("--author"):
        rows = [p for p in rows if (p.get("user") or {}).get("login") == a.get("--author")]
    if a.get("--draft"):
        rows = [p for p in rows if is_draft(p)]
    rows.sort(key=lambda p: -p["number"])
    return rows[: int(a.get("--limit") or 30)]


def cmd_pr(argv):
    if not argv:
        raise NotImpl()
    sub, rest = argv[0], argv[1:]
    op = "pr " + sub
    if sub == "list":
        a = Args(rest, spec(JSONFLAGS, **{"--state": (("-s",), "val"), "--limit": (("-L",), "val"),
                                          "--label": (("-l",), "multi"), "--head": (("-H",), "val"),
                                          "--base": (("-B",), "val"), "--author": (("-A",), "val"),
                                          "--draft": (("-d",), "bool")}))
        fg = Forge(repo_of(a), op)
        fields = fields_of(a, PR_FIELDS, op)
        rows = list_prs(fg, a, op)
        if fields:
            return output(a, [pr_obj(fg, p, fields) for p in rows], op)
        for p in rows:
            emit(f"{p['number']}\t{clean_title(p.get('title'))}\t{(p.get('head') or {}).get('ref')}\t"
                 f"{'DRAFT' if is_draft(p) else pr_state(p)}\t{p.get('created_at')}")
        return 0
    if sub == "view":
        a = Args(rest, spec(JSONFLAGS, **{"--comments": (("-c",), "bool"), "--web": (("-w",), "bool")}))
        if a.get("--web"):
            raise NotImpl()
        fg = Forge(repo_of(a), op)
        fields = fields_of(a, PR_FIELDS, op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        if fields:
            return output(a, pr_obj(fg, pr, fields), op)
        o = pr_obj(fg, pr, ["number", "title", "state", "isDraft", "author", "headRefName", "baseRefName",
                            "labels", "url", "body"])
        emit(f"title:\t{o['title']}\nstate:\t{'DRAFT' if o['isDraft'] else o['state']}\nauthor:\t{o['author']['login']}\n"
             f"labels:\t{', '.join(l['name'] for l in o['labels'])}\nnumber:\t{o['number']}\nurl:\t{o['url']}\n"
             f"head:\t{o['headRefName']}\nbase:\t{o['baseRefName']}\n--\n{o['body']}")
        if a.get("--comments"):
            for c in comments_of(fg, pr["number"]):
                emit(f"--\nauthor:\t{c['author']['login']}\ncreated:\t{c['createdAt']}\n--\n{c['body']}")
        return 0
    if sub == "comment":
        a = Args(rest, spec(**{"--body": (("-b",), "val"), "--body-file": (("-F",), "val"),
                               "--edit-last": ((), "bool")}))
        if a.get("--edit-last"):
            raise NotImpl()
        fg = Forge(repo_of(a), op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        return post_comment(fg, pr["number"], a, op)
    if sub == "create":
        a = Args(rest, spec(**{"--title": (("-t",), "val"), "--body": (("-b",), "val"),
                               "--body-file": (("-F",), "val"), "--base": (("-B",), "val"),
                               "--head": (("-H",), "val"), "--draft": (("-d",), "bool"),
                               "--label": (("-l",), "multi"), "--fill": (("-f",), "bool")}))
        fg = Forge(repo_of(a), op)
        head = a.get("--head") or subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                                                 capture_output=True, text=True).stdout.strip()
        if not head or head == "HEAD":
            raise Fail(1, f"{op}: no --head and not on a branch")
        base = a.get("--base") or "master"
        body = read_body_file(a.get("--body-file")) if a.get("--body-file") else (a.get("--body") or "")
        title = a.get("--title")
        if not title:
            if not a.get("--fill"):
                raise Fail(1, f"{op}: --title required (the shim does not prompt)")
            title = subprocess.run(["git", "log", "-1", "--format=%s", head], capture_output=True,
                                   text=True).stdout.strip() or head
        for p in fg.all(fg.r("/pulls"), dict(state="open")):
            if (p.get("head") or {}).get("ref") == head and (p.get("base") or {}).get("ref") == base:
                raise Fail(1, f"{op}: a pull request for branch \"{head}\" into branch \"{base}\" already exists:\n"
                              f"{p.get('html_url')}")
        ensure_branch(fg, head, op)
        if a.get("--draft"):
            title = "WIP: " + clean_title(title)
        lab = Labels(fg).ids(a.get("--label") or []) if a.get("--label") else []
        pr = fg.json("POST", fg.r("/pulls"), body=dict(head=head, base=base, title=title, body=body, labels=lab))
        emit(pr.get("html_url"))
        return 0
    if sub == "ready":
        a = Args(rest, spec(**{"--undo": ((), "bool")}))
        fg = Forge(repo_of(a), op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        t = clean_title(pr.get("title"))
        new = ("WIP: " + t) if a.get("--undo") else t
        if new != pr.get("title"):
            fg.json("PATCH", fg.r(f"/pulls/{pr['number']}"), body=dict(title=new))
        print(f"✓ Pull request #{pr['number']} is {'converted to draft' if a.get('--undo') else 'marked as ready for review'}",
              file=sys.stderr)
        return 0
    if sub == "checks":
        a = Args(rest, spec(**{"--required": ((), "bool"), "--watch": ((), "bool")}))
        if a.get("--watch"):
            raise NotImpl()
        fg = Forge(repo_of(a), op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        rows = rollup(fg, (pr.get("head") or {}).get("sha"))
        if not rows:
            print(f"no checks reported on the '{(pr.get('head') or {}).get('ref')}' branch", file=sys.stderr)
            return 1
        bad = pend = 0
        for s in rows:
            st = s["state"]
            word = {"SUCCESS": "pass", "NEUTRAL": "pass", "SKIPPED": "skipping", "PENDING": "pending"}.get(st, "fail")
            bad += word == "fail"
            pend += word == "pending"
            emit(f"{s['context']}\t{word}\t0\t{s.get('targetUrl') or ''}\t{s.get('description') or ''}")
        return 1 if bad else (8 if pend else 0)
    if sub == "diff":
        a = Args(rest, spec(**{"--name-only": ((), "bool"), "--patch": ((), "bool"), "--color": ((), "val")}))
        fg = Forge(repo_of(a), op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        if a.get("--name-only"):
            for x in fg.all(fg.r(f"/pulls/{pr['number']}/files")):
                emit(x.get("filename"))
            return 0
        _s, _h, b = fg.request("GET", fg.r(f"/pulls/{pr['number']}.{'patch' if a.get('--patch') else 'diff'}"),
                               accept="text/plain")
        sys.stdout.write(b.decode(errors="replace"))
        return 0
    if sub == "review":
        a = Args(rest, spec(**{"--comment": (("-c",), "bool"), "--approve": (("-a",), "bool"),
                               "--request-changes": (("-r",), "bool"), "--body": (("-b",), "val"),
                               "--body-file": (("-F",), "val")}))
        fg = Forge(repo_of(a), op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        ev = "APPROVED" if a.get("--approve") else "REQUEST_CHANGES" if a.get("--request-changes") else "COMMENT"
        if not (a.get("--approve") or a.get("--request-changes") or a.get("--comment")):
            raise Fail(2, f"{op}: one of --approve, --request-changes or --comment is required")
        body = read_body_file(a.get("--body-file")) if a.get("--body-file") else (a.get("--body") or "")
        if ev != "APPROVED" and not body:
            raise Fail(2, f"{op}: --body is required for {ev.lower()}")
        fg.json("POST", fg.r(f"/pulls/{pr['number']}/reviews"), body=dict(event=ev, body=body))
        print(f"- Reviewed pull request #{pr['number']}", file=sys.stderr)
        return 0
    if sub == "edit":
        a = Args(rest, spec(**{"--title": (("-t",), "val"), "--body": (("-b",), "val"),
                               "--body-file": (("-F",), "val"), "--add-label": ((), "multi"),
                               "--remove-label": ((), "multi"), "--base": (("-B",), "val")}))
        fg = Forge(repo_of(a), op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        return edit_issue(fg, pr["number"], a, op, pr=pr)
    if sub in ("close", "reopen"):
        a = Args(rest, spec(**{"--comment": (("-c",), "val"), "--delete-branch": (("-d",), "bool")}))
        if a.get("--delete-branch"):
            raise NotImpl()
        fg = Forge(repo_of(a), op)
        pr = find_pr(fg, a.pos[0] if a.pos else None, op)
        if a.get("--comment"):
            fg.json("POST", fg.r(f"/issues/{pr['number']}/comments"), body=dict(body=a.get("--comment")))
        fg.json("PATCH", fg.r(f"/pulls/{pr['number']}"), body=dict(state="closed" if sub == "close" else "open"))
        return 0
    if sub == "merge":
        raise Fail(2, "pr merge: refused by the forge shim: merges go through offline-git/foldqueue.sh "
                      "(a forge-side merge would be overwritten by the next hakux-forge-sync)")
    raise NotImpl()


def ensure_branch(fg, head, op):
    """The forge copies the bare repo once a minute; a just-pushed branch may not be there yet."""
    path = fg.r("/branches/" + urllib.parse.quote(head, safe=""))
    if fg.get(path, ok404=True) is not None:
        return
    if os.path.exists(SYNC):
        subprocess.run([SYNC], capture_output=True, timeout=600)
        if fg.get(path, ok404=True) is not None:
            return
    raise Fail(1, f"{op}: branch '{head}' is not in the forge (push it to origin first; "
                  f"hakux-forge-sync copies origin into the forge)")


def post_comment(fg, n, a, op):
    if a.get("--body-file"):
        body = read_body_file(a.get("--body-file"))
    elif a.get("--body") is not None:
        body = a.get("--body")
    else:
        raise Fail(2, f"{op}: --body or --body-file required (the shim does not prompt)")
    if not body.strip():
        raise Fail(1, f"{op}: refusing an empty comment body")
    c = fg.json("POST", fg.r(f"/issues/{n}/comments"), body=dict(body=body))
    emit(comment_html(c))
    return 0


def edit_issue(fg, n, a, op, pr=None):
    patch = {}
    if a.get("--title") is not None:
        t = a.get("--title")
        patch["title"] = ("WIP: " + t) if pr is not None and is_draft(pr) else t
    if a.get("--body-file"):
        patch["body"] = read_body_file(a.get("--body-file"))
    elif a.get("--body") is not None:
        patch["body"] = a.get("--body")
    if a.get("--base"):
        patch["base"] = a.get("--base")
    if patch:
        fg.json("PATCH", fg.r(f"/{'pulls' if pr is not None else 'issues'}/{n}"), body=patch)
    L = Labels(fg)
    if a.get("--add-label"):
        fg.json("POST", fg.r(f"/issues/{n}/labels"), body=dict(labels=L.ids(a.get("--add-label"))))
    for name in a.get("--remove-label") or []:
        l = L.all().get(name)
        if l is None:
            raise Fail(1, f"{op}: label '{name}' does not exist in {fg.repo}")
        fg.request("DELETE", fg.r(f"/issues/{n}/labels/{l['id']}"), ok404=True)
    if not (patch or a.get("--add-label") or a.get("--remove-label")):
        raise Fail(2, f"{op}: nothing to edit")
    emit(f"{FORGE_URL}/{fg.repo}/{'pulls' if pr is not None else 'issues'}/{n}")
    return 0


