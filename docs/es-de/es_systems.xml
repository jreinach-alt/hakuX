<?xml version="1.0"?>
<!--
  ES-DE custom system definition adding the hakuX fork build as a launch
  option for Microsoft Xbox.

  Copy to:  <ES-DE data folder>/custom_systems/es_systems.xml

  A custom system REPLACES the bundled one of the same name, so every launch
  option is repeated here: dropping this file in must not cost you the
  emulators you already had.

  CHECK <path> BEFORE USING THIS. It must match your ROM directory exactly,
  including capitalisation. Storage Access Framework document ids are
  case-sensitive strings even on a case-insensitive card, so a folder named
  XBox reached through a path written xbox produces URIs the emulator holds no
  permission for, and games fail to load with no useful error.
-->
<systemList>
    <system>
        <name>xbox</name>
        <fullname>Microsoft Xbox</fullname>
        <path>%ROMPATH%/xbox</path>
        <extension>.iso .ISO .xiso .XISO</extension>
        <command label="hakuX fork (Standalone)">%EMULATOR_HAKUX-FORK% %ACTION%=android.intent.action.VIEW %DATA%=%ROMSAF%</command>
        <command label="hakuX (Standalone)">%EMULATOR_HAKUX% %ACTION%=android.intent.action.VIEW %DATA%=%ROMSAF%</command>
        <command label="X1 BOX (Standalone)">%EMULATOR_X1-BOX% %ACTION%=android.intent.action.VIEW %DATA%=%ROMSAF%</command>
        <command label="Xenra (Standalone)">%EMULATOR_XENRA% %DATA%=%ROMSAF%</command>
        <platform>xbox</platform>
        <theme>xbox</theme>
    </system>
</systemList>
